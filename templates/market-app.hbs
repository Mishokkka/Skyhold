{{#if hasHolding}}
  <div class="fbls-market-shell">
    <header class="fbls-market-header">
      <div class="fbls-market-identity">
        <div class="fbls-market-title-row">
          <span class="fbls-market-title-icon"><i class="fa-solid fa-store"></i></span>
          <div>
            <span class="fbls-market-eyebrow">{{holding.name}}</span>
            <h2>{{marketLabel}}</h2>
            {{#if marketDescription}}<small class="fbls-market-description" title="{{marketDescription}}">{{marketDescription}}</small>{{/if}}
          </div>
        </div>
        <div class="fbls-market-facts">
          <span title="Страна: {{marketCountryLabel}}"><i class="fa-solid fa-flag"></i>{{marketCountryLabel}}</span>
          <span title="Размер рынка: {{marketSizeLabel}}"><i class="fa-solid fa-chart-simple"></i>{{marketSizeLabel}}</span>
          <span title="Состояние рынка: {{marketConditionLabel}}"><i class="fa-solid fa-gauge-high"></i>{{marketConditionLabel}}</span>
        </div>
      </div>
      <div class="fbls-market-treasury">
        <button type="button" class="fbls-button" data-action="market-transport-orders"><i class="fa-solid fa-route" aria-hidden="true"></i> Перевозки</button>
        <span><i class="fa-solid fa-coins"></i> Казна</span>
        <span class="fbls-market-money prominent" aria-label="{{treasuryText}}">{{#each treasuryParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
      </div>
    </header>

    {{#unless canPurchase}}
      <div class="fbls-callout fbls-market-notice"><i class="fa-solid fa-eye"></i> {{readOnlyReason}}</div>
    {{/unless}}
    {{#unless logisticsOk}}<div class="fbls-market-notice is-warning"><i class="fa-solid fa-route"></i> {{logisticsReason}}</div>{{/unless}}
    {{#unless hasMarket}}<div class="fbls-market-notice"><i class="fa-solid fa-store-slash"></i> Нет рынков в пределах текущего УРС или на связанных маршрутах.</div>{{/unless}}
    {{#if hiddenOfferCount}}<div class="fbls-market-notice"><i class="fa-solid fa-lock"></i> За текущим пределом УРС скрыто товаров: {{hiddenOfferCount}}.</div>{{/if}}

    <div class="fbls-market-toolbar fbls-toolbar">
      <label>Рынок-локация
        <select data-market-provider>
          {{#each marketOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="fbls-search fbls-market-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" aria-label="Найти товар" data-market-search value="{{search}}" placeholder="Найти товар" autocomplete="off" /></label>
      <label>Раздел
        <select data-market-kind>
          <option value="all" {{#if kindAll}}selected{{/if}}>Все</option>
          <option value="material" {{#if kindMaterial}}selected{{/if}}>Материалы</option>
          <option value="resource" {{#if kindResource}}selected{{/if}}>Ресурсы</option>
          <option value="consumable" {{#if kindConsumable}}selected{{/if}}>Расходники</option>
        </select>
      </label>
      <span>Показано: <strong data-market-visible-count>{{offers.length}}</strong></span>
    </div>

    <div class="fbls-market-layout">
      <div role="table" aria-label="Товары рынка" class="fbls-market-offers" data-render-scroll-key="market-offers">
        <div class="fbls-market-offer-columns" role="row">
          <span role="columnheader" aria-label="Изображение"></span>
          <span role="columnheader">Товар</span>
          <span role="columnheader">Продавцы</span>
          <span role="columnheader">Наличие</span>
          <span role="columnheader">Цена</span>
          <span role="columnheader">Кол-во</span>
          <span role="columnheader">Сумма</span>
        </div>
        {{#each offers}}
          <div role="row" class="fbls-market-offer {{#if selected}}is-selected{{/if}}" data-market-offer data-market-kind="{{kind}}" data-market-search-text="{{searchText}}">
            <div role="cell" class="fbls-market-offer-image">
              {{#if img}}<img src="{{img}}" alt="" data-market-offer-image="{{sourceOfferId}}" data-fbls-persistent-image="market-offer:{{sourceOfferId}}" data-fbls-image-fallback /><i class="{{icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{icon}}"></i>{{/if}}
            </div>
            <div role="cell" class="fbls-market-offer-main">
              <strong>{{name}}</strong>
              <small><span class="fbls-market-kind">{{kindLabel}}</span> · УРС {{requiredUrs}}</small>
            </div>
            <div role="cell" class="fbls-market-provider-cell">
              {{#each providerChips}}
                <button type="button" class="fbls-market-merchant-chip tone-{{tone}} {{#if active}}is-active{{/if}} {{#if hasQuantity}}has-quantity{{/if}}" data-action="market-select-merchant" data-source-offer-id="{{../sourceOfferId}}" data-provider-id="{{providerId}}" title="{{tooltip}}" aria-label="Выбрать продавца {{providerLabel}} для товара {{../name}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#unless ../../canOrder}}disabled{{/unless}}><span>{{abbreviation}}</span>{{#if hasQuantity}}<b>×{{quantity}}</b>{{/if}}</button>
              {{/each}}
            </div>
            <span role="cell" class="fbls-market-stock">{{stock}} {{unit}}</span>
            <div role="cell" class="fbls-market-price">
              <span class="fbls-market-money" aria-label="{{priceText}}">{{#each priceParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
              <span class="fbls-market-movement {{movementClass}}" data-fbls-tooltip="{{movementTooltip}}" aria-label="{{movementTooltip}}">{{movementText}}</span>
            </div>
            <div role="cell" class="fbls-market-quantity">
              <button type="button" data-action="market-quantity-step" data-offer-id="{{id}}" data-step="-1" data-stock="{{stock}}" title="ЛКМ: −1 · ПКМ: убрать всё" aria-label="Уменьшить количество {{name}}" {{#unless ../canOrder}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
              <input type="number" min="0" max="{{stock}}" step="1" value="{{qty}}" data-market-quantity data-offer-id="{{id}}" aria-label="Количество {{name}}" {{#unless ../canOrder}}disabled{{/unless}} />
              <button type="button" data-action="market-quantity-step" data-offer-id="{{id}}" data-step="1" data-stock="{{stock}}" title="ЛКМ: +1 · ПКМ: добавить максимум" aria-label="Увеличить количество {{name}}" {{#unless ../canOrder}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
            </div>
            <span role="cell" class="fbls-market-line-total fbls-market-money" aria-label="{{lineText}}">{{#each lineParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
          </div>
        {{else}}
          <div role="row" class="fbls-empty"><span role="cell" aria-colspan="7">Рынок пока не предлагает товаров.</span></div>
        {{/each}}
      </div>

      <aside class="fbls-market-cart" data-render-scroll-key="market-cart">
        <header class="fbls-market-cart-head"><div><i class="fa-solid fa-cart-shopping"></i><span><small>Оформление</small><h3>Заказ</h3></span></div><strong>{{selectedCount}} ед.</strong></header>

        <section class="fbls-market-cart-section"><p>Выберите товары. В следующем окне можно сравнить срок и цену доставки и добавить собственный корабль.</p>
          <label class="fbls-field"><span>Помещение для прибытия</span><select data-market-room {{#unless canOrder}}disabled{{/unless}}>{{#each rooms}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <button type="button" class="fbls-button primary" data-action="market-buy" {{#unless canConfirm}}disabled{{/unless}}>Рассчитать перевозку</button>
        </section>

      </aside>
    </div>

    {{#if outboundShowSection}}
    <section class="fbls-market-outbound" aria-label="Продажи поселения" data-market-outbound-section data-render-scroll-key="market-outbound" tabindex="-1">
      {{#if outboundHasForSaleStock}}
      <details class="fbls-market-outbound-compose" data-market-outbound-compose data-fbls-disclosure="market-outbound-compose" tabindex="-1">
        <summary>
          <span><i class="fa-solid fa-chevron-right fbls-market-disclosure-icon" aria-hidden="true"></i> <strong>Продажа со склада</strong> <small>Товаров: {{outboundStockCount}}</small></span>
          {{#if outboundHasSelection}}<span class="fbls-chip is-compact">Выбрано {{outboundSelectedUnits}} ед. · {{outboundRevenueText}}</span>{{else}}<small>Выбрать товары</small>{{/if}}
        </summary>
        <div class="fbls-market-outbound-body">
          <div class="fbls-market-outbound-stock">
            <div class="fbls-card-header"><strong>1. Товары к продаже</strong><small>Рынок: {{marketLabel}}</small></div>
            {{#if outboundHasOffers}}
            <div class="fbls-market-outbound-grid" role="group" aria-label="Количество товаров к продаже" data-render-scroll-key="market-outbound-stock">
          {{#each outboundOffers}}
            <article class="fbls-market-outbound-offer {{#if selected}}is-selected{{/if}}">
              <div class="fbls-market-outbound-product">
                <div class="fbls-market-outbound-image">{{#if img}}<img src="{{img}}" alt="" data-fbls-image-fallback /><i class="{{icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}</div>
                <div><strong>{{name}}</strong><small>{{availabilityText}}</small>{{#unless available}}<small>Нет свободного товара или спроса</small>{{/unless}}</div>
              </div>
              <span class="fbls-market-outbound-price" title="Цена покупателя за единицу">{{priceText}} / ед.</span>
              <div class="fbls-market-quantity">
                <button type="button" data-action="market-outbound-quantity-step" data-resource-id="{{resourceId}}" data-step="-1" data-available="{{available}}" title="ЛКМ: −1 · ПКМ: убрать всё" aria-label="Уменьшить продажу {{name}}" {{#unless canSelect}}disabled{{/unless}}><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                <input type="number" min="0" max="{{available}}" step="1" value="{{qty}}" data-market-outbound-quantity data-resource-id="{{resourceId}}" aria-label="Количество для продажи {{name}}" {{#unless canSelect}}disabled{{/unless}} />
                <button type="button" data-action="market-outbound-quantity-step" data-resource-id="{{resourceId}}" data-step="1" data-available="{{available}}" title="Добавить одну единицу" aria-label="Увеличить продажу {{name}}" {{#unless canSelect}}disabled{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                <button type="button" class="fbls-market-outbound-max" data-action="market-outbound-quantity-step" data-resource-id="{{resourceId}}" data-step="{{available}}" data-available="{{available}}" title="Выбрать максимум с учётом свободного запаса и спроса" aria-label="Продать максимум {{name}}" {{#unless canSelect}}disabled{{/unless}}>Макс.</button>
              </div>
              <span class="fbls-market-line-total" title="Выручка за выбранное количество">{{lineText}}</span>
            </article>
          {{/each}}
            </div>
            {{else}}
            <p class="fbls-market-outbound-note">Этот рынок не покупает отмеченные товары. Выберите другой рынок.</p>
            {{/if}}
            {{#if outboundUnavailableForSaleCount}}<p class="fbls-market-outbound-note">Без спроса на этом рынке: {{outboundUnavailableForSaleCount}}.</p>{{/if}}
          </div>
          <div class="fbls-market-outbound-checkout">
            <strong>2. Доставка и итог</strong>

            <p>Цена, сроки и выбор своего корабля рассчитываются для всего выбранного груза.</p>
            <button type="button" class="fbls-button primary" data-action="market-outbound-book" {{#unless outboundCanBook}}disabled{{/unless}}>Рассчитать перевозку</button>

          </div>
        </div>
      </details>
      {{/if}}

    </section>
    {{/if}}
  </div>
{{else}}
  <div class="fbls-empty">Поселение недоступно.</div>
{{/if}}
