{{#*inline "marketTransportPicker"}}
  <summary aria-label="{{heading}}" title="{{selectedText}}"><span>{{selectedText}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
  <div class="fbls-market-transport-panel" data-render-scroll-key="market-transport-picker-{{direction}}">
    <p class="fbls-market-transport-help">Выбирается вся цепочка перевозки. Компании указаны в участках; итоговые цена и срок — в расчёте заказа после выбора.</p>
    {{#if automatic}}<button type="button" class="fbls-button ghost fbls-market-transport-auto" data-action="market-select-transport" data-direction="{{direction}}" data-carrier-id="{{automatic.value}}" aria-pressed="{{automatic.selected}}" {{#if automatic.disabled}}disabled{{/if}}><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i><span>{{automatic.label}}</span></button>{{/if}}
    <label class="fbls-field"><span>Компания или локация</span><input type="search" value="{{query}}" data-market-transport-search="{{direction}}" placeholder="Найти среди вариантов" aria-label="Поиск: {{heading}}" autocomplete="off" /></label>
    <p class="fbls-market-transport-status" role="status" aria-live="polite">{{totalText}}</p>
    <div class="fbls-market-transport-choices">
      {{#each rows}}
        <article class="fbls-market-transport-choice {{#if selected}}is-selected{{/if}}">
          <header class="fbls-card-header"><strong>{{#if shortLabel}}{{shortLabel}}{{else}}{{label}}{{/if}}</strong><button type="button" class="fbls-button ghost" data-action="market-select-transport" data-direction="{{../direction}}" data-carrier-id="{{value}}" aria-label="Выбрать {{label}}" aria-pressed="{{selected}}" {{#if disabled}}disabled{{/if}}>{{#if selected}}Выбрано{{else}}Выбрать{{/if}}</button></header>
          <div class="fbls-cluster fbls-market-transport-meta"><span class="fbls-chip is-compact">{{distanceText}}</span><span class="fbls-chip is-compact">База {{timeText}}</span><span class="fbls-chip is-compact">До {{capacityText}}</span></div>
          <p>{{summaryText}}</p>
          {{#if legs}}<details class="fbls-market-transport-details" data-fbls-disclosure="market-transport-option-{{../direction}}:{{value}}"><summary>Участки и перевозчики</summary>
            <ol class="fbls-market-legs" tabindex="0" aria-label="Участки {{label}}">{{#each legs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
              <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
              <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}</small>{{/if}}</li>{{/each}}</ol>
          </details>{{/if}}
        </article>
      {{else}}<p class="fbls-market-transport-help">{{emptyText}}</p>{{/each}}
    </div>
    <nav class="fbls-action-group fbls-market-transport-pages" aria-label="Страницы вариантов перевозки"><button type="button" class="fbls-button ghost" data-action="market-transport-page" data-direction="{{direction}}" data-step="-1" aria-label="Предыдущая страница вариантов" {{#unless hasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button><span>{{pageText}}</span><button type="button" class="fbls-button ghost" data-action="market-transport-page" data-direction="{{direction}}" data-step="1" aria-label="Следующая страница вариантов" {{#unless hasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button></nav>
  </div>
{{/inline}}
{{#if hasHolding}}
  <div class="fbls-market-shell">
    <header class="fbls-market-header">
      <div class="fbls-market-identity">
        <div class="fbls-market-title-row">
          <span class="fbls-market-title-icon"><i class="fa-solid fa-store"></i></span>
          <div>
            <span class="fbls-market-eyebrow">{{holding.name}}</span>
            <h2>{{marketLabel}}</h2>
            {{#if marketDescription}}<small class="fbls-market-description" title="{{marketDescription}}">{{marketDescription}}</small>{{/if}}
          </div>
        </div>
        <div class="fbls-market-facts">
          <span title="Страна: {{marketCountryLabel}}"><i class="fa-solid fa-flag"></i>{{marketCountryLabel}}</span>
          <span title="Размер рынка: {{marketSizeLabel}}"><i class="fa-solid fa-chart-simple"></i>{{marketSizeLabel}}</span>
          <span title="Состояние рынка: {{marketConditionLabel}}"><i class="fa-solid fa-gauge-high"></i>{{marketConditionLabel}}</span>
        </div>
      </div>
      <div class="fbls-market-treasury">
        <span><i class="fa-solid fa-coins"></i> Казна</span>
        <span class="fbls-market-money prominent" aria-label="{{treasuryText}}">{{#each treasuryParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
      </div>
    </header>

    {{#unless canPurchase}}
      <div class="fbls-callout fbls-market-notice"><i class="fa-solid fa-eye"></i> {{readOnlyReason}}</div>
    {{/unless}}
    {{#unless logisticsOk}}<div class="fbls-market-notice is-warning"><i class="fa-solid fa-route"></i> {{logisticsReason}}</div>{{/unless}}
    {{#each cargoWarnings}}<div class="fbls-callout"><i class="fa-solid fa-hourglass-end"></i> {{this}}</div>{{/each}}
    {{#unless hasMarket}}<div class="fbls-market-notice"><i class="fa-solid fa-store-slash"></i> Нет рынков в пределах текущего УРС или на связанных маршрутах.</div>{{/unless}}
    {{#if hiddenOfferCount}}<div class="fbls-market-notice"><i class="fa-solid fa-lock"></i> За текущим пределом УРС скрыто товаров: {{hiddenOfferCount}}.</div>{{/if}}

    <div class="fbls-market-toolbar fbls-toolbar">
      <label>Рынок-локация
        <select data-market-provider>
          {{#each marketOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="fbls-search fbls-market-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" aria-label="Найти товар" data-market-search value="{{search}}" placeholder="Найти товар" autocomplete="off" /></label>
      <label>Раздел
        <select data-market-kind>
          <option value="all" {{#if kindAll}}selected{{/if}}>Все</option>
          <option value="material" {{#if kindMaterial}}selected{{/if}}>Материалы</option>
          <option value="resource" {{#if kindResource}}selected{{/if}}>Ресурсы</option>
          <option value="consumable" {{#if kindConsumable}}selected{{/if}}>Расходники</option>
        </select>
      </label>
      <span>Показано: <strong data-market-visible-count>{{offers.length}}</strong></span>
    </div>

    <div class="fbls-market-layout">
      <div role="table" aria-label="Товары рынка" class="fbls-market-offers" data-render-scroll-key="market-offers">
        <div class="fbls-market-offer-columns" role="row">
          <span role="columnheader" aria-label="Изображение"></span>
          <span role="columnheader">Товар</span>
          <span role="columnheader">Продавцы</span>
          <span role="columnheader">Наличие</span>
          <span role="columnheader">Цена</span>
          <span role="columnheader">Кол-во</span>
          <span role="columnheader">Сумма</span>
        </div>
        {{#each offers}}
          <div role="row" class="fbls-market-offer {{#if selected}}is-selected{{/if}}" data-market-offer data-market-kind="{{kind}}" data-market-search-text="{{searchText}}">
            <div role="cell" class="fbls-market-offer-image">
              {{#if img}}<img src="{{img}}" alt="" data-market-offer-image="{{sourceOfferId}}" data-fbls-persistent-image="market-offer:{{sourceOfferId}}" data-fbls-image-fallback /><i class="{{icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{icon}}"></i>{{/if}}
            </div>
            <div role="cell" class="fbls-market-offer-main">
              <strong>{{name}}</strong>
              <small><span class="fbls-market-kind">{{kindLabel}}</span> · УРС {{requiredUrs}}</small>
            </div>
            <div role="cell" class="fbls-market-provider-cell">
              {{#each providerChips}}
                <button type="button" class="fbls-market-merchant-chip tone-{{tone}} {{#if active}}is-active{{/if}} {{#if hasQuantity}}has-quantity{{/if}}" data-action="market-select-merchant" data-source-offer-id="{{../sourceOfferId}}" data-provider-id="{{providerId}}" title="{{tooltip}}" aria-label="Выбрать продавца {{providerLabel}} для товара {{../name}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#unless ../../canOrder}}disabled{{/unless}}><span>{{abbreviation}}</span>{{#if hasQuantity}}<b>×{{quantity}}</b>{{/if}}</button>
              {{/each}}
            </div>
            <span role="cell" class="fbls-market-stock">{{stock}} {{unit}}</span>
            <div role="cell" class="fbls-market-price">
              <span class="fbls-market-money" aria-label="{{priceText}}">{{#each priceParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
              <span class="fbls-market-movement {{movementClass}}" data-fbls-tooltip="{{movementTooltip}}" aria-label="{{movementTooltip}}">{{movementText}}</span>
            </div>
            <div role="cell" class="fbls-market-quantity">
              <button type="button" data-action="market-quantity-step" data-offer-id="{{id}}" data-step="-1" data-stock="{{stock}}" title="ЛКМ: −1 · ПКМ: убрать всё" aria-label="Уменьшить количество {{name}}" {{#unless ../canOrder}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
              <input type="number" min="0" max="{{stock}}" step="1" value="{{qty}}" data-market-quantity data-offer-id="{{id}}" aria-label="Количество {{name}}" {{#unless ../canOrder}}disabled{{/unless}} />
              <button type="button" data-action="market-quantity-step" data-offer-id="{{id}}" data-step="1" data-stock="{{stock}}" title="ЛКМ: +1 · ПКМ: добавить максимум" aria-label="Увеличить количество {{name}}" {{#unless ../canOrder}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
            </div>
            <span role="cell" class="fbls-market-line-total fbls-market-money" aria-label="{{lineText}}">{{#each lineParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
          </div>
        {{else}}
          <div role="row" class="fbls-empty"><span role="cell" aria-colspan="7">Рынок пока не предлагает товаров.</span></div>
        {{/each}}
      </div>

      <aside class="fbls-market-cart" data-render-scroll-key="market-cart">
        <header class="fbls-market-cart-head"><div><i class="fa-solid fa-cart-shopping"></i><span><small>Оформление</small><h3>Заказ</h3></span></div><strong>{{selectedCount}} ед.</strong></header>

        <section class="fbls-market-cart-section delivery">
          <header><i class="fa-solid fa-truck-fast"></i><div><strong>Доставка</strong><small>{{carrierLabel}}</small></div></header>
          <div class="fbls-market-cart-controls">
            <label class="fbls-field"><span>Помещение</span>
              <select data-market-room {{#unless canOrder}}disabled{{/unless}}>
                {{#each rooms}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            <div class="fbls-field"><span>План перевозки</span>
              <details class="fbls-selection-field fbls-market-transport-picker" data-market-carrier-picker data-fbls-disclosure="market-transport-picker-inbound">{{> marketTransportPicker transportPicker heading="План входящей перевозки"}}</details>
            </div>
            {{#if scheduledDelivery}}
              <label class="fbls-field"><span>Режим</span>
                <select data-market-service-level {{#unless canOrder}}disabled{{/unless}}>
                  <option value="standard" {{#if serviceStandard}}selected{{/if}}>Попутный груз</option>
                  <option value="express" {{#if serviceExpress}}selected{{/if}}>Ускоренная</option>
                  <option value="charter" {{#if serviceCharter}}selected{{/if}}>Выделенный рейс</option>
                </select>
              </label>
            {{/if}}
          </div>
          {{#if scheduledDelivery}}<p class="fbls-market-delivery-note">{{serviceDescription}}</p>{{/if}}
          {{#if hasCapacityLimit}}
            <div class="fbls-market-capacity {{#if capacityExceeded}}is-over{{/if}}">
              <header><span><i class="fa-solid fa-boxes-stacked"></i> Партии</span><strong>{{batchCountText}}</strong></header>
              <small>Весь заказ: {{totalLoadText}} · лимит рейса: {{capacityLoadText}} · физическая вместимость: {{physicalCapacityText}}</small>
              <progress max="{{capacityLoadValue}}" value="{{totalLoadValue}}" aria-label="Загрузка последнего рейса"></progress>
              {{#if capacityExceeded}}
                <small>Одна единица товара не помещается в лимит выбранного режима — выберите выделенный рейс или другого перевозчика.</small>
              {{else}}
                <small>Последний рейс: {{finalBatchLoadText}} · свободно {{capacityRemainingText}}.</small>
              {{/if}}
            </div>
          {{/if}}
          {{#if hasMultipleShipmentBatches}}
            <details class="fbls-market-batch-preview" open>
              <summary><span><i class="fa-solid fa-layer-group"></i> Рейсы заказа</span><strong>{{batchCountText}}</strong></summary>
              <label><span>Показать</span>
                <select data-market-batch-preview>
                  {{#each shipmentBatchPreviews}}<option value="{{index}}" {{#if selected}}selected{{/if}}>{{optionLabel}}</option>{{/each}}
                </select>
              </label>
              {{#with selectedShipmentBatch}}
                <div class="fbls-market-batch-card">
                  <header><strong>Рейс {{number}}</strong><span>ETA {{etaText}}</span></header>
                  <p class="fbls-market-batch-note">Отправление: {{departureText}} · перевозка: {{transportText}}.</p>
                  <div class="fbls-market-metric-grid fbls-market-batch-metrics">
                    <span class="fbls-market-metric"><small>Фактический груз</small><b>{{loadText}}</b></span>
                    <span class="fbls-market-metric"><small>Доля сметы</small><b>{{capacityShareText}}</b></span>
                    <span class="fbls-market-metric"><small>Расчётная масса</small><b>{{billableLoadText}}</b></span>
                    <span class="fbls-market-metric"><small>Риск</small><b>{{lossText}} / {{delayText}}</b></span>
                  </div>
                  {{#if billsFullCapacity}}<p class="fbls-market-batch-note">Выделенный рейс оплачивает всю вместимость и полный оборот транспорта, включая возврат или перегон после доставки.</p>{{/if}}
                  <ul class="fbls-market-batch-cargo">
                    {{#each cargo}}<li><span><b>{{name}}</b>{{#if providerLabel}}<small>{{providerLabel}}</small>{{/if}}</span><span>×{{qty}} · {{lineText}}</span></li>{{/each}}
                  </ul>
                  <dl class="fbls-market-batch-costs">
                    <div><dt>Товары</dt><dd>{{subtotalText}}</dd></div>
                    <div><dt>Фрахт от цены</dt><dd>{{valueFreightText}}</dd></div>
                    <div><dt>Операционная смета</dt><dd>{{operationalFreightText}}</dd></div>
                    <div><dt>Маршрут</dt><dd>{{routeText}}</dd></div>
                    <div><dt>Погрузка</dt><dd>{{handlingText}}</dd></div>
                    <div><dt>Страхование</dt><dd>{{insuranceText}}</dd></div>
                    <div><dt>Пошлина</dt><dd>{{taxText}}</dd></div>
                    {{#if hasExpress}}<div><dt>Срочность</dt><dd>{{expressText}}</dd></div>{{/if}}
                    <div class="total"><dt>Доставка рейса</dt><dd>{{deliveryText}}</dd></div>
                    <div class="total"><dt>Рейс с товаром</dt><dd>{{totalText}}</dd></div>
                  </dl>
                </div>
              {{/with}}
            </details>
          {{/if}}
        </section>

        <section class="fbls-market-cart-section route">
          <header><i class="fa-solid fa-route"></i><div><strong>Маршрут</strong><small>{{transportLabel}}</small></div></header>
          <div class="fbls-market-metric-grid fbls-market-route-metrics">
            <span class="fbls-market-metric"><small>Срок</small><strong>{{deliveryTimingText}}</strong></span>
            <span class="fbls-market-metric"><small>Дальность</small><strong>{{routeDistanceText}}</strong></span>
            <span class="fbls-market-metric"><small>Риск</small><strong>{{routeRiskText}}</strong></span>
            <span class="fbls-market-metric"><small>Доступ</small><strong>{{marketAccessText}}</strong></span>
          </div>
          <details class="fbls-market-route-details" data-fbls-disclosure="market-route-details">
            <summary>Подробнее о маршруте</summary>
            <dl>
              <div><dt>Путь</dt><dd>{{routePathText}}</dd></div>
              <div><dt>Сезон</dt><dd>{{routeSeasonText}}</dd></div>
              {{#if scheduledDelivery}}<div><dt>Утрата / задержка</dt><dd>{{riskLossChanceText}} / {{riskDelayChanceText}}</dd></div>{{/if}}
              {{#if scheduledDelivery}}<div><dt>Макс. задержка</dt><dd>{{riskMaxDelayText}}</dd></div>{{/if}}
              {{#if hasInsurance}}<div><dt>Покрытие</dt><dd>{{insuranceCoverageText}} · до {{insuranceMaximumPayoutText}}</dd></div>{{/if}}
            </dl>
            {{#if routeLegs}}<ol class="fbls-market-legs" tabindex="0" aria-label="Участки перевозки">
              {{#each routeLegs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
                <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
                <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}{{#if chargedText}} · {{chargedText}}{{/if}}</small>
              {{/if}}</li>{{/each}}
            </ol>{{/if}}
          </details>
        </section>

        <section class="fbls-market-cart-section costs">
          <header><i class="fa-solid fa-receipt"></i><div><strong>Стоимость</strong><small>Товар и услуги</small></div></header>
          <dl class="fbls-market-cost-list">
            <div><dt>Товары</dt><dd><span class="fbls-market-money" aria-label="{{subtotalText}}">{{#each subtotalParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>
            <div><dt>Доставка</dt><dd><span class="fbls-market-money" aria-label="{{deliveryText}}">{{#each deliveryParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>
            <div><dt>Включая маршрут</dt><dd><span class="fbls-market-money" aria-label="{{routeCostText}}">{{#each routeCostParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>
            {{#if hasHandling}}<div><dt>Погрузка</dt><dd><span class="fbls-market-money" aria-label="{{handlingText}}">{{#each handlingParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>{{/if}}
            {{#if hasInsurance}}<div><dt>Страхование</dt><dd><span class="fbls-market-money" aria-label="{{insuranceText}}">{{#each insuranceParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>{{/if}}
            {{#if hasExpressSurcharge}}<div><dt>Срочность</dt><dd><span class="fbls-market-money" aria-label="{{expressSurchargeText}}">{{#each expressSurchargeParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>{{/if}}
            {{#if hasTax}}<div><dt>Пошлины</dt><dd><span class="fbls-market-money" aria-label="{{taxText}}">{{#each taxParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></dd></div>{{/if}}
          </dl>
          {{#if hasSelection}}
            <dl class="fbls-market-cost-list">
              <div><dt>Доля доставки в платеже</dt><dd>{{purchaseCosts.deliveryShareText}}</dd></div>
              {{#if purchaseCosts.hasInsuranceExposure}}
                <div><dt>Макс. выплата за весь груз</dt><dd>{{purchaseCosts.maximumPayoutText}}</dd></div>
                <div><dt>Не покрывается при полной утрате</dt><dd>{{purchaseCosts.unrecoveredText}}</dd></div>
              {{/if}}
            </dl>
            {{#if purchaseCosts.hasInsuranceExposure}}<p class="fbls-market-delivery-note">Страхуется {{insuranceCoverageText}} стоимости товаров. Расходы доставки не возмещаются; каждая партия имеет отдельный исход.</p>{{/if}}
            {{#if purchaseCosts.hasLandedLines}}
              <details class="fbls-market-delivery-help" data-market-landed-prices {{#if landedPricesOpen}}open{{/if}}>
                <summary>Цена товаров с доставкой</summary>
                <dl class="fbls-market-delivery-breakdown">
                  {{#each purchaseCosts.landedLines}}
                    <div><dt>{{name}}{{#if providerLabel}} · {{providerLabel}}{{/if}} ×{{qty}}</dt><dd>{{unitText}} · всего {{totalText}}</dd></div>
                  {{/each}}
                </dl>
                <p class="fbls-market-delivery-note">Общие расходы распределены внутри каждой партии: фрахт — по нагрузке или стоимости согласно выбранному тарифу, обработка — по нагрузке, страховка и пошлины — по стоимости. Цена единицы — средняя; итог заказа остаётся точным.</p>
              </details>
            {{/if}}
          {{/if}}
          <details class="fbls-market-delivery-help" data-market-delivery-breakdown {{#if deliveryBreakdownOpen}}open{{/if}}>
            <summary><span><i class="fa-solid fa-calculator"></i> Как рассчитана доставка</span><strong>{{deliveryText}}</strong></summary>
            <dl class="fbls-market-delivery-breakdown">
              <div><dt>Маршрут</dt><dd>{{deliveryBreakdown.distanceText}}</dd></div>
              <div><dt>Выезд транспорта</dt><dd>{{deliveryBreakdown.dispatchText}}</dd></div>
              <div><dt>Тариф дальности</dt><dd>{{deliveryBreakdown.distanceTariffText}}</dd></div>
              <div><dt>Множители</dt><dd>{{deliveryBreakdown.factorText}}</dd></div>
              <div><dt>Подготовка воздушного корабля</dt><dd>{{deliveryBreakdown.airshipHireText}}</dd></div>
              <div><dt>Экипаж и эксплуатация по времени</dt><dd>{{deliveryBreakdown.operatingTimeText}}</dd></div>
              <div><dt>Затраты при полной загрузке</dt><dd>{{deliveryBreakdown.fullVesselLoadText}}</dd></div>
              <div><dt>Полная смета пути в одну сторону</dt><dd>{{deliveryBreakdown.fullOneWayOperatingText}}</dd></div>
              <div><dt>Оплачиваемые плечи</dt><dd>{{deliveryBreakdown.operatingLegsText}}</dd></div>
              <div><dt>Доля грузоподъёмности</dt><dd>{{deliveryBreakdown.capacityShareText}}</dd></div>
              <div><dt>Фрахт от цены товаров</dt><dd>{{deliveryBreakdown.valueFreightFormulaText}}</dd></div>
              <div><dt>Операционная смета</dt><dd>{{deliveryBreakdown.operationalFormulaText}}</dd></div>
              <div><dt>Маршрут всего</dt><dd>{{deliveryBreakdown.routeTotalFormulaText}}</dd></div>
              <div><dt>Погрузка</dt><dd>{{deliveryBreakdown.handlingFormulaText}}</dd></div>
              <div><dt>Страхование</dt><dd>{{deliveryBreakdown.insuranceFormulaText}}</dd></div>
              <div><dt>Пошлина</dt><dd>{{deliveryBreakdown.taxFormulaText}}</dd></div>
              {{#if hasExpressSurcharge}}<div><dt>Срочность</dt><dd>{{deliveryBreakdown.expressText}}</dd></div>{{/if}}
              <div class="total"><dt>Итого доставка</dt><dd>{{deliveryBreakdown.totalFormulaText}}</dd></div>
            </dl>
            <p class="fbls-market-delivery-note">Слагаемые в последней строке: маршрут + погрузка + страхование + пошлина + срочность.</p>
          </details>
        </section>

        {{#if capacityExceeded}}<p class="fbls-market-error"><i class="fa-solid fa-weight-hanging"></i> Одна единица товара не помещается в лимит выбранного режима доставки.</p>{{/if}}
        {{#if insufficientFunds}}<p class="fbls-market-error"><i class="fa-solid fa-triangle-exclamation"></i> В казне недостаточно денег.</p>{{/if}}
        <section class="fbls-market-checkout">
          <div><span><small>Итого</small><span class="fbls-market-money prominent" aria-label="{{totalText}}">{{#each totalParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></span><span><small>Останется</small><span class="fbls-market-money" aria-label="{{balanceAfterText}}">{{#each balanceAfterParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span></span></div>
          <div class="fbls-action-group">
            <button type="button" class="fbls-button ghost" data-action="market-clear" {{#unless hasSelection}}disabled{{/unless}}>Очистить</button>
            <button type="button" class="fbls-button primary" data-action="market-buy" {{#unless canConfirm}}disabled{{/unless}}><i class="fa-solid fa-truck-fast"></i> {{#if scheduledDelivery}}Заказать{{else}}Купить{{/if}}</button>
          </div>
        </section>
        {{#if hasShipments}}
          <section class="fbls-market-shipments">
            <h4><i class="fa-solid fa-route"></i> Текущие поставки · {{activeShipmentCount}}</h4>
            {{#if hasHiddenShipments}}<small>Показаны ближайшие 12 партий; ещё {{hiddenShipmentCount}} появятся по мере их завершения или отмены.</small>{{/if}}
            {{#each shipments}}
              <article class="fbls-market-shipment {{status}}">
                <header><strong>{{marketLabel}}</strong><span>{{statusLabel}}</span></header>
                <p>{{cargoText}}</p>
                <p class="fbls-market-shipment-risk">{{riskText}}</p>
                {{#if timingText}}<p class="fbls-market-delivery-note">{{timingText}}</p>{{/if}}
                <p class="fbls-market-delivery-note">{{financialRiskText}}</p>
                {{#if routeLegs}}<details class="fbls-market-transport-details" data-fbls-disclosure="market-transport-in:{{id}}"><summary>Участки перевозки</summary>
                  <ol class="fbls-market-legs" tabindex="0" aria-label="Сохранённые участки поставки">{{#each routeLegs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
                    <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
                    <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}{{#if chargedText}} · {{chargedText}}{{/if}}</small>{{/if}}</li>{{/each}}</ol>
                </details>{{/if}}
                {{#if canResolveRisk}}
                  <details open>
                    <summary><i class="fa-solid fa-user-shield"></i> GM: предложение риска — {{gmResolution.proposalLabel}}</summary>
                    <dl>
                      <div><dt>ID события</dt><dd>{{gmResolution.eventId}}</dd></div>
                      <div><dt>Проверка утраты</dt><dd>{{gmResolution.lossCheckText}}</dd></div>
                      <div><dt>Проверка задержки</dt><dd>{{gmResolution.delayCheckText}}</dd></div>
                      <div><dt>Длительность</dt><dd>{{gmResolution.delayDurationText}}</dd></div>
                      <div><dt>Страхование</dt><dd>{{gmResolution.insuranceText}}</dd></div>
                    </dl>
                    <div class="fbls-action-group">
                      <button type="button" class="fbls-button compact primary" data-action="market-resolve-shipment-risk" data-order-id="{{id}}" data-risk-outcome="proposal" data-delay-qd="{{gmResolution.delayQd}}"><i class="fa-solid fa-check"></i> {{gmResolution.applyLabel}}</button>
                      <button type="button" class="fbls-button compact" data-action="market-resolve-shipment-risk" data-order-id="{{id}}" data-risk-outcome="clear"><i class="fa-solid fa-forward"></i> Без последствий</button>
                      <button type="button" class="fbls-button compact" data-action="market-resolve-shipment-risk" data-order-id="{{id}}" data-risk-outcome="delayed" data-delay-qd="{{gmResolution.delayQd}}"><i class="fa-solid fa-clock"></i> Изменить: задержка</button>
                      <button type="button" class="fbls-button compact danger" data-action="market-resolve-shipment-risk" data-order-id="{{id}}" data-risk-outcome="lost"><i class="fa-solid fa-skull-crossbones"></i> Изменить: утрата</button>
                    </div>
                  </details>
                {{/if}}
                <footer>
                  <small>{{batchText}} · {{carrierText}} · ETA: {{remainingText}} · {{serviceText}} · {{totalText}}</small>
                  <span class="fbls-market-shipment-actions">
                    {{#if canCancel}}<button type="button" class="fbls-button compact danger" data-action="market-cancel-shipment" data-order-id="{{id}}" title="Вернуть {{cancellationRefundText}}, удержать {{cancellationWithheldText}}"><i class="fa-solid fa-ban"></i> Отменить</button>{{/if}}
                    {{#if canDeliverNow}}{{#if ../canPurchase}}<button type="button" class="fbls-button compact" data-action="market-deliver-shipment" data-order-id="{{id}}"><i class="fa-solid fa-box-open"></i> Доставить сейчас</button>{{/if}}{{/if}}
                  </span>
                </footer>
              </article>
            {{/each}}
          </section>
        {{/if}}
        {{#if hasShipmentArchive}}
          <details class="fbls-market-archive">
            <summary><span><i class="fa-solid fa-box-archive"></i> Архив поставок</span><b>{{shipmentArchive.length}}</b></summary>
            <div class="fbls-market-archive-list">
              {{#each shipmentArchive}}
                <article class="fbls-market-archive-row {{status}}">
                  <header><div><strong>{{marketLabel}}</strong><small>{{orderedText}}</small></div><span>{{statusLabel}}</span></header>
                  <p>{{cargoText}}</p>
                  <small>{{batchText}} · {{routeText}} · {{carrierText}} · {{totalText}}</small>
                  {{#if routeLegs}}<details class="fbls-market-transport-details" data-fbls-disclosure="market-transport-in:{{id}}"><summary>Участки перевозки</summary>
                    <ol class="fbls-market-legs" tabindex="0" aria-label="Сохранённые участки поставки">{{#each routeLegs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
                      <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
                      <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}{{#if chargedText}} · {{chargedText}}{{/if}}</small>{{/if}}</li>{{/each}}</ol>
                  </details>{{/if}}
                  <p class="fbls-market-shipment-risk">{{statusText}}</p>
                  <ol>{{#each timeline}}<li><span>{{label}}</span><time>{{at}}</time></li>{{/each}}</ol>
                </article>
              {{/each}}
            </div>
          </details>
        {{/if}}
      </aside>
    </div>

    {{#if outboundShowSection}}
    <section class="fbls-market-outbound" aria-label="Продажи поселения" data-market-outbound-section data-render-scroll-key="market-outbound" tabindex="-1">
      {{#if outboundHasForSaleStock}}
      <details class="fbls-market-outbound-compose" data-market-outbound-compose data-fbls-disclosure="market-outbound-compose" tabindex="-1">
        <summary>
          <span><i class="fa-solid fa-chevron-right fbls-market-disclosure-icon" aria-hidden="true"></i> <strong>Продажа со склада</strong> <small>Товаров: {{outboundStockCount}}</small></span>
          {{#if outboundHasSelection}}<span class="fbls-chip is-compact">Выбрано {{outboundSelectedUnits}} ед. · {{outboundRevenueText}}</span>{{else}}<small>Выбрать товары</small>{{/if}}
        </summary>
        <div class="fbls-market-outbound-body">
          <div class="fbls-market-outbound-stock">
            <div class="fbls-card-header"><strong>1. Товары к продаже</strong><small>Рынок: {{marketLabel}}</small></div>
            {{#if outboundHasOffers}}
            <div class="fbls-market-outbound-grid" role="group" aria-label="Количество товаров к продаже" data-render-scroll-key="market-outbound-stock">
          {{#each outboundOffers}}
            <article class="fbls-market-outbound-offer {{#if selected}}is-selected{{/if}}">
              <div class="fbls-market-outbound-product">
                <div class="fbls-market-outbound-image">{{#if img}}<img src="{{img}}" alt="" data-fbls-image-fallback /><i class="{{icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}</div>
                <div><strong>{{name}}</strong><small>{{availabilityText}}</small>{{#unless available}}<small>Нет свободного товара или спроса</small>{{/unless}}</div>
              </div>
              <span class="fbls-market-outbound-price" title="Цена покупателя за единицу">{{priceText}} / ед.</span>
              <div class="fbls-market-quantity">
                <button type="button" data-action="market-outbound-quantity-step" data-resource-id="{{resourceId}}" data-step="-1" data-available="{{available}}" title="ЛКМ: −1 · ПКМ: убрать всё" aria-label="Уменьшить продажу {{name}}" {{#unless canSelect}}disabled{{/unless}}><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                <input type="number" min="0" max="{{available}}" step="1" value="{{qty}}" data-market-outbound-quantity data-resource-id="{{resourceId}}" aria-label="Количество для продажи {{name}}" {{#unless canSelect}}disabled{{/unless}} />
                <button type="button" data-action="market-outbound-quantity-step" data-resource-id="{{resourceId}}" data-step="1" data-available="{{available}}" title="Добавить одну единицу" aria-label="Увеличить продажу {{name}}" {{#unless canSelect}}disabled{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                <button type="button" class="fbls-market-outbound-max" data-action="market-outbound-quantity-step" data-resource-id="{{resourceId}}" data-step="{{available}}" data-available="{{available}}" title="Выбрать максимум с учётом свободного запаса и спроса" aria-label="Продать максимум {{name}}" {{#unless canSelect}}disabled{{/unless}}>Макс.</button>
              </div>
              <span class="fbls-market-line-total" title="Выручка за выбранное количество">{{lineText}}</span>
            </article>
          {{/each}}
            </div>
            {{else}}
            <p class="fbls-market-outbound-note">Этот рынок не покупает отмеченные товары. Выберите другой рынок.</p>
            {{/if}}
            {{#if outboundUnavailableForSaleCount}}<p class="fbls-market-outbound-note">Без спроса на этом рынке: {{outboundUnavailableForSaleCount}}.</p>{{/if}}
          </div>
          <div class="fbls-market-outbound-checkout">
            <strong>2. Доставка и итог</strong>
            {{#if outboundHasSelection}}
            <div class="fbls-toolbar">
              <label class="fbls-field"><span>Кто доставит</span><select data-market-outbound-ship aria-label="Корабль для исходящей продажи" {{#unless canPurchase}}disabled{{/unless}}>{{#each outboundShipOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label class="fbls-market-outbound-insurance fbls-checkbox-label fbls-choice-toggle"><input type="checkbox" data-market-outbound-insurance {{#if outboundInsuranceEnabled}}checked{{/if}} {{#unless canPurchase}}disabled{{/unless}} /> <span>Страховка</span></label>
              {{#unless outboundOwnShipSelected}}<div class="fbls-field fbls-market-transport-field"><span>План перевозки</span><details class="fbls-selection-field fbls-market-transport-picker" data-market-outbound-carrier-picker data-fbls-disclosure="market-transport-picker-outbound">{{> marketTransportPicker outboundTransportPicker heading="План исходящей перевозки"}}</details></div>{{/unless}}
            </div>
            <dl class="fbls-market-outbound-totals">
              <div><dt>Расходы рынка сейчас</dt><dd>{{outboundUpfrontText}}</dd></div>
              {{#if outboundOwnShipSelected}}<div tabindex="0" data-fbls-tooltip="Перевод из казны в бортовой кошелёк с учётом имеющихся денег. Включает обратный путь и запас на стоянку; неиспользованный остаток вернётся после рейса."><dt>На борт ⓘ</dt><dd>{{outboundShipTransferText}}</dd></div>{{/if}}
              <div><dt>Выручка при доставке</dt><dd>{{outboundRevenueText}}</dd></div>
              <div><dt>Казна после отправки</dt><dd>{{outboundBalanceText}}</dd></div>
              <div><dt>Срок доставки</dt><dd>{{outboundDeliveryText}}</dd></div>
            </dl>
            <details class="fbls-market-outbound-breakdown" data-fbls-disclosure="market-outbound-breakdown">
              <summary>Покупатели и расходы подробнее</summary>
              <dl>
                <div><dt>Перевозчик</dt><dd>{{outboundCarrierText}}</dd></div>
                <div><dt>Ввоз в рынок покупателя</dt><dd>{{outboundImportTaxText}}</dd></div>
                <div><dt>Вывоз из поселения</dt><dd>{{outboundExportTaxText}}</dd></div>
                {{#if outboundOwnShipSelected}}<div tabindex="0" data-fbls-tooltip="Провизия, жалованье, содержание и портовая обработка груза. Списываются из бортового бюджета; резерв на обратный путь в эту сумму не входит."><dt>Расходы рейса ⓘ</dt><dd>{{outboundShipOperatingText}}</dd></div>{{/if}}
              </dl>
              {{#if outboundRouteLegs}}<ol class="fbls-market-legs" tabindex="0" aria-label="Участки исходящей перевозки">{{#each outboundRouteLegs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
                <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
                <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}{{#if chargedText}} · {{chargedText}}{{/if}}</small>{{/if}}</li>{{/each}}</ol>{{/if}}
              {{#if outboundBuyerText}}<p><strong>Покупатели:</strong> {{outboundBuyerText}}</p>{{/if}}
            </details>
            {{#if outboundPlanReason}}<p class="fbls-market-error"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{outboundPlanReason}}</p>{{/if}}
            <div class="fbls-action-group">
              <button type="button" class="fbls-button ghost" data-action="market-outbound-clear">Сбросить выбор</button>
              <button type="button" class="fbls-button primary" data-action="market-outbound-book" {{#unless outboundCanBook}}disabled{{/unless}}><i class="fa-solid fa-file-signature" aria-hidden="true"></i> Продать {{outboundSelectedUnits}} ед.</button>
            </div>
            <p class="fbls-market-outbound-note">Товар резервируется при подтверждении. Выручка поступит {{#if outboundOwnShipSelected}}на борт{{else}}в казну{{/if}} после доставки.</p>
            {{else}}
            <p class="fbls-market-outbound-note">Укажите количество у нужных товаров. Здесь появятся доставка, расходы и выручка.</p>
            {{/if}}
          </div>
        </div>
      </details>
      {{/if}}

      {{#if hasOutboundOrders}}
        <details class="fbls-market-outbound-tracking" data-fbls-disclosure="market-outbound-orders">
          <summary><span><i class="fa-solid fa-chevron-right fbls-market-disclosure-icon" aria-hidden="true"></i> <strong>Текущие продажи</strong> <small>{{outboundOrders.length}}</small></span>{{#if outboundNeedsAttention}}<span class="fbls-chip is-compact">Нужно решение GM</span>{{/if}}</summary>
        <div class="fbls-market-outbound-orders">
          {{#each outboundOrders}}
            <article class="fbls-market-shipment {{status}}" data-market-outbound-order="{{id}}" tabindex="-1" aria-label="Исходящая продажа: {{marketLabel}}">
              <header><strong>{{marketLabel}}</strong><span>{{statusLabel}}</span></header>
              {{#if batchText}}<small>{{batchText}}</small>{{/if}}
              <p>{{cargoText}}</p>
              {{#if buyerText}}<small>Покупатели: {{buyerText}}</small>{{/if}}
              <p class="fbls-market-shipment-risk">{{riskText}}</p>
              {{#if timingText}}<p>{{timingText}}</p>{{/if}}
              <small>{{financialRiskText}}</small>
              {{#if routeLegs}}<details class="fbls-market-transport-details" data-fbls-disclosure="market-transport-out:{{id}}"><summary>Участки перевозки</summary>
                <ol class="fbls-market-legs" tabindex="0" aria-label="Сохранённые участки продажи">{{#each routeLegs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
                  <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
                  <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}{{#if chargedText}} · {{chargedText}}{{/if}}</small>{{/if}}</li>{{/each}}</ol>
              </details>{{/if}}
              {{#if canResolveRisk}}
                <details open>
                  <summary><i class="fa-solid fa-user-shield"></i> GM: {{gmResolution.proposalLabel}}</summary>
                  <p>{{gmResolution.insuranceText}}</p>
                  <div class="fbls-action-group">
                    <button type="button" class="fbls-button compact primary" data-action="market-outbound-resolve-risk" data-order-id="{{id}}" data-risk-outcome="proposal" data-delay-qd="{{gmResolution.delayQd}}"><i class="fa-solid fa-check"></i> {{gmResolution.applyLabel}}</button>
                    <button type="button" class="fbls-button compact" data-action="market-outbound-resolve-risk" data-order-id="{{id}}" data-risk-outcome="clear"><i class="fa-solid fa-forward"></i> Без последствий</button>
                    <button type="button" class="fbls-button compact" data-action="market-outbound-resolve-risk" data-order-id="{{id}}" data-risk-outcome="delayed" data-delay-qd="{{gmResolution.delayQd}}"><i class="fa-solid fa-clock"></i> Задержка</button>
                    <button type="button" class="fbls-button compact danger" data-action="market-outbound-resolve-risk" data-order-id="{{id}}" data-risk-outcome="lost"><i class="fa-solid fa-skull-crossbones"></i> Утрата</button>
                  </div>
                </details>
              {{/if}}
              <footer><small>{{routeText}} · ETA {{remainingText}} · расходы {{upfrontText}} · выручка {{revenueText}}</small>{{#if canCancel}}<button type="button" class="fbls-button compact danger" data-action="market-outbound-cancel" data-order-id="{{id}}"><i class="fa-solid fa-ban"></i> Отменить</button>{{/if}}</footer>
            </article>
          {{/each}}
        </div>
        </details>
      {{/if}}
      {{#if hasOutboundArchive}}
        <details class="fbls-market-outbound-archive" data-fbls-disclosure="market-outbound-archive">
          <summary><span><i class="fa-solid fa-chevron-right fbls-market-disclosure-icon" aria-hidden="true"></i> Архив продаж</span><b>{{outboundArchive.length}}</b></summary>
          {{#each outboundArchive}}<article class="fbls-market-outbound-archive-row {{status}}"><header><strong>{{marketLabel}}</strong><span>{{statusLabel}}</span></header><p>{{cargoText}}</p><small>{{dateText}} · выручка {{revenueText}} · {{statusText}}</small>
            {{#if routeLegs}}<details class="fbls-market-transport-details" data-fbls-disclosure="market-transport-out:{{id}}"><summary>Участки перевозки</summary>
              <ol class="fbls-market-legs" tabindex="0" aria-label="Сохранённые участки продажи">{{#each routeLegs}}<li>{{#if hidden}}<strong>Скрытый участок</strong>{{else}}
                <div class="fbls-card-header"><strong>{{fromLabel}} → {{toLabel}}</strong><span class="fbls-chip is-compact">{{modeLabel}}</span></div>
                <small>{{carrierLabel}} · {{distanceText}} · базовое время {{timeText}}{{#if transferText}} (в т. ч. {{transferText}}){{/if}} · до {{capacityText}}{{#if chargedText}} · {{chargedText}}{{/if}}</small>{{/if}}</li>{{/each}}</ol>
            </details>{{/if}}
          </article>{{/each}}
        </details>
      {{/if}}
    </section>
    {{/if}}
  </div>
{{else}}
  <div class="fbls-empty">Поселение недоступно.</div>
{{/if}}
