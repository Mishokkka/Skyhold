<div class="fbls-transport-shell">
{{#if hasHolding}}
  <header class="fbls-toolbar fbls-transport-header">
    <h1><i class="fa-solid fa-route" aria-hidden="true"></i> {{holdingName}}</h1>
    {{#if isGM}}<button type="button" class="fbls-button fbls-button-role" data-action="transport-advance" {{#if busy}}disabled{{/if}}>Обработать текущую дату</button>{{/if}}
  </header>
  <div class="fbls-transport-content fbls-stack" data-render-scroll-key="transport-content">
  {{#if error}}<p class="fbls-callout is-error" role="alert">{{error}}</p>{{/if}}
  {{#if pending}}
  <div class="fbls-toolbar fbls-callout is-warning">
    <span role="status">Команда ожидает подтверждения. Повторная проверка продолжит тот же заказ.</span>
    <button type="button" class="fbls-button fbls-button-role" data-action="transport-retry" {{#if busy}}disabled{{/if}}>Проверить повторно</button>
  </div>
  {{/if}}

  {{#if hasRequest}}
    {{#if choices}}
    <section class="fbls-transport-choices" aria-label="Способ доставки">
      {{#each choices}}
      <button type="button" class="fbls-choice-card fbls-transport-choice {{#if selected}}is-selected{{/if}} {{#unless available}}is-unavailable{{/unless}}" data-action="transport-select-mode" data-mode="{{mode}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
        <span class="fbls-card-header">
          <strong><i class="{{icon}}" aria-hidden="true"></i> {{title}}</strong>
          {{#if available}}<span class="fbls-chip is-compact">{{arrival}}</span>{{else}}<span class="fbls-chip is-compact">Недоступно</span>{{/if}}
        </span>
        <span class="fbls-transport-choice-sub"><small>{{subtitle}}</small>{{#if badge}}<span class="fbls-chip is-compact fbls-transport-choice-badge">{{badge}}</span>{{/if}}</span>
        {{#if available}}
          <span class="fbls-transport-choice-price">Доставка: <strong>{{delivery}}</strong></span>
          <small>{{summary}}{{#if risk}} · риск {{risk}}{{/if}}</small>
          {{#if transferNote}}<small>{{transferNote}}</small>{{/if}}
        {{else}}
          <small class="fbls-transport-choice-error">{{error}}</small>
        {{/if}}
      </button>
      {{/each}}
    </section>
    {{/if}}

    {{#if isOwnedMode}}
    <section class="fbls-panel fbls-transport-fields" aria-label="Параметры своего корабля">
      {{#if showShipPicker}}
      <label class="fbls-field"><span>Корабль</span>
        <select class="fbls-control" data-transport-field="ownShipId">
          {{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if busy}}disabled{{/if}}>{{name}}{{#if busy}} (занят){{/if}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
      <label class="fbls-checkbox-label fbls-choice-toggle"><input type="checkbox" data-transport-field="returnHome" {{checked request.returnHome}} /> <span>Вернуть корабль домой</span></label>
      <label class="fbls-field"><span>Запас денег на борту, ММ</span><input class="fbls-control" type="number" min="0" step="1" data-transport-field="reserveCopper" value="{{request.reserveCopper}}" /></label>
      {{#if needsShipTimeSync}}<button type="button" class="fbls-button fbls-button-role" data-action="transport-ship-sync">Довести время корабля</button>{{/if}}
    </section>
    {{/if}}

    {{#if quoteError}}<p class="fbls-callout is-error" role="alert">{{quoteError}}</p>{{/if}}

    {{#if selected}}
    <article class="fbls-panel fbls-stack fbls-transport-quote">
      <header class="fbls-toolbar">
        <h2 class="fbls-section-heading">Смета перевозки</h2>
        <div class="fbls-toolbar-group">
          <label class="fbls-checkbox-label fbls-choice-toggle"><input type="checkbox" data-transport-field="insurance" {{checked request.insurance}} /> <span>Страхование</span></label>
          <button type="button" class="fbls-button fbls-button-role primary" data-action="transport-confirm" {{#unless canConfirm}}disabled{{/unless}}>{{#if busy}}Оформляем…{{else}}Подтвердить заказ{{/if}}</button>
        </div>
      </header>
      <dl class="fbls-transport-metrics">
        <div><dt>Прибытие груза</dt><dd>{{selected.arrival}}</dd></div>
        <div><dt>Доставка и сборы</dt><dd>{{selected.delivery}}</dd></div>
        <div><dt>Сейчас из казны</dt><dd>{{selected.treasury}}</dd></div>
        <div><dt>{{#if selected.outbound}}Выручка за товар{{else}}Стоимость товара{{/if}}</dt><dd>{{selected.value}}</dd></div>
      </dl>
      {{#if selected.outbound}}<p>Чистый итог после доставки и сборов: <strong>{{selected.net}}</strong>. Зачисление {{#if selected.revenueOnBoard}}на борт корабля{{else}}в казну{{/if}}.</p>{{/if}}
      {{#if selected.splitArrival}}<p>Первая часть прибудет через {{selected.firstArrival}}.</p>{{/if}}
      {{#if selected.shipRelease}}<p>Корабль освободится через {{selected.shipRelease}} ({{selected.shipReleaseLocation}}). Расходы судна: {{selected.ownExpenses}}; запас на борту: {{selected.reserve}}.</p>{{/if}}
      <ol class="fbls-transport-stages fbls-stack">
        {{#each selected.stages}}
        <li class="fbls-stack">
          <div class="fbls-card-header"><strong>{{path}}</strong><span class="fbls-chip is-compact">{{price}}</span></div>
          <p>{{label}}{{#if vehicles}} · {{vehicles}}{{/if}}{{#if distance}} · {{distance}}{{/if}}{{#if interval}} · раз в {{interval}}{{/if}}</p>
          <small>Отправление через {{departure}}, прибытие через {{arrival}} · риск происшествия на отправление: {{risk}}{{#if multiRun}} · ходок: {{count}}{{/if}}</small>
          {{#if multiRun}}
          <details data-fbls-disclosure="transport-departures:{{@index}}">
            <summary>Ходки ({{count}})</summary>
            <ol class="fbls-transport-departures fbls-stack">
              {{#each departures}}<li>
                <strong>№ {{number}} · {{qty}} ед. · {{price}}</strong>
                <small>Отправление через {{departure}}, прибытие через {{arrival}} · риск происшествия: {{risk}}</small>
              </li>{{/each}}
            </ol>
          </details>
          {{/if}}
        </li>
        {{/each}}
      </ol>
      {{#each selected.warnings}}<p class="fbls-callout is-warning" role="status">{{this}}</p>{{/each}}
      <details data-fbls-disclosure="transport-invoice">
        <summary>Товары и подробности счёта</summary>
        <ul>{{#each selected.cargo}}<li>{{name}} × {{qty}}</li>{{/each}}</ul>
        <p>Пошлины: {{selected.tax}}. Страхование: {{selected.insurance}} (покрытие утраты {{selected.coveragePercent}}%; порча от времени не страхуется). {{#if selected.approach}}Пустой подход своего корабля: {{selected.approach}}.{{/if}}</p>
      </details>
    </article>
    {{/if}}
  {{else}}
    <p class="fbls-callout">Для новой перевозки выберите товары на внешнем рынке и нажмите «Рассчитать перевозку».</p>
  {{/if}}

  {{#each incidents}}
  <article class="fbls-panel fbls-stack fbls-transport-incident" data-transport-incident="{{id}}">
    <h2 class="fbls-section-heading">Происшествие на рейсе</h2>
    <p>{{label}} · заказов на рейсе: {{orders}}</p>
    {{#if awaitingCargo}}<p class="fbls-callout is-warning" role="status">Для распределения утраты сначала обработайте предыдущие отправления: {{awaitingCargo}}.</p>{{/if}}
    <div class="fbls-transport-fields">
      <label class="fbls-field"><span>Задержка, дни</span><input class="fbls-control" type="number" min="0.25" max="360" step="0.25" data-transport-incident-field="delayDays" value="{{delayDays}}" /></label>
      <label class="fbls-field"><span>Утрачено груза, %</span><input class="fbls-control" type="number" min="0" max="100" step="0.01" data-transport-incident-field="lossPercent" value="{{lossPercent}}" /></label>
    </div>
    <div class="fbls-action-group">
      <button type="button" class="fbls-button" data-action="transport-incident-success" data-run="{{id}}">Груз цел</button>
      <button type="button" class="fbls-button" data-action="transport-incident-delay" data-run="{{id}}">Применить задержку</button>
      <button type="button" class="fbls-button" data-action="transport-incident-loss" data-run="{{id}}" {{#if awaitingCargo}}disabled{{/if}}>Применить утрату</button>
    </div>
  </article>
  {{/each}}

  {{#if orders}}<h2 class="fbls-section-heading">Заказы</h2>{{/if}}
  {{#if history.count}}
  <nav class="fbls-toolbar" aria-label="Страницы истории перевозок">
    <button type="button" class="fbls-button" data-action="transport-history-previous" {{#unless history.previous}}disabled{{/unless}}>Более новые</button>
    <span>История: {{history.count}} заказов · страница {{history.page}} из {{history.pages}}.</span>
    <button type="button" class="fbls-button" data-action="transport-history-next" {{#unless history.next}}disabled{{/unless}}>Более старые</button>
  </nav>
  {{/if}}
  {{#each orders}}
  <article class="fbls-panel fbls-stack">
    <div class="fbls-card-header"><strong>{{direction}} · {{market}}</strong><span class="fbls-chip">{{status}}</span></div>
    {{#if cargoSummary}}<p class="fbls-transport-order-cargo"><i class="fa-solid fa-box-open" aria-hidden="true"></i> {{cargoSummary}}</p>{{/if}}
    <dl class="fbls-transport-metrics">
      <div><dt>Получено</dt><dd>{{received}} / {{total}} ед.</dd></div>
      <div><dt>Доставка и сборы</dt><dd>{{cost}}</dd></div>
      <div><dt>В резерве</dt><dd>{{escrow}}</dd></div>
    </dl>
    {{#if lost}}<p>Утрачено при происшествиях: {{lost}} ед.</p>{{/if}}
    {{#if spoiled}}<p>Испортилось: {{spoiled}} ед. Порча не покрывается страховкой.</p>{{/if}}
    {{#if insurancePaid}}<p>Страховая выплата в казну: {{insurancePaid}}.</p>{{/if}}
    {{#if waitingReason}}<p class="fbls-callout is-warning" role="status">{{waitingReason}}</p>{{/if}}
    {{#if shipStatus}}<p>{{shipStatus}}. {{shipTiming}}</p>{{/if}}
    {{#if shipReturnBlocked}}<p role="status">Возврат домой из текущего порта недоступен по маршруту или УРС; корабль остаётся в порту.</p>{{/if}}
    {{#if fundingNeeded}}
      <p role="status">Дополнительные расходы судна: требуется ещё {{fundingNeeded}}.</p>
      {{#if canFund}}<button type="button" class="fbls-button" data-action="transport-fund" data-order="{{id}}">Добавить {{fundingNeeded}} из казны и продолжить</button>{{/if}}
    {{/if}}
    <details data-fbls-disclosure="transport-order:{{id}}"><summary>Маршрут и расписание заказа · состав груза</summary>
      {{#if cargo.length}}<ul>{{#each cargo}}<li>{{name}} × {{qty}}</li>{{/each}}</ul>{{/if}}
      <ol>{{#each stages}}<li>
        <details data-fbls-disclosure="transport-order:{{../id}}:stage:{{index}}">
          <summary>{{path}} · отправлений: {{count}} · {{price}}</summary>
          <ol>{{#each departures}}<li>
            Отправление {{number}} · {{qty}} ед. · {{status}}.
            {{#unless cancelled}}Отправка: {{departure}}; прибытие: {{arrival}}.{{/unless}}{{#if recorded}} Выгружено: {{received}} ед.{{/if}}
            {{#if provisional}}Даты предварительные до обработки происшествий.{{/if}}
          </li>{{else}}<li>Грузовых отправлений нет.</li>{{/each}}</ol>
        </details>
      </li>{{/each}}</ol>
    </details>
    {{#if canCancel}}<div class="fbls-action-group"><button type="button" class="fbls-button fbls-button-role danger" data-action="transport-cancel" data-order="{{id}}">Отменить заказ и вернуть деньги</button></div>{{/if}}
  </article>
  {{/each}}

  {{#if legacyActive}}<details class="fbls-panel" data-fbls-disclosure="transport-legacy-active" open><summary>Незавершённые заказы прежней версии</summary>
    {{#each legacyActive}}<article><strong>{{direction}} · {{market}} · {{id}}</strong><span>{{status}}</span><p>{{cargo}}</p></article>{{/each}}
  </details>{{/if}}
  {{#if archive}}<details class="fbls-panel" data-fbls-disclosure="transport-history"><summary>История прежних заказов</summary>
    {{#each archive}}<article><strong>{{direction}} · {{market}}</strong><span>{{status}}</span><p>{{cargo}}</p></article>{{/each}}
  </details>{{/if}}

  {{#if isGM}}
  <details class="fbls-panel" data-fbls-disclosure="transport-configuration"><summary>Настройки тарифов и расписания (ГМ)</summary>
    <p>Глобальные правила расчёта для новых наёмных перевозок (на уже оформленные заказы не влияют).</p>
    <div class="fbls-transport-fields">
      <label class="fbls-field"><span>Интервал сборных рейсов, дни</span><input class="fbls-control" type="number" min="0.25" step="0.25" data-transport-config="regularIntervalQd" data-scale="4" value="{{configurationView.intervalDays}}" /></label>
      <label class="fbls-field"><span>Сдвиг первого рейса, дни</span><input class="fbls-control" type="number" min="0" step="0.25" data-transport-config="regularFirstQd" data-scale="4" value="{{configurationView.phaseDays}}" /></label>
      <label class="fbls-field"><span>Чартерных судов на линию</span><input class="fbls-control" type="number" min="1" max="10000" step="1" data-transport-config="charterVehicles" value="{{configuration.charterVehicles}}" /></label>
      <label class="fbls-field"><span>Средняя загрузка сборного рейса, %</span><input class="fbls-control" type="number" min="0.01" max="100" step="0.01" data-transport-config="commercialLoadBps" data-scale="100" value="{{configurationView.commercialPercent}}" /></label>
      <label class="fbls-field"><span>Наценка перевозчика, %</span><input class="fbls-control" type="number" min="0" max="100" step="1" data-transport-config="carrierProfitBps" data-scale="100" value="{{configurationView.profitPercent}}" /></label>
      <label class="fbls-field"><span>Минимальная страховка, %</span><input class="fbls-control" type="number" min="0" max="100" step="0.1" data-transport-config="insuranceBps" data-scale="100" value="{{configurationView.insurancePercent}}" /></label>
    </div>
    <button type="button" class="fbls-button fbls-button-role" data-action="transport-configure" {{#if busy}}disabled{{/if}}>Сохранить настройки</button>
  </details>
  {{/if}}
  </div>
{{else}}<div class="fbls-transport-content"><p class="fbls-callout is-error" role="alert">Поселение недоступно.</p></div>{{/if}}
</div>
