<section class="fbls-market-studio fbls-economy-studio">
  <header class="fbls-market-studio-head">
    <div>
      <span class="fbls-market-studio-kicker">GM · экономика мира</span>
      <h2>Конструктор внешнего рынка</h2>
      <p>Базовый ассортимент → характер государства → специализация локации → продавец и перевозчик.</p>
    </div>
    <div class="fbls-economy-summary">
      <span class="fbls-chip is-accent"><b>{{summary.baseOfferCount}}</b> базовых товаров</span>
      <span class="fbls-chip is-accent"><b>{{summary.countryCount}}</b> государств</span>
      <span class="fbls-chip is-accent"><b>{{summary.locationCount}}</b> локаций</span>
      <span class="fbls-chip is-accent"><b>{{summary.organizationCount}}</b> организаций</span>
    </div>
  </header>

  <nav class="fbls-economy-tabs" aria-label="Слои экономики рынка">
    <button type="button" class="fbls-subnav-tab is-expanded {{#if section.base}}is-active{{/if}}" data-action="market-economy-section" data-section="base"><i class="fa-solid fa-boxes-stacked"></i><span>Основа</span><small>общий ассортимент</small></button>
    <button type="button" class="fbls-subnav-tab is-expanded {{#if section.countries}}is-active{{/if}}" data-action="market-economy-section" data-section="countries"><i class="fa-solid fa-flag"></i><span>Государства</span><small>характер рынка</small></button>
    <button type="button" class="fbls-subnav-tab is-expanded {{#if section.specialties}}is-active{{/if}}" data-action="market-economy-section" data-section="specialties"><i class="fa-solid fa-wand-magic-sparkles"></i><span>Специализации</span><small>особенности локаций</small></button>
    <button type="button" class="fbls-subnav-tab is-expanded {{#if section.organizations}}is-active{{/if}}" data-action="market-economy-section" data-section="organizations"><i class="fa-solid fa-building-columns"></i><span>Организации</span><small>продажа, покупка, доставка</small></button>
    <button type="button" class="fbls-subnav-tab is-expanded {{#if section.system}}is-active{{/if}}" data-action="market-economy-section" data-section="system"><i class="fa-solid fa-sliders"></i><span>Система</span><small>размеры и состояния</small></button>
  </nav>

  <div class="fbls-economy-content">
    {{#if section.base}}
      <section class="fbls-economy-pane">
        <header class="fbls-economy-pane-head">
          <div><h3>Стандартный шаблон рынка</h3><p>Эти товары потенциально существуют во всех государствах. Размер рынка ограничивает редкость, а последующие слои меняют цену и запас.</p></div>
          <div class="fbls-economy-base-tools">
            <label class="fbls-economy-inline-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-economy-search="base" value="{{searches.base}}" placeholder="Найти товар или тег…" /><small><b data-economy-search-count="base">{{baseOffers.length}}</b> поз.</small></label>
            {{#if canEdit}}<button type="button" class="fbls-button primary compact" data-action="market-economy-add" data-kind="base-offer"><i class="fa-solid fa-plus"></i> Товар</button>{{/if}}
          </div>
        </header>
        <div class="fbls-economy-offer-list">
          {{#each baseOffers}}
            <article class="fbls-economy-offer {{#unless active}}is-disabled{{/unless}}" data-economy-card data-economy-search-row="base" data-economy-search-text="{{searchText}}">
              <header>
                <label class="fbls-economy-check" title="Товар входит в базовый шаблон"><input type="checkbox" aria-label="Включить строку {{id}}" data-type="checkbox" data-economy-field="active" data-scope="base-offer" data-row-id="{{id}}" {{#if active}}checked{{/if}} /><span></span></label>
                <i class="{{displayIcon}}"></i>
                <div><strong>{{displayName}}</strong><small>{{id}} · {{resourceId}}</small></div>
                <div class="fbls-economy-offer-actions"><button type="button" class="fbls-button compact" data-action="market-economy-pick-resource" data-scope="base-offer" data-row-id="{{id}}" data-resource-id="{{resourceId}}"><i class="fa-solid fa-book-open"></i> Каталог</button><button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="base-offer" data-row-id="{{id}}" title="Удалить товар" aria-label="Удалить товар {{displayName}}"><i class="fa-solid fa-trash"></i></button></div>
              </header>
              <div class="fbls-economy-offer-grid">
                <label class="identity fbls-field"><span>Название (необязательно)</span><input type="text" value="{{name}}" data-economy-field="name" data-scope="base-offer" data-row-id="{{id}}" placeholder="Из каталога: {{displayName}}" /></label>
                <label class="fbls-field"><span>Категория</span><select data-economy-field="kind" data-scope="base-offer" data-row-id="{{id}}">{{#each kindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="fbls-field"><span>Распространённость</span><select data-economy-field="ubiquity" data-scope="base-offer" data-row-id="{{id}}">{{#each ubiquityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="fbls-field"><span>Базовый спрос</span><input type="number" min="0" step="1" value="{{baseDemand}}" data-type="number" data-economy-field="baseDemand" data-scope="base-offer" data-row-id="{{id}}" title="Независимый пул закупки этого ресурса рынком" /></label>
                {{#if isItemOffer}}
                  <label class="fbls-field"><span>Цена предмета, ММ</span><input type="number" min="1" step="1" value="{{priceOverrideValue}}" data-type="number" data-economy-field="priceOverrideCopper" data-scope="base-offer" data-row-id="{{id}}" data-rerender /></label>
                {{else}}
                  <label class="fbls-field"><span>Цена каталога</span><input type="number" value="{{canonicalPriceCopper}}" disabled title="Базовая цена принадлежит ресурсу" /></label>
                  <label class="fbls-field"><span>Переопределение, ММ</span><input type="number" min="1" step="1" value="{{priceOverrideValue}}" placeholder="Наследуется: {{canonicalPriceCopper}}" data-type="number" data-economy-field="priceOverrideCopper" data-scope="base-offer" data-row-id="{{id}}" data-rerender /><small>{{#if hasPriceOverride}}Явная цена товара{{else}}Цена ресурса{{/if}}</small></label>
                {{/if}}
                <label class="fbls-field"><span>Коэффициент цены</span><input type="number" min="0.05" max="20" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="base-offer" data-row-id="{{id}}" data-rerender /><small>Итоговая база: {{effectivePriceCopper}} ММ</small></label>
                <label class="fbls-field"><span>Базовый запас</span><input type="number" min="0" step="1" value="{{baseStock}}" data-type="number" data-economy-field="baseStock" data-scope="base-offer" data-row-id="{{id}}" /></label>
                <label class="fbls-field"><span>Разброс цены</span><input type="number" min="0" max="0.8" step="0.01" value="{{volatility}}" data-type="number" data-economy-field="volatility" data-scope="base-offer" data-row-id="{{id}}" /></label>
                {{#if isItemOffer}}
                  <label class="fbls-field"><span>Нагрузка предмета, пункты</span><input type="number" min="0" step="1" value="{{loadOverrideValue}}" data-type="number" data-economy-field="loadOverridePoints" data-scope="base-offer" data-row-id="{{id}}" data-rerender /><small>{{effectiveLoadText}}</small></label>
                {{else}}
                  <div class="fbls-field"><span>Каноническая нагрузка ресурса</span><b>{{canonicalLoadText}}</b><small>Одинакова на складе, в доставке и на корабле. Изменяется в каталоге ресурсов.</small></div>
                {{/if}}
                <label class="fbls-field"><span data-fbls-tooltip="Добавляется к стоимости доступа выбранного пути от поселения до рынка.">Сложность УРС</span><input type="number" min="0" max="100" step="1" value="{{accessDifficulty}}" data-type="number" data-economy-field="accessDifficulty" data-scope="base-offer" data-row-id="{{id}}" /></label>
                <label class="wide fbls-field"><span>Теги для правил</span><input type="text" value="{{tagsText}}" data-list data-economy-field="tags" data-scope="base-offer" data-row-id="{{id}}" placeholder="food, fuel, metal" /></label>
              </div>
            </article>
          {{/each}}
          <div class="fbls-empty-state is-compact fbls-market-empty-state compact" data-economy-search-empty="base" {{#if baseOffers.length}}hidden{{/if}}><i class="fa-solid fa-magnifying-glass"></i><strong>{{#if baseOffers.length}}Ничего не найдено{{else}}Базовый ассортимент пуст{{/if}}</strong><p>{{#if baseOffers.length}}Измените запрос или очистите строку поиска.{{else}}Добавьте первый общий товар кнопкой сверху.{{/if}}</p></div>
        </div>
      </section>
    {{/if}}

    {{#if section.countries}}
      <div class="fbls-economy-master-detail">
        <aside class="fbls-economy-list-panel">
          <header><div><strong>Государства</strong><small data-economy-search-count="country">{{countries.length}}</small></div>{{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="market-economy-add" data-kind="country" title="Добавить государство" aria-label="Добавить государство"><i class="fa-solid fa-plus"></i></button>{{/if}}</header>
          <label class="fbls-economy-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-economy-search="country" value="{{searches.country}}" placeholder="Найти государство…" /></label>
          <nav>
            {{#each countries}}<button type="button" class="{{#if selected}}is-active{{/if}} {{#unless active}}is-disabled{{/unless}}" data-action="market-country-select" data-country-id="{{id}}" data-economy-search-row="country" data-economy-search-text="{{searchText}}"><i class="fa-solid fa-flag"></i><span><strong>{{label}}</strong><small>{{id}}</small></span></button>{{/each}}
          </nav>
        </aside>
        <main class="fbls-economy-detail">
          {{#if selectedCountry}}
            <header class="fbls-economy-detail-head"><div><span>Характер национального рынка</span><h3>{{selectedCountry.label}}</h3><small>{{selectedCountry.locationCount}} рынков-локаций используют этот профиль</small></div>{{#if canEdit}}<button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="country" data-row-id="{{selectedCountry.id}}" title="Удалить государство" aria-label="Удалить государство {{selectedCountry.label}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</header>
            <section class="fbls-economy-card">
              <header><div><h4>Карточка государства</h4><p>Долговременный профиль страны; временный кризис задаётся состоянием.</p></div></header>
              <div class="fbls-economy-form-grid three">
                <label class="wide fbls-field"><span>Название</span><input type="text" value="{{selectedCountry.label}}" data-economy-field="label" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
                <label class="fbls-field"><span>Стабильный ID</span><input type="text" value="{{selectedCountry.id}}" disabled /></label>
                <label class="fbls-field"><span>Состояние</span><select data-economy-field="conditionId" data-scope="country" data-owner-id="{{selectedCountry.id}}">{{#each selectedCountry.conditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="fbls-field"><span>Видимость</span><select data-economy-field="visibility" data-scope="country" data-owner-id="{{selectedCountry.id}}">{{#each selectedCountry.visibilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="fbls-field"><span>Торговый режим</span><input type="text" value="{{selectedCountry.tradeRegime}}" data-economy-field="tradeRegime" data-scope="country" data-owner-id="{{selectedCountry.id}}" placeholder="open, controlled, embargo" /></label>
                <label class="fbls-field"><span>Ввозная пошлина</span><input type="number" min="0" max="1" step="0.01" value="{{selectedCountry.taxRate}}" data-type="number" data-economy-field="taxRate" data-scope="country" data-owner-id="{{selectedCountry.id}}" /><small>В стране назначения; местная пошлина прибавляется к ней.</small></label>
                <label class="fbls-field"><span>Вывозная пошлина</span><input type="number" min="0" max="1" step="0.01" value="{{selectedCountry.exportTaxRate}}" data-type="number" data-economy-field="exportTaxRate" data-scope="country" data-owner-id="{{selectedCountry.id}}" /><small>В стране отправления. Старые страны начинают с нулевой ставки.</small></label>
                <label class="wide fbls-field"><span>Теги</span><input type="text" value="{{selectedCountry.tagsText}}" data-list data-economy-field="tags" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
                <label class="wide fbls-field"><span>Описание</span><textarea rows="3" data-economy-field="description" data-scope="country" data-owner-id="{{selectedCountry.id}}">{{selectedCountry.description}}</textarea></label>
                <label class="fbls-economy-switch wide fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Государство участвует в торговле. Отключение скрывает все его рынки-локации."><input type="checkbox" data-type="checkbox" data-economy-field="active" data-scope="country" data-owner-id="{{selectedCountry.id}}" {{#if selectedCountry.active}}checked{{/if}} /><span>Торговля страны</span></label>
              </div>
            </section>
            <section class="fbls-economy-card">
              <header><div><h4>Общие коэффициенты</h4><p>Применяются ко всему рынку страны до локальных специализаций.</p></div></header>
              <div class="fbls-economy-factor-grid">
                <label><span>Цена<small>1,20 = +20%</small></span><input type="number" min="0.05" step="0.05" value="{{selectedCountry.priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
                <label><span>Запас<small>0,50 = вдвое меньше</small></span><input type="number" min="0" step="0.05" value="{{selectedCountry.stockFactor}}" data-type="number" data-economy-field="stockFactor" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
                <label><span>Доставка<small>Стоимость пути</small></span><input type="number" min="0.05" step="0.05" value="{{selectedCountry.deliveryFactor}}" data-type="number" data-economy-field="deliveryFactor" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
                <label><span>Время<small>Срок маршрута</small></span><input type="number" min="0.05" step="0.05" value="{{selectedCountry.timeFactor}}" data-type="number" data-economy-field="timeFactor" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
                <label><span>Риск<small>Утрата и задержка</small></span><input type="number" min="0.05" step="0.05" value="{{selectedCountry.riskFactor}}" data-type="number" data-economy-field="riskFactor" data-scope="country" data-owner-id="{{selectedCountry.id}}" /></label>
              </div>
            </section>
            <section class="fbls-economy-card">
              <header><div><h4>Правила характера рынка</h4><p>Применяются к товарам по тегам или ID ресурса. Например, винодельческая страна производит wine, но потребляет iron.</p></div>{{#if canEdit}}<button type="button" class="fbls-button compact" data-action="market-economy-add" data-kind="country-rule"><i class="fa-solid fa-plus"></i> Правило</button>{{/if}}</header>
              <div class="fbls-economy-rule-list">
                {{#each selectedCountry.rules}}
                  <article class="fbls-economy-rule {{#unless active}}is-disabled{{/unless}}" data-economy-card>
                    <label class="fbls-economy-check"><input type="checkbox" aria-label="Включить строку {{id}}" data-type="checkbox" data-economy-field="active" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" {{#if active}}checked{{/if}} /><span></span></label>
                    <input type="text" value="{{label}}" data-economy-field="label" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" />
                    <select data-economy-field="mode" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}">{{#each modeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <input type="text" value="{{targetTagsText}}" data-list data-economy-field="targetTags" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" placeholder="Теги: food, wine" />
                    <input type="text" value="{{resourceIdsText}}" data-list data-economy-field="resourceIds" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" placeholder="ID ресурсов" />
                    <label class="fbls-field"><span>Запас</span><input type="number" step="0.05" value="{{stockFactor}}" data-type="number" data-economy-field="stockFactor" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" /></label>
                    <label class="fbls-field"><span>Цена</span><input type="number" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" /></label>
                    <button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="country-rule" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" aria-label="Удалить правило {{label}}"><i class="fa-solid fa-trash"></i></button>
                  </article>
                {{else}}<p class="fbls-empty">Нет правил: страна использует стандартный рынок без изменений.</p>{{/each}}
              </div>
            </section>
            <section class="fbls-economy-card">
              <header><div><h4>Уникальные товары государства</h4><p>Добавляются поверх стандартного ассортимента во всех локациях страны.</p></div>{{#if canEdit}}<button type="button" class="fbls-button compact" data-action="market-economy-add" data-kind="country-offer"><i class="fa-solid fa-plus"></i> Товар</button>{{/if}}</header>
              <div class="fbls-economy-compact-offers">
                {{#each selectedCountry.offers}}
                  <article data-economy-card><i class="{{displayIcon}}"></i><button type="button" class="fbls-economy-resource-button" data-action="market-economy-pick-resource" data-scope="country-offer" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" data-resource-id="{{resourceId}}"><strong>{{displayName}}</strong><small>{{resourceId}}</small></button><input type="number" min="1" step="1" value="{{priceOverrideValue}}" placeholder="Каталог: {{canonicalPriceCopper}}" data-type="number" data-economy-field="priceOverrideCopper" data-scope="country-offer" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" data-rerender title="Пусто — наследовать цену ресурса; сейчас {{effectivePriceCopper}} ММ" /><input type="number" min="0.05" max="20" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="country-offer" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" data-rerender title="Коэффициент цены товара" /><input type="number" min="0" step="1" value="{{baseStock}}" data-type="number" data-economy-field="baseStock" data-scope="country-offer" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" title="Запас" /><input type="number" min="0" max="100" step="1" value="{{accessDifficulty}}" data-type="number" data-economy-field="accessDifficulty" data-scope="country-offer" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" title="Сложность УРС товара" /><button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="country-offer" data-owner-id="{{../selectedCountry.id}}" data-row-id="{{id}}" aria-label="Удалить товар {{displayName}}"><i class="fa-solid fa-trash"></i></button></article>
                {{else}}<p class="fbls-empty">Нет уникальных национальных товаров.</p>{{/each}}
              </div>
            </section>
          {{else}}<div class="fbls-empty-state fbls-market-empty-state"><i class="fa-solid fa-flag"></i><strong>Добавьте государство</strong></div>{{/if}}
        </main>
      </div>
    {{/if}}

    {{#if section.specialties}}
      <div class="fbls-economy-master-detail">
        <aside class="fbls-economy-list-panel">
          <header><div><strong>Модификаторы локаций</strong><small data-economy-search-count="specialty">{{specialties.length}}</small></div>{{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="market-economy-add" data-kind="specialty" aria-label="Добавить специализацию"><i class="fa-solid fa-plus"></i></button>{{/if}}</header>
          <label class="fbls-economy-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-economy-search="specialty" value="{{searches.specialty}}" placeholder="Рыболовство, верфь…" /></label>
          <nav>{{#each specialties}}<button type="button" class="{{#if selected}}is-active{{/if}} {{#unless active}}is-disabled{{/unless}}" data-action="market-specialty-select" data-specialty-id="{{id}}" data-economy-search-row="specialty" data-economy-search-text="{{searchText}}"><i class="fa-solid fa-wand-magic-sparkles"></i><span><strong>{{label}}</strong><small>{{category}}</small></span></button>{{/each}}</nav>
        </aside>
        <main class="fbls-economy-detail">
          {{#if selectedSpecialty}}
            <header class="fbls-economy-detail-head"><div><span>Локальная специфика</span><h3>{{selectedSpecialty.label}}</h3><small>Назначена {{selectedSpecialty.locationCount}} рынкам-локациям</small></div>{{#if canEdit}}<button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="specialty" data-row-id="{{selectedSpecialty.id}}" aria-label="Удалить специализацию {{selectedSpecialty.label}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</header>
            <section class="fbls-economy-card">
              <header><div><h4>Описание модификатора</h4><p>Одной локации можно назначить несколько совместимых специализаций.</p></div></header>
              <div class="fbls-economy-form-grid two">
                <label class="fbls-field"><span>Название</span><input type="text" value="{{selectedSpecialty.label}}" data-economy-field="label" data-scope="specialty" data-owner-id="{{selectedSpecialty.id}}" /></label>
                <label class="fbls-field"><span>Категория</span><input type="text" value="{{selectedSpecialty.category}}" data-economy-field="category" data-scope="specialty" data-owner-id="{{selectedSpecialty.id}}" /></label>
                <label class="wide fbls-field"><span>Описание</span><textarea rows="4" data-economy-field="description" data-scope="specialty" data-owner-id="{{selectedSpecialty.id}}">{{selectedSpecialty.description}}</textarea></label>
                <label class="fbls-economy-switch wide fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Модификатор доступен. Отключённый модификатор не влияет на рынок, но назначения сохраняются."><input type="checkbox" data-type="checkbox" data-economy-field="active" data-scope="specialty" data-owner-id="{{selectedSpecialty.id}}" {{#if selectedSpecialty.active}}checked{{/if}} /><span>Модификатор</span></label>
              </div>
            </section>
            <section class="fbls-economy-card">
              <header><div><h4>Изменение ассортимента</h4><p>Правила срабатывают по тегам и ресурсам после характера государства.</p></div>{{#if canEdit}}<button type="button" class="fbls-button compact" data-action="market-economy-add" data-kind="specialty-rule"><i class="fa-solid fa-plus"></i> Правило</button>{{/if}}</header>
              <div class="fbls-economy-rule-list">
                {{#each selectedSpecialty.rules}}
                  <article class="fbls-economy-rule {{#unless active}}is-disabled{{/unless}}" data-economy-card>
                    <label class="fbls-economy-check"><input type="checkbox" aria-label="Включить строку {{id}}" data-type="checkbox" data-economy-field="active" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" {{#if active}}checked{{/if}} /><span></span></label>
                    <input type="text" value="{{label}}" data-economy-field="label" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" />
                    <select data-economy-field="mode" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}">{{#each modeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <input type="text" value="{{targetTagsText}}" data-list data-economy-field="targetTags" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" placeholder="Теги товаров" />
                    <input type="text" value="{{resourceIdsText}}" data-list data-economy-field="resourceIds" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" placeholder="ID ресурсов" />
                    <label class="fbls-field"><span>Запас</span><input type="number" step="0.05" value="{{stockFactor}}" data-type="number" data-economy-field="stockFactor" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" /></label>
                    <label class="fbls-field"><span>Цена</span><input type="number" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" /></label>
                    <button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="specialty-rule" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" aria-label="Удалить правило {{label}}"><i class="fa-solid fa-trash"></i></button>
                  </article>
                {{else}}<p class="fbls-empty">Этот модификатор пока ничего не меняет.</p>{{/each}}
              </div>
            </section>
            <section class="fbls-economy-card">
              <header><div><h4>Особые товары</h4><p>Принудительно добавляются локации даже при малом размере рынка.</p></div>{{#if canEdit}}<button type="button" class="fbls-button compact" data-action="market-economy-add" data-kind="specialty-offer"><i class="fa-solid fa-plus"></i> Товар</button>{{/if}}</header>
              <div class="fbls-economy-compact-offers">
                {{#each selectedSpecialty.offers}}
                  <article><i class="{{displayIcon}}"></i><button type="button" class="fbls-economy-resource-button" data-action="market-economy-pick-resource" data-scope="specialty-offer" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" data-resource-id="{{resourceId}}"><strong>{{displayName}}</strong><small>{{resourceId}}</small></button><input type="number" min="1" step="1" value="{{priceOverrideValue}}" placeholder="Каталог: {{canonicalPriceCopper}}" data-type="number" data-economy-field="priceOverrideCopper" data-scope="specialty-offer" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" data-rerender title="Пусто — наследовать цену ресурса; сейчас {{effectivePriceCopper}} ММ" /><input type="number" min="0.05" max="20" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="specialty-offer" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" data-rerender title="Коэффициент цены товара" /><input type="number" min="0" step="1" value="{{baseStock}}" data-type="number" data-economy-field="baseStock" data-scope="specialty-offer" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" title="Запас" /><input type="number" min="0" max="100" step="1" value="{{accessDifficulty}}" data-type="number" data-economy-field="accessDifficulty" data-scope="specialty-offer" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" title="Сложность УРС товара" /><button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="specialty-offer" data-owner-id="{{../selectedSpecialty.id}}" data-row-id="{{id}}" aria-label="Удалить товар {{displayName}}"><i class="fa-solid fa-trash"></i></button></article>
                {{else}}<p class="fbls-empty">Нет отдельных товаров; используются только правила.</p>{{/each}}
              </div>
            </section>
          {{/if}}
        </main>
      </div>
    {{/if}}

    {{#if section.organizations}}
      <div class="fbls-economy-master-detail">
        <aside class="fbls-economy-list-panel">
          <header><div><strong>Компании и объединения</strong><small data-economy-search-count="organization">{{organizations.length}}</small></div>{{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="market-economy-add" data-kind="organization" aria-label="Добавить организацию"><i class="fa-solid fa-plus"></i></button>{{/if}}</header>
          <label class="fbls-economy-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-economy-search="organization" value="{{searches.organization}}" placeholder="Найти организацию…" /></label>
          <nav>{{#each organizations}}<button type="button" class="{{#if selected}}is-active{{/if}} {{#unless active}}is-disabled{{/unless}}" data-action="market-organization-select" data-organization-id="{{id}}" data-economy-search-row="organization" data-economy-search-text="{{searchText}}"><i class="{{icon}}"></i><span><strong>{{label}}</strong><small>{{#if merchant.enabled}}продаёт{{/if}}{{#if buyer.enabled}} · покупает{{/if}}{{#if carrier.enabled}} · перевозит{{/if}}</small></span></button>{{/each}}</nav>
        </aside>
        <main class="fbls-economy-detail">
          {{#if selectedOrganization}}
            <header class="fbls-economy-detail-head"><div><span>Участник рынка</span><h3>{{selectedOrganization.label}}</h3><small>{{selectedOrganization.id}}</small></div>{{#if canEdit}}<button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="organization" data-row-id="{{selectedOrganization.id}}" aria-label="Удалить организацию {{selectedOrganization.label}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</header>
            <section class="fbls-economy-card">
              <header><div><h4>Карточка организации</h4><p>Одна организация может одновременно продавать товары и перевозить грузы.</p></div></header>
              <div class="fbls-economy-form-grid three">
                <label class="wide fbls-field"><span>Название</span><input type="text" value="{{selectedOrganization.label}}" data-economy-field="label" data-scope="organization" data-owner-id="{{selectedOrganization.id}}" /></label>
                <label class="fbls-field"><span>Иконка</span><input type="text" value="{{selectedOrganization.icon}}" data-economy-field="icon" data-scope="organization" data-owner-id="{{selectedOrganization.id}}" /></label>
                <label class="fbls-field"><span>Видимость</span><select data-economy-field="visibility" data-scope="organization" data-owner-id="{{selectedOrganization.id}}">{{#each selectedOrganization.visibilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="wide fbls-field"><span>Теги</span><input type="text" value="{{selectedOrganization.tagsText}}" data-list data-economy-field="tags" data-scope="organization" data-owner-id="{{selectedOrganization.id}}" /></label>
                <label class="wide fbls-field"><span>Описание</span><textarea rows="3" data-economy-field="description" data-scope="organization" data-owner-id="{{selectedOrganization.id}}">{{selectedOrganization.description}}</textarea></label>
                <label class="fbls-economy-switch wide fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Организация активна. Неактивная компания не получает товары и не предлагается как перевозчик."><input type="checkbox" data-type="checkbox" data-economy-field="active" data-scope="organization" data-owner-id="{{selectedOrganization.id}}" {{#if selectedOrganization.active}}checked{{/if}} /><span>Активна</span></label>
              </div>
            </section>
            <div class="fbls-economy-role-grid">
              <section class="fbls-economy-card">
                <header><div><h4><i class="fa-solid fa-scale-balanced"></i> Торговая компания</h4><p>Доля выбирает личность продавца, но не делит и не клонирует запас рынка.</p></div></header>
                <label class="fbls-economy-switch fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Продаёт товары"><input type="checkbox" data-type="checkbox" data-economy-field="enabled" data-scope="organization-merchant" data-owner-id="{{selectedOrganization.id}}" {{#if selectedOrganization.merchant.enabled}}checked{{/if}} /><span>Продаёт</span></label>
                <div class="fbls-economy-form-grid two">
                  <label class="fbls-field"><span>Коэффициент цены</span><input type="number" min="0.5" max="2" step="0.01" value="{{selectedOrganization.merchant.priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="organization-merchant" data-owner-id="{{selectedOrganization.id}}" /></label>
                  <label class="fbls-field"><span>Разброс цены</span><input type="number" min="0" max="0.3" step="0.01" value="{{selectedOrganization.merchant.priceVolatility}}" data-type="number" data-economy-field="priceVolatility" data-scope="organization-merchant" data-owner-id="{{selectedOrganization.id}}" /></label>
                  <label class="fbls-field"><span>Стабильность запаса</span><input type="number" min="0.25" max="2" step="0.05" value="{{selectedOrganization.merchant.stockStability}}" data-type="number" data-economy-field="stockStability" data-scope="organization-merchant" data-owner-id="{{selectedOrganization.id}}" /></label>
                  <label class="wide fbls-field"><span>Только теги</span><input type="text" value="{{selectedOrganization.merchant.includeTagsText}}" data-list data-economy-field="includeTags" data-scope="organization-merchant" data-owner-id="{{selectedOrganization.id}}" placeholder="Пусто = любые товары" /></label>
                  <label class="wide fbls-field"><span>Исключить теги</span><input type="text" value="{{selectedOrganization.merchant.excludeTagsText}}" data-list data-economy-field="excludeTags" data-scope="organization-merchant" data-owner-id="{{selectedOrganization.id}}" /></label>
                </div>
              </section>
              <section class="fbls-economy-card">
                <header><div><h4><i class="fa-solid fa-hand-holding-dollar"></i> Закупочная компания</h4><p>Покупает товары поселения в пределах общего спроса региона; доля определяет личность покупателя, а не создаёт отдельный спрос.</p></div></header>
                <label class="fbls-economy-switch fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Покупает у поселения"><input type="checkbox" data-type="checkbox" data-economy-field="enabled" data-scope="organization-buyer" data-owner-id="{{selectedOrganization.id}}" {{#if selectedOrganization.buyer.enabled}}checked{{/if}} /><span>Покупает</span></label>
                <div class="fbls-economy-form-grid two">
                  <label class="wide fbls-field"><span>Только теги</span><input type="text" value="{{selectedOrganization.buyer.includeTagsText}}" data-list data-economy-field="includeTags" data-scope="organization-buyer" data-owner-id="{{selectedOrganization.id}}" placeholder="Пусто = любые товары" /></label>
                  <label class="wide fbls-field"><span>Исключить теги</span><input type="text" value="{{selectedOrganization.buyer.excludeTagsText}}" data-list data-economy-field="excludeTags" data-scope="organization-buyer" data-owner-id="{{selectedOrganization.id}}" /></label>
                </div>
              </section>
              <section class="fbls-economy-card">
                <header><div><h4><i class="fa-solid fa-truck-fast"></i> Транспортная компания</h4><p>Система автоматически выбирает самый дешёвый допустимый маршрут и учитывает параметры перевозчика.</p></div></header>
                <label class="fbls-economy-switch fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Перевозит грузы"><input type="checkbox" data-type="checkbox" data-economy-field="enabled" data-scope="organization-carrier" data-owner-id="{{selectedOrganization.id}}" {{#if selectedOrganization.carrier.enabled}}checked{{/if}} /><span>Перевозит</span></label>
                <div class="fbls-economy-transport-options">{{#each selectedOrganization.carrier.transportOptions}}<label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="{{label}}"><input type="checkbox" data-organization-carrier-mode="{{value}}" data-owner-id="{{../selectedOrganization.id}}" {{#if selected}}checked{{/if}} /><span><i class="{{icon}}"></i>{{label}}</span></label>{{/each}}</div>
                <div class="fbls-economy-form-grid two">
                  <label class="fbls-field"><span>Цена</span><input type="number" min="0.5" max="3" step="0.01" value="{{selectedOrganization.carrier.priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="organization-carrier" data-owner-id="{{selectedOrganization.id}}" /></label>
                  <label class="fbls-field"><span>Срок</span><input type="number" min="0.5" max="3" step="0.01" value="{{selectedOrganization.carrier.timeFactor}}" data-type="number" data-economy-field="timeFactor" data-scope="organization-carrier" data-owner-id="{{selectedOrganization.id}}" /></label>
                  <label class="fbls-field"><span>Риск</span><input type="number" min="0.25" max="3" step="0.01" value="{{selectedOrganization.carrier.riskFactor}}" data-type="number" data-economy-field="riskFactor" data-scope="organization-carrier" data-owner-id="{{selectedOrganization.id}}" /></label>
                  <label class="fbls-field"><span>Грузоподъёмность<small>1,50 = на 50% больше базового лимита транспорта</small></span><input type="number" min="0.1" max="5" step="0.1" value="{{selectedOrganization.carrier.capacityFactor}}" data-type="number" data-economy-field="capacityFactor" data-scope="organization-carrier" data-owner-id="{{selectedOrganization.id}}" /></label>
                </div>
              </section>
            </div>
            <section class="fbls-economy-card">
              <header><div><h4>Присутствие и доля по государствам</h4><p>100% — весь соответствующий рынок компании. Остаток автоматически принадлежит независимым торговцам или перевозчикам. Сумма выше 100% пропорционально нормализуется.</p></div></header>
              <div class="fbls-economy-presence-table">
                <div class="head"><span>Государство</span><span>Продажа</span><span>Покупка</span><span>Перевозки</span><span>Караван</span><span>Ж/д</span><span>Корабль</span></div>
                {{#each selectedOrganization.countryRows}}
                  <div><strong>{{label}}</strong><label><input type="number" min="0" max="100" step="1" value="{{merchantSharePct}}" data-type="number" data-economy-field="sharePct" data-scope="organization-merchant-presence" data-owner-id="{{../selectedOrganization.id}}" data-row-id="{{id}}" /><small>%</small></label><label><input type="number" min="0" max="100" step="1" value="{{buyerSharePct}}" data-type="number" data-economy-field="sharePct" data-scope="organization-buyer-presence" data-owner-id="{{../selectedOrganization.id}}" data-row-id="{{id}}" /><small>%</small></label><label><input type="number" min="0" max="100" step="1" value="{{carrierSharePct}}" data-type="number" data-economy-field="sharePct" data-scope="organization-carrier-presence" data-owner-id="{{../selectedOrganization.id}}" data-row-id="{{id}}" /><small>%</small></label><label><input type="number" min="0" max="100" step="1" value="{{caravanSharePct}}" data-type="number" data-economy-field="mode.caravan" data-scope="organization-carrier-presence" data-owner-id="{{../selectedOrganization.id}}" data-row-id="{{id}}" placeholder="общ." /><small>%</small></label><label><input type="number" min="0" max="100" step="1" value="{{railSharePct}}" data-type="number" data-economy-field="mode.rail" data-scope="organization-carrier-presence" data-owner-id="{{../selectedOrganization.id}}" data-row-id="{{id}}" placeholder="общ." /><small>%</small></label><label><input type="number" min="0" max="100" step="1" value="{{airshipSharePct}}" data-type="number" data-economy-field="mode.airship" data-scope="organization-carrier-presence" data-owner-id="{{../selectedOrganization.id}}" data-row-id="{{id}}" placeholder="общ." /><small>%</small></label></div>
                {{/each}}
              </div>
            </section>
          {{else}}<div class="fbls-empty-state fbls-market-empty-state"><i class="fa-solid fa-building-columns"></i><strong>Добавьте первую организацию</strong><p>Без компаний товары продают и покупают независимые торговцы, а грузы везут независимые перевозчики.</p></div>{{/if}}
        </main>
      </div>
    {{/if}}

    {{#if section.system}}
      <section class="fbls-economy-pane">
        <header class="fbls-economy-pane-head"><div><h3>Системные параметры</h3><p>Редактируемые шаблоны, общие для всех стран и локаций.</p></div><button type="button" class="fbls-button compact" data-action="market-route-graph-open"><i class="fa-solid fa-diagram-project"></i> Карта локаций</button></header>
        <section class="fbls-economy-card">
          <header><div><h4>Котировки, обработка и доставка</h4><p>Расстояние и транспорт считаются картой; здесь задаётся только общая обработка заказа.</p></div></header>
          <div class="fbls-economy-form-grid four">
            <label class="fbls-field"><span>Период котировки, дней</span><input type="number" min="1" max="365" step="1" value="{{settings.quotePeriodDays}}" data-type="number" data-economy-field="quotePeriodDays" data-scope="settings" /></label>
            <label class="fbls-field"><span>Подготовка, QD</span><input type="number" min="1" step="1" value="{{settings.baseDeliveryQd}}" data-type="number" data-economy-field="baseDeliveryQd" data-scope="settings" /></label>
            <label class="fbls-field"><span>Погрузка, ММ</span><input type="number" min="0" step="1" value="{{settings.handlingFlatCopper}}" data-type="number" data-economy-field="handlingFlatCopper" data-scope="settings" /></label>
            <label class="fbls-field"><span>Погрузка за массу, ММ</span><input type="number" min="0" step="0.1" value="{{settings.handlingLoadCopper}}" data-type="number" data-economy-field="handlingLoadCopper" data-scope="settings" /></label>
            <label class="fbls-field"><span>Мин. страховая ставка</span><input type="number" min="0" max="0.4" step="0.01" value="{{settings.handlingSubtotalRate}}" data-type="number" data-economy-field="handlingSubtotalRate" data-scope="settings" /></label>
            <label class="fbls-field"><span>Подготовка корабля, ММ<small>Разовая постановка к погрузке; эксплуатация и обратное плечо считаются отдельно</small></span><input type="number" min="0" step="1" value="{{settings.airshipHireCopper}}" data-type="number" data-economy-field="airshipHireCopper" data-scope="settings" /></label>
          </div>
        </section>
        <section class="fbls-economy-card">
          <header><div><h4>Физическая вместимость полного рейса</h4><p>Указывается в абстрактных единицах груза. Для смешанного маршрута действует минимальная вместимость его участков; коэффициент транспортной компании умножает этот предел.</p></div></header>
          <div class="fbls-economy-form-grid three">
            <label class="fbls-field"><span>Караван, ед.</span><input type="number" min="1" step="1" value="{{settings.caravanCapacityLoad}}" data-type="number" data-economy-field="caravanCapacityLoad" data-scope="settings" /></label>
            <label class="fbls-field"><span>Железная дорога, ед.</span><input type="number" min="1" step="1" value="{{settings.railCapacityLoad}}" data-type="number" data-economy-field="railCapacityLoad" data-scope="settings" /></label>
            <label class="fbls-field"><span>Воздушный корабль, ед.</span><input type="number" min="1" step="1" value="{{settings.airshipCapacityLoad}}" data-type="number" data-economy-field="airshipCapacityLoad" data-scope="settings" /></label>
          </div>
        </section>
        <section class="fbls-economy-card">
          <header><div><h4>Размеры рынков-локаций</h4><p>Размер ограничивает редкость доступных товаров и меняет объём запаса.</p></div>{{#if canEdit}}<button type="button" class="fbls-button compact" data-action="market-economy-add" data-kind="size"><i class="fa-solid fa-plus"></i> Размер</button>{{/if}}</header>
          <div class="fbls-economy-system-grid">
            {{#each sizeProfiles}}<article class="{{#unless active}}is-disabled{{/unless}}" data-economy-card><header><label class="fbls-economy-check"><input type="checkbox" aria-label="Включить строку {{id}}" data-type="checkbox" data-economy-field="active" data-scope="size" data-row-id="{{id}}" {{#if active}}checked{{/if}} /><span></span></label><input type="text" value="{{label}}" data-economy-field="label" data-scope="size" data-row-id="{{id}}" /><button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="size" data-row-id="{{id}}" aria-label="Удалить размер рынка {{label}}"><i class="fa-solid fa-trash"></i></button></header><label class="fbls-field"><span>Максимальная редкость</span><select data-economy-field="maxUbiquity" data-scope="size" data-row-id="{{id}}">{{#each ubiquityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><div><label class="fbls-field"><span>Запас</span><input type="number" step="0.05" value="{{stockFactor}}" data-type="number" data-economy-field="stockFactor" data-scope="size" data-row-id="{{id}}" /></label><label class="fbls-field"><span>Цена</span><input type="number" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="size" data-row-id="{{id}}" /></label><label class="fbls-field"><span>Обработка</span><input type="number" step="0.05" value="{{handlingFactor}}" data-type="number" data-economy-field="handlingFactor" data-scope="size" data-row-id="{{id}}" /></label></div><textarea rows="2" data-economy-field="description" data-scope="size" data-row-id="{{id}}">{{description}}</textarea></article>{{/each}}
          </div>
        </section>
        <section class="fbls-economy-card">
          <header><div><h4>Состояния государств и локаций</h4><p>Шаблоны временных условий: процветание, война, разруха, блокада, урожай и другие кампанийные изменения.</p></div>{{#if canEdit}}<button type="button" class="fbls-button compact" data-action="market-economy-add" data-kind="condition"><i class="fa-solid fa-plus"></i> Состояние</button>{{/if}}</header>
          <div class="fbls-economy-condition-list">
            {{#each conditions}}<article class="{{#unless active}}is-disabled{{/unless}}" data-economy-card><label class="fbls-economy-check"><input type="checkbox" aria-label="Включить строку {{id}}" data-type="checkbox" data-economy-field="active" data-scope="condition" data-row-id="{{id}}" {{#if active}}checked{{/if}} /><span></span></label><div><input type="text" value="{{label}}" data-economy-field="label" data-scope="condition" data-row-id="{{id}}" /><small>{{id}}</small></div><label class="fbls-field"><span>Цена</span><input type="number" step="0.05" value="{{priceFactor}}" data-type="number" data-economy-field="priceFactor" data-scope="condition" data-row-id="{{id}}" /></label><label class="fbls-field"><span>Запас</span><input type="number" step="0.05" value="{{stockFactor}}" data-type="number" data-economy-field="stockFactor" data-scope="condition" data-row-id="{{id}}" /></label><label class="fbls-field"><span>Доставка</span><input type="number" step="0.05" value="{{deliveryFactor}}" data-type="number" data-economy-field="deliveryFactor" data-scope="condition" data-row-id="{{id}}" /></label><label class="fbls-field"><span>Время</span><input type="number" step="0.05" value="{{timeFactor}}" data-type="number" data-economy-field="timeFactor" data-scope="condition" data-row-id="{{id}}" /></label><label class="fbls-field"><span>Риск</span><input type="number" step="0.05" value="{{riskFactor}}" data-type="number" data-economy-field="riskFactor" data-scope="condition" data-row-id="{{id}}" /></label><button type="button" class="fbls-icon-button danger" data-action="market-economy-delete" data-kind="condition" data-row-id="{{id}}" aria-label="Удалить состояние {{label}}"><i class="fa-solid fa-trash"></i></button></article>{{/each}}
          </div>
        </section>
      </section>
    {{/if}}
  </div>
</section>
