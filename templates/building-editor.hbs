        {{> "modules/fbl-skyhold/templates/parts/building-editor/projects.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/production.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/agriculture.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/livestock.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/income.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/defense.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/housing.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/storage.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/culture.hbs"}}
        {{> "modules/fbl-skyhold/templates/parts/building-editor/text.hbs"}}
      </section>
  {{else}}
