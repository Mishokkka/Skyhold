<div class="fbls-body-text fbls-resource-row-editor-shell">
  {{#if resource}}
    <header class="fbls-resource-row-editor-hero">
      <div class="fbls-resource-editor-preview large">{{#if resource.img}}<img src="{{resource.img}}" alt="" data-fbls-image-fallback /><i class="{{resource.icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{resource.icon}}"></i>{{/if}}</div>
      <div><h2 class="fbls-heading-title">{{resource.label}}</h2><p>{{resource.id}} · {{resource.category}}</p></div>
      {{#if resource.isBuiltin}}<button type="button" class="fbls-button fbls-button-role compact" data-action="resource-restore"><i class="fa-solid fa-rotate-left"></i> По умолчанию</button>{{else}}<button type="button" class="fbls-button fbls-button-role compact danger" data-action="resource-delete"><i class="fa-solid fa-trash"></i> Удалить</button>{{/if}}
    </header>
    <main class="fbls-resource-row-editor-fields">
      <label class="fbls-field"><span>ID</span><input class="fbls-control" type="text" data-resource-field="id" value="{{resource.id}}" {{#if resource.isBuiltin}}readonly{{/if}} /></label>
      <label class="fbls-field"><span>Название</span><input class="fbls-control" type="text" data-resource-field="label" value="{{resource.label}}" /></label>
      <label class="fbls-field"><span>Единица</span><input class="fbls-control" type="text" value="{{resource.unit}}" readonly aria-label="Абстрактная единица ресурса" /><small>Ресурсы учитываются в абстрактных единицах.</small></label>
      <label class="fbls-field"><span>Раздел каталога</span><input class="fbls-control" type="text" data-resource-field="category" value="{{resource.category}}" /><small>Только для группировки и поиска.</small></label>
      <label class="fbls-field"><span>Тег категории</span><input class="fbls-control" type="text" data-resource-field="categoryTag" value="{{resource.categoryTag}}" placeholder="fuel" /><small>Ровно один точный тег для общих рецептов.</small></label>
      <label class="fbls-field"><span>Базовая цена, ММ</span><input class="fbls-control" type="number" min="0" step="1" data-type="number" data-resource-field="basePriceCopper" value="{{resource.basePriceCopper}}" /><small>{{resource.priceText}} за единицу.</small></label>
      <label class="fbls-field"><span>Пункты нагрузки</span><input class="fbls-control" type="number" min="0" step="1" data-type="number" data-resource-field="loadPoints" value="{{resource.loadPoints}}" /><small>1 пункт = 0,25; сейчас {{resource.loadValueText}}.</small></label>
      <label class="fbls-field"><span>Срок хранения, QD</span><input class="fbls-control" type="number" min="0" step="1" data-type="number" data-resource-field="shelfLifeQd" value="{{resource.shelfLifeQd}}" /><small>0 — ресурс не портится.</small></label>
      <label class="fbls-field wide"><span>Font Awesome icon</span><div class="fbls-resource-editor-inline"><i class="{{resource.icon}}"></i><input class="fbls-control" type="text" data-resource-field="icon" value="{{resource.icon}}" /></div></label>
      <label class="fbls-field wide"><span>Изображение</span><div class="fbls-resource-editor-inline"><input class="fbls-control" type="text" data-resource-field="img" value="{{resource.img}}" placeholder="icons/...webp" /><button type="button" class="fbls-icon-button" data-action="resource-pick-image" title="Выбрать изображение" aria-label="Выбрать изображение ресурса"><i class="fa-solid fa-folder-open"></i></button></div></label>
      <label class="fbls-field wide"><span>Алиасы</span><textarea class="fbls-control" rows="2" data-resource-field="aliases">{{resource.aliasesText}}</textarea></label>
      <label class="fbls-field wide"><span>Рыночные теги</span><textarea class="fbls-control" rows="2" data-resource-field="marketTags" placeholder="grain, shipbuilding, luxury">{{resource.marketTagsText}}</textarea><small>Специализации рынка используют эти теги, чтобы автоматически добавлять подходящие товары поверх базового ассортимента.</small></label>
      <label class="fbls-field wide"><span>Item UUID</span><input class="fbls-control" type="text" data-resource-field="itemUuid" value="{{resource.itemUuid}}" /></label>
      <label class="fbls-field"><span>Item type</span><input class="fbls-control" type="text" data-resource-field="itemType" value="{{resource.itemType}}" /></label>
      <label class="fbls-field"><span>Срок хранения, QD</span><input class="fbls-control" type="number" min="0" step="1" data-type="number" data-resource-field="shelfLifeQd" value="{{resource.shelfLifeQd}}" /><small>0 — не портится автоматически; 4 QD = 1 день.</small></label>
      <label class="fbls-field"><span>Тип готовой еды</span><select class="fbls-control" data-resource-field="foodType">{{#each resource.foodTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><small>Учитывается только для съедобного ресурса.</small></label>
      <label class="fbls-field"><span data-fbls-tooltip="Сложность доступа именно к этому товару. Итоговое требование равно числу переходов до рынка плюс это значение.">УРС товара</span><input class="fbls-control" type="number" min="0" max="100" step="1" data-type="number" data-resource-field="marketAccessDifficulty" value="{{resource.marketAccessDifficulty}}" /><small>0 — обычный товар; 4 — стратегический или строго лицензируемый.</small></label>
      {{#if resource.hasLegacyFields}}<p class="wide fbls-resource-editor-help"><strong>Сохранены старые данные:</strong> {{resource.legacyFieldsText}}. Они не редактируются и не заменяют поля выше.</p>{{/if}}
      {{#if resource.unitExplanation}}<p class="fbls-field wide">{{resource.unitExplanation}}</p>{{/if}}
      <label class="fbls-field wide"><span>Примечания и источник</span><textarea class="fbls-control" rows="4" data-resource-field="notes">{{resource.notes}}</textarea></label>
    </main>
    <footer class="fbls-resource-row-editor-flags">
      <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Производство"><input type="checkbox" data-type="checkbox" data-resource-field="useInProduction" {{#if resource.useInProduction}}checked{{/if}} /><span>Производство</span></label>
      <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Строительство"><input type="checkbox" data-type="checkbox" data-resource-field="useInConstruction" {{#if resource.useInConstruction}}checked{{/if}} /><span>Строительство</span></label>
      <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Готовая еда"><input type="checkbox" data-type="checkbox" data-resource-field="foodEdible" {{#if resource.foodEdible}}checked{{/if}} /><span>Готовая еда</span></label>
      <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Не тратить автоматически"><input type="checkbox" data-type="checkbox" data-resource-field="noAutoConsume" {{#if resource.noAutoConsume}}checked{{/if}} /><span>Без автотрат</span></label>
      <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Скрыт"><input type="checkbox" data-type="checkbox" data-resource-field="hidden" {{#if resource.hidden}}checked{{/if}} /><span>Скрыт</span></label>
    </footer>
  {{else}}<p class="fbls-empty">Ресурс больше не найден.</p>{{/if}}
</div>
