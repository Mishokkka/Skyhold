{{#if active.externalMarket}}
  <section class="fbls-panel fbls-external-market-panel" aria-label="Внешний рынок">
    {{> "modules/fbl-skyhold/templates/parts/storage/market.hbs"}}
    <article class="fbls-card" aria-label="Банки поселения">
      <div class="fbls-card-header fbls-cluster">
        <div>
          <h3 class="fbls-heading-section"><i class="fa-solid fa-landmark" aria-hidden="true"></i> Банки</h3>
          <p class="fbls-muted-text">Подберите заём, разместите резерв на хранение или откройте срочный вклад. Здесь же — платежи и действующие договоры поселения.</p>
        </div>
        <button type="button" class="fbls-button primary" data-action="open-banks"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Открыть банки</button>
      </div>
    </article>
    {{> "modules/fbl-skyhold/templates/parts/skyhold-ships.hbs"}}
  </section>
{{/if}}
