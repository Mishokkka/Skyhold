<div class="fbls-person-editor v2">
  <fieldset class="main-set compact-resident-main">
    <legend>Основное</legend>
    <div class="fbls-resident-main-grid">
      <label class="person-name">
        <span>Имя</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.name" value="{{name}}" />
      </label>
      <label class="person-sex">
        <span>Пол</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.sex" value="{{sex}}" />
      </label>
      <label class="num-field person-age">
        <span>Возраст</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.age" value="{{age}}" min="0" />
      </label>
      <div class="fbls-derived-mini person-category">
        <span>Кат.</span>
        <strong>{{ageGroup}}</strong>
      </div>
      <label class="person-culture">
        <span>Культура</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.culture">
          {{#each cultureOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="person-belief">
        <span>Верование</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.belief">
          {{#each beliefOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="person-race">
        <span>Раса</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.race" value="{{race}}" />
      </label>
      <label class="person-subrace">
        <span>Подвид</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.subrace" value="{{subrace}}" />
      </label>
      <label class="num-field person-injured">
        <span>Ранен</span>
        <input type="number" min="0" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.injuredDays" value="{{injuredDays}}" />
      </label>
      <label class="person-appearance">
        <span>Внешность</span>
        <textarea data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.appearance" rows="1">{{appearance}}</textarea>
      </label>
      {{#if dead}}
        <label class="person-death-date">
          <span>Дата гибели</span>
          <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.deathDate" value="{{deathDate}}" />
        </label>
        <label class="person-death-note wide">
          <span>Причина гибели</span>
          <textarea data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.deathNote" rows="2">{{deathNote}}</textarea>
        </label>
      {{/if}}
    </div>
  </fieldset>

  <fieldset class="work-set compact-resident-work {{#if isCustomWork}}has-custom-work{{/if}}">
    <legend>Работа и жилье</legend>
    {{#if onBoardOnly}}<div class="fbls-resident-ship-status" tabindex="0" data-fbls-tooltip="{{#if restingOnShip}}Отдыхает на борту, не занимает дом и не участвует в довольстве поселения. Для назначения работы нажмите «В поселение» в списке «Жители → Экипажи». Вернуть моряка можно через контекстное меню.{{else}}Находится в рейсе. Работа и жильё поселения недоступны до возвращения корабля.{{/if}}"><i class="fa-solid fa-ship" aria-hidden="true"></i><span>{{homeLabel}} · {{#if restingOnShip}}отдыхает на борту{{else}}в рейсе{{/if}}</span><i class="fa-solid fa-circle-info" aria-hidden="true"></i></div>{{/if}}
    <div class="fbls-work-block fbls-work-source-block">
      <label class="person-work">
        <span>Работа</span>
        <select data-work-assignment-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.workAssignment" {{#if onBoardOnly}}disabled{{/if}}>
          {{#each workOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="num-field person-salary">
        <span data-fbls-tooltip="Пусто — использовать дневную ставку рабочего места. Число полностью заменяет её.">Своя ставка</span>
        <input type="number" min="0" step="1" data-type="nullable-number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.wageDailyOverrideCopper" value="{{wageDailyOverrideCopper}}" placeholder="по месту" />
      </label>
      <label class="person-volunteer fbls-volunteer-toggle fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Добровольный труд не создаёт зарплатное обязательство. Галочки достаточно; соседняя заметка необязательна."><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.volunteerLabor" aria-label="Добровольный труд без оплаты" {{#if volunteerLabor}}checked{{/if}} /><span>Без з/п</span></label>
      <label class="person-volunteer-reason">
        <span>Заметка</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.volunteerReason" value="{{volunteerReason}}" placeholder="необязательно: почему труд бесплатный" />
      </label>
      <label class="person-custom-role {{#unless isCustomWork}}is-hidden{{/unless}}">
        <span>Особая работа</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.role" value="{{role}}" />
      </label>
    </div>
    <div class="fbls-work-block fbls-work-home-block">
      <label class="person-home">
        <span>Место жительства</span>
        {{#if onBoardOnly}}<span class="fbls-resident-ship-home">{{homeLabel}}</span>{{else}}
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.home">
          {{#each homeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        {{/if}}
      </label>
      <label class="num-field person-maintenance-points">
        <span data-fbls-tooltip="Целые очки трудового обслуживания за десятник. 0 означает, что этот житель их не создаёт; значение задаётся явно и не переносится между десятниками.">Очки обслуж.</span>
        <input type="number" min="0" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.maintenancePointsPerTenday" value="{{maintenancePointsPerTenday}}" />
      </label>
    </div>
    <div class="fbls-work-block fbls-work-background-block">
      <label class="person-background">
        <span>Социальное прошлое</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.background">
          {{#each backgroundOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
  </fieldset>

  <fieldset class="fbls-work-allocation-set {{#if workAllocationExplicit}}is-explicit{{else}}is-legacy{{/if}}" {{#if onBoardOnly}}disabled{{/if}}>
    <legend>План труда на десятник</legend>
    <div class="fbls-work-allocation-toolbar">
      <label class="fbls-field fbls-work-allocation-mode">
        <span data-fbls-tooltip="Основное назначение сохраняет прежнее поведение. Явный план позволяет разделить 20 обычных QD и до 10 overtime-QD между функциями; один QD принадлежит только одной строке.">Режим</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.workAllocationMode">
          {{#each workAllocationModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <div class="fbls-work-allocation-total-field">
        <span>Выделено</span>
        <strong class="fbls-work-allocation-total {{#unless workAllocationValid}}has-warning{{/unless}}" data-fbls-tooltip="{{workAllocationIssueText}}">{{workAllocationNormalQd}}/{{workAllocationNormalCap}} QD + {{workAllocationOvertimeQd}}/{{workAllocationOvertimeCap}} OT</strong>
      </div>
      <button type="button" class="fbls-button compact" data-action="add-work-allocation" data-person-id="{{id}}" aria-label="Добавить строку рабочего плана">
        <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Функция</span>
      </button>
    </div>
    {{#if workAllocations.length}}
      <div class="fbls-work-allocation-rows">
        {{#each workAllocations}}
          <div class="fbls-work-allocation-row">
            <label class="fbls-field fbls-work-allocation-target">
              <span>Здание и функция</span>
              <select data-work-allocation-target data-allocation-index="{{_index}}" aria-label="Рабочая функция">
                {{#each targetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            <label class="fbls-field fbls-work-allocation-qd">
              <span>Обычн. QD</span>
              <input type="number" min="0" max="20" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{../_index}}.workAllocations.{{_index}}.normalQd" value="{{normalQd}}" />
            </label>
            <label class="fbls-field fbls-work-allocation-qd">
              <span data-fbls-tooltip="Overtime разрешён только функциям с включённой переработкой. Каждый OT-QD стоит полную дневную ставку.">OT QD</span>
              <input type="number" min="0" max="10" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{../_index}}.workAllocations.{{_index}}.overtimeQd" value="{{overtimeQd}}" />
            </label>
            <button type="button" class="fbls-button compact icon-only danger" data-action="remove-work-allocation" data-person-id="{{../id}}" data-allocation-id="{{id}}" title="Убрать функцию" aria-label="Убрать функцию из рабочего плана">
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
            <div class="fbls-work-allocation-contract fbls-cluster">
              <label class="fbls-checkbox-label"><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{../_index}}.workAllocations.{{_index}}.volunteer" {{#if volunteer}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}} /><span>Эта работа без оплаты</span></label>
              <label class="fbls-field"><span>Основание договорённости</span><input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{../_index}}.workAllocations.{{_index}}.volunteerReason" value="{{volunteerReason}}" placeholder="Например: долг за спасение" {{#unless @root.isGM}}disabled{{/unless}} /></label>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="fbls-muted-text">Строк нет. В явном режиме житель без выделенных QD не работает и не получает зарплату.</p>
    {{/if}}
  </fieldset>

  <div class="fbls-resident-midline">
    <fieldset class="stat-set compact-set">
      <legend>Характеристики</legend>
      <label class="num-field">
        <span>Сила</span>
        <input type="number" min="1" max="6" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.strength" value="{{attributes.strength}}" />
      </label>
      <label class="num-field">
        <span>Ловк.</span>
        <input type="number" min="1" max="6" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.agility" value="{{attributes.agility}}" />
      </label>
      <label class="num-field">
        <span>Разум</span>
        <input type="number" min="1" max="6" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.wits" value="{{attributes.wits}}" />
      </label>
      <label class="num-field">
        <span>Эмп.</span>
        <input type="number" min="1" max="6" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.empathy" value="{{attributes.empathy}}" />
      </label>
    </fieldset>

    <fieldset class="morale-set compact-set">
      <legend>Довольство</legend>
      <label class="num-field">
        <span>База</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleBase" value="{{moraleBase}}" />
      </label>
      <label class="num-field">
        <span>Раб.</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleWork" value="{{moraleWork}}" />
      </label>
      <label class="num-field">
        <span>Дом</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleHome" value="{{moraleHome}}" />
      </label>
      <label class="num-field">
        <span>Ручн.</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleManual" value="{{moraleManual}}" />
      </label>
      <div class="fbls-derived-box" data-fbls-tooltip="{{moraleTooltip}}">
        <span>Итог</span>
        <strong>{{moraleValue}}</strong>
      </div>
    </fieldset>

    <fieldset class="traits-set compact-set">
      <legend>Черты</legend>
      <div class="fbls-trait-editor" data-resident-trait-editor>
        <input type="hidden" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.traitsText" value="{{traitsText}}" data-resident-traits-value />
        <div class="fbls-trait-control-row">
          <div class="fbls-trait-current fbls-field">
            <span class="fbls-field-title">Выбрано</span>
            <details class="fbls-selection-field" data-fbls-disclosure="resident-traits-{{id}}">
              <summary data-selection-summary data-fbls-tooltip="{{traitSelection.tooltip}}" aria-label="Выбранные черты: {{traitSelection.tooltip}}"><span data-selection-label>{{traitSelection.first}}</span><small data-selection-count {{#unless traitSelection.additional}}hidden{{/unless}}>+{{traitSelection.additional}}</small><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            <div class="fbls-selected-traits" data-resident-trait-list>
              {{#if hasTraitBadges}}
                {{#each traitBadges}}
                  <span class="fbls-trait-badge editor-chip fbls-note-tip" data-fbls-tooltip="{{tooltip}}">
                    {{name}}
                    <button type="button" class="fbls-chip-remove" data-action="remove-trait" data-traits-field="holdings.{{@root.holdingIndex}}.people.list.{{../_index}}.traitsText" data-trait-name="{{name}}" title="Убрать черту" aria-label="Убрать черту {{name}}">×</button>
                  </span>
                {{/each}}
              {{else}}
                <span class="fbls-muted-text">Черт нет.</span>
              {{/if}}
            </div>
            </details>
          </div>
          <label class="fbls-trait-add-field fbls-field">
            <span>Добавить</span>
            <select class="fbls-control fbls-trait-picker fbls-trait-add-compact" data-trait-add-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.traitsText" aria-label="Добавить черту">
              <option value="">Выберите черту</option>
              {{#each traitOptions}}
                <option value="{{name}}" title="{{description}}" {{#if selected}}disabled{{/if}}>{{name}}{{#if selected}} ✓{{/if}}</option>
              {{/each}}
            </select>
          </label>
        </div>
      </div>
    </fieldset>
  </div>

  <fieldset class="fbls-resident-notes-set">
    <legend>Заметки</legend>
    <textarea class="fbls-person-notes-field" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.notes" rows="3" placeholder="Связи, обязанности, договорённости и всё важное для игры">{{notes}}</textarea>
  </fieldset>

  <div class="resident-actions">
    <span class="fbls-muted-text">Изменения сохраняются при выходе из поля.</span>
    <button type="button" class="fbls-button compact primary" data-action="close-person-editor"><i class="fa-solid fa-check" aria-hidden="true"></i>Готово</button>
  </div>
</div>
