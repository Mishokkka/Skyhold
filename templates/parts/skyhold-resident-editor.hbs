<div class="fbls-person-editor v2">
  <fieldset class="main-set compact-resident-main">
    <legend>Основное</legend>
    <div class="fbls-resident-main-grid">
      <label class="person-name">
        <span>Имя</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.name" value="{{name}}" />
      </label>
      <label class="person-sex">
        <span>Пол</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.sex" value="{{sex}}" />
      </label>
      <label class="num-field person-age">
        <span>Возраст</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.age" value="{{age}}" min="0" />
      </label>
      <div class="fbls-derived-mini person-category">
        <span>Кат.</span>
        <strong>{{ageGroup}}</strong>
      </div>
      <label class="person-culture">
        <span>Культура</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.culture">
          {{#each cultureOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="person-belief">
        <span>Верование</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.belief">
          {{#each beliefOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="person-race">
        <span>Раса</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.race" value="{{race}}" />
      </label>
      <label class="person-subrace">
        <span>Подвид</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.subrace" value="{{subrace}}" />
      </label>
      <label class="num-field person-injured">
        <span>Ранен</span>
        <input type="number" min="0" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.injuredDays" value="{{injuredDays}}" />
      </label>
      <label class="person-appearance">
        <span>Внешность</span>
        <textarea data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.appearance" rows="1">{{appearance}}</textarea>
      </label>
      {{#if dead}}
        <label class="person-death-date">
          <span>Дата гибели</span>
          <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.deathDate" value="{{deathDate}}" />
        </label>
        <label class="person-death-note wide">
          <span>Причина гибели</span>
          <textarea data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.deathNote" rows="2">{{deathNote}}</textarea>
        </label>
      {{/if}}
    </div>
  </fieldset>

  <fieldset class="work-set compact-resident-work {{#if isCustomWork}}has-custom-work{{/if}}">
    <legend>Работа, договор и жильё</legend>
    <div class="fbls-work-block fbls-work-source-block">
      <label class="person-work">
        <span>Работа</span>
        <select data-work-assignment-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.workAssignment">
          {{#each workOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="person-custom-role {{#unless isCustomWork}}is-hidden{{/unless}}">
        <span>Особая работа</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.role" value="{{role}}" />
      </label>
    </div>
    <div class="fbls-work-block fbls-work-home-block">
      <label class="person-home">
        <span>Место жительства</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.home">
          {{#each homeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="fbls-work-block fbls-work-background-block">
      <label class="person-background">
        <span>Социальное прошлое</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.background">
          {{#each backgroundOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="fbls-work-block fbls-work-contract-block">
      <label class="person-compensation-type">
        <span>Договор</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.compensationType">{{#each compensationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      <label class="num-field person-cash-wage">
        <span>Старая ставка / день</span>
        <input type="number" min="0" step="0.01" data-type="number" data-legacy-wage-alias="true" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.cashWageDaily" value="{{cashWageDaily}}" readonly title="Сохранено для совместимости. Economy V2 начисляет оплату по классу труда за десятник." />
      </label>
      <label class="num-field person-base-wage">
        <span>Расчётная ставка</span>
        <input type="text" value="{{baseWageDailyText}}" readonly title="Ставка текущей работы с учётом модификатора. Автоматически становится денежной выплатой только для двух наёмных типов договора." />
      </label>
      <label class="num-field person-salary-mod">
        <span>Мод. ставки</span>
        <input type="number" step="0.01" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.salaryModifier" value="{{salaryModifier}}" title="Добавляется к расчётной ставке работы. Тип договора и ручные условия не меняются." />
      </label>
      <label class="person-board-food">
        <span>Пропитание</span>
        <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.foodProvisionMode" title="Общий склад выдаёт ровно один паёк в день либо житель полностью обеспечивает себя сам.">{{#each foodProvisionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      <label class="num-field person-share-rate">
        <span>Доля результата</span>
        <input type="number" min="0" max="1" step="0.01" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.shareRate" value="{{shareRate}}" title="0,10 означает 10% денежного дохода назначенного здания." />
      </label>
      <label class="person-housing-provided fbls-inline-check"><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.housingProvided" {{#if housingProvided}}checked{{/if}} /><span>Жильё входит в договор</span></label>
      <div class="fbls-employment-v2">
        <div class="fbls-employment-v2-title">
          <strong>Оплата труда Economy V2</strong>
          <span>Индекс {{wageIndexText}} · тариф {{employmentTariffText}} / десятник</span>
        </div>
        <label class="person-wage-class">
          <span>Класс труда</span>
          <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.wageClassId">{{#each wageClassOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </label>
        <label class="person-employment-mode">
          <span>Режим найма</span>
          <select data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentMode">{{#each employmentModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </label>
        <label class="num-field person-contract-start">
          <span>Начало, QD</span>
          <input type="number" min="0" step="1" data-type="optional-number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentContractStartQd" value="{{employmentContractStartQdValue}}" placeholder="без границы" />
        </label>
        <label class="num-field person-contract-end">
          <span>Конец, QD</span>
          <input type="number" min="0" step="1" data-type="optional-number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentContractEndQd" value="{{employmentContractEndQdValue}}" placeholder="без границы" />
        </label>
        <fieldset class="fbls-employment-seasons">
          <legend>Сезоны</legend>
          <label class="fbls-inline-check"><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentSeasonMask.spring" {{#if employmentSeasonMask.spring}}checked{{/if}} /><span>Весна</span></label>
          <label class="fbls-inline-check"><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentSeasonMask.summer" {{#if employmentSeasonMask.summer}}checked{{/if}} /><span>Лето</span></label>
          <label class="fbls-inline-check"><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentSeasonMask.autumn" {{#if employmentSeasonMask.autumn}}checked{{/if}} /><span>Осень</span></label>
          <label class="fbls-inline-check"><input type="checkbox" data-type="checkbox" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.employmentSeasonMask.winter" {{#if employmentSeasonMask.winter}}checked{{/if}} /><span>Зима</span></label>
        </fieldset>
        <div class="fbls-employment-payroll-status {{#if hasPayrollArrears}}has-arrears{{/if}}">
          <span>Личный долг</span>
          <strong>{{payrollArrearsText}}</strong>
          {{#if hasPayrollArrears}}<small>просрочка: {{payrollOverdueTendays}} дес.</small>{{else}}<small>задолженности нет</small>{{/if}}
        </div>
        {{#if isVolunteerContract}}
          <label class="fbls-field-wide person-volunteer-reason">
            <span>Причина добровольной работы</span>
            <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.volunteerReason" value="{{volunteerReason}}" placeholder="Общий урожай, взаимопомощь, личное обещание…" />
          </label>
          <label class="num-field person-volunteer-start">
            <span>Добровольно с, QD</span>
            <input type="number" min="0" step="1" data-type="optional-number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.volunteerTermStartQd" value="{{volunteerTermStartQdValue}}" placeholder="обязательно" />
          </label>
          <label class="num-field person-volunteer-end">
            <span>Добровольно до, QD</span>
            <input type="number" min="0" step="1" data-type="optional-number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.volunteerTermEndQd" value="{{volunteerTermEndQdValue}}" placeholder="обязательно" />
          </label>
        {{/if}}
        {{#if isCoercedContract}}
          <label class="fbls-field-wide person-coercion-basis">
            <span>Основание принудительного труда</span>
            <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.coercionBasis" value="{{coercionBasis}}" placeholder="Приговор, долговая повинность, военная обязанность…" />
          </label>
        {{/if}}
        <label class="num-field person-hunger-streak">
          <span>Голод подряд, дес.</span>
          {{#if @root.canEdit}}
            <input type="number" min="0" step="1" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.hungerStreakTendays" value="{{hungerStreakTendays}}" title="Текущее сохранённое состояние. Пока автоматическое распределение голода не введено, счётчик изменяет только ГМ." />
          {{else}}
            <input type="number" min="0" step="1" value="{{hungerStreakTendays}}" readonly aria-label="Голод подряд, десятников: {{hungerStreakTendays}}" title="Системное состояние, доступное игроку только для чтения." />
          {{/if}}
        </label>
        <div class="fbls-labor-projection fbls-field-wide {{laborProjectionClass}}" aria-label="Прогноз труда на следующий десятник">
          <div class="fbls-employment-v2-title">
            <strong>Следующий десятник · QD {{laborProjectionQd}}</strong>
            <span title="Стабильное состояние: {{laborContractStateId}}">{{laborContractStateText}}</span>
          </div>
          <div class="fbls-cluster">
            <span class="fbls-chip {{laborProjectionBadgeClass}}">Труд {{laborProjectionFactorText}}</span>
            <span class="fbls-chip">Довольство {{laborProjectionMoraleText}}</span>
            <span class="fbls-chip">Сезон: {{laborProjectionSeasonText}}</span>
            <span class="fbls-chip">{{laborAssignmentText}}</span>
          </div>
          <p class="fbls-muted-text compact">{{laborArrearsStepText}}</p>
          <p class="fbls-muted-text compact">{{laborHungerStepText}} Сохранённая серия: {{hungerStreakTendays}} дес.</p>
          {{#if hasLaborProjectionBlockers}}
            <ul class="fbls-labor-projection-list blockers">
              {{#each laborProjectionBlockers}}<li>{{message}}</li>{{/each}}
            </ul>
          {{/if}}
          {{#if hasLaborProjectionRisks}}
            <ul class="fbls-labor-projection-list risks">
              {{#each laborProjectionRisks}}<li>{{description}}</li>{{/each}}
            </ul>
          {{/if}}
          <p class="fbls-muted-text compact">Это проекция чистых правил по сохранённому состоянию; события и голод автоматически не создаются.</p>
        </div>
        <p class="fbls-muted-text compact">Пустой класс труда сохраняет старый договор, но не создаёт бесплатный труд или обязательство Economy V2.</p>
      </div>
      <label class="person-compensation-note">
        <span>Основание и условия</span>
        <input type="text" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.compensationNote" value="{{compensationNote}}" placeholder="Почему ставка нулевая, как считается доля, что входит в пансион…" />
      </label>
      {{#if hasCompensationWarning}}<p class="fbls-compensation-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{compensationWarning}}</p>{{/if}}
    </div>
  </fieldset>

  <div class="fbls-resident-midline">
    <fieldset class="stat-set compact-set">
      <legend>Характеристики</legend>
      <label class="num-field">
        <span>Сила</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.strength" value="{{attributes.strength}}" />
      </label>
      <label class="num-field">
        <span>Ловк.</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.agility" value="{{attributes.agility}}" />
      </label>
      <label class="num-field">
        <span>Разум</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.wits" value="{{attributes.wits}}" />
      </label>
      <label class="num-field">
        <span>Эмп.</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.attributes.empathy" value="{{attributes.empathy}}" />
      </label>
    </fieldset>

    <fieldset class="morale-set compact-set">
      <legend>Довольство</legend>
      <label class="num-field">
        <span>База</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleBase" value="{{moraleBase}}" />
      </label>
      <label class="num-field">
        <span>Раб.</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleWork" value="{{moraleWork}}" />
      </label>
      <label class="num-field">
        <span>Дом</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleHome" value="{{moraleHome}}" />
      </label>
      <label class="num-field">
        <span>Ручн.</span>
        <input type="number" data-type="number" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.moraleManual" value="{{moraleManual}}" />
      </label>
      <div class="fbls-derived-box">
        <span>Итог</span>
        <strong>{{moraleValue}}</strong>
        <em>{{moraleTooltip}}</em>
      </div>
    </fieldset>

    <fieldset class="traits-set compact-set">
      <legend>Черты</legend>
      <div class="fbls-trait-editor" data-resident-trait-editor>
        <input type="hidden" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.traitsText" value="{{traitsText}}" data-resident-traits-value />
        <div class="fbls-trait-control-row">
          <div class="fbls-selected-traits" data-resident-trait-list>
            {{#if hasTraitBadges}}
              {{#each traitBadges}}
                <span class="fbls-trait-badge editor-chip fbls-note-tip" data-fbls-tooltip="{{description}}">
                  {{name}}
            <button type="button" class="fbls-chip-remove" data-action="remove-trait" data-traits-field="holdings.{{@root.holdingIndex}}.people.list.{{../_index}}.traitsText" data-trait-name="{{name}}" title="Убрать черту" aria-label="Убрать черту {{name}}">×</button>
                </span>
              {{/each}}
            {{else}}
              <span class="fbls-muted-text">Черт нет.</span>
            {{/if}}
          </div>
          <span class="fbls-trait-add-shell" title="Добавить черту">
            <span class="fbls-trait-add-icon" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
            <select class="fbls-trait-picker fbls-trait-add-compact" data-trait-add-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.traitsText" aria-label="Добавить черту">
              <option value="">+</option>
              {{#each traitOptions}}
                <option value="{{name}}" title="{{description}}" {{#if selected}}disabled{{/if}}>{{name}}{{#if selected}} ✓{{/if}}</option>
              {{/each}}
            </select>
          </span>
        </div>
      </div>
    </fieldset>
  </div>

  <textarea class="fbls-person-notes-field" data-field="holdings.{{@root.holdingIndex}}.people.list.{{_index}}.notes" rows="3" placeholder="Заметки">{{notes}}</textarea>

  <div class="resident-actions">
    <button type="button" class="fbls-button compact" data-action="close-person-editor">Готово</button>
  </div>
</div>
