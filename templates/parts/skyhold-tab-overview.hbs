    {{#if active.overview}}
      <section class="fbls-panel fbls-overview compact">
        <article class="fbls-card fbls-tenday-readiness {{#if tendayReadiness.ready}}is-ready{{else}}needs-attention{{/if}}">
          <header><div><h2><i class="fa-solid fa-calendar-days"></i> Готовность к десятнику</h2><p>{{tendayReadiness.statusLabel}}</p></div><strong>{{tendayReadiness.foodAvailable}} / {{tendayReadiness.foodNeeded}} пищи</strong></header>
          <div class="fbls-harvest-reserve {{#if tendayReadiness.harvestReserve.sufficient}}is-sufficient{{else}}is-short{{/if}}">
            <span><i class="fa-solid fa-boxes-stacked"></i><small>Запас сейчас</small><strong>{{tendayReadiness.harvestReserve.coverageDaysText}} дн.</strong></span>
            <span><i class="fa-solid fa-seedling"></i><small>Пополнение за десятник</small><strong>+{{tendayReadiness.foodProduced}} чел.-дн.</strong></span>
            <span><i class="fa-solid fa-utensils"></i><small>Общий стол</small><strong>{{tendayReadiness.commonTable.coveredResidents}} / {{tendayReadiness.commonTable.residentCount}} жителей</strong></span>
            <span><i class="fa-solid fa-apple-whole"></i><small>Разнообразие рациона</small><strong>{{tendayReadiness.qualifyingDietGroupCount}} / 3 групп</strong></span>
            <span><i class="fa-solid fa-face-smile"></i><small>Бонус довольства</small><strong>{{#if tendayReadiness.commonTableBonusReady}}Будет +1{{else}}Нужны сытость, 3 группы и места{{/if}}</strong></span>
            {{#if tendayReadiness.harvestReserve.hasHarvest}}
              <span><i class="fa-solid fa-wheat-awn"></i><small>Сезонное зерно</small><strong>{{tendayReadiness.harvestReserve.dateLabel}} · через {{tendayReadiness.harvestReserve.daysUntilText}} дн.</strong></span>
              <span><i class="fa-solid fa-shield-heart"></i><small>Надёжный резерв</small><strong>{{tendayReadiness.harvestReserve.usableText}} / {{tendayReadiness.harvestReserve.requiredText}} чел.-дн.</strong></span>
              <span><i class="fa-solid fa-box"></i><small>Первая выдача зерна</small><strong>≈ {{tendayReadiness.harvestReserve.expectedHarvestText}} чел.-дн.</strong></span>
            {{/if}}
          </div>
          {{#if tendayReadiness.alerts.length}}
            <div class="fbls-tenday-alerts">
              {{#each tendayReadiness.alerts}}<div class="fbls-tenday-alert {{severity}}"><i class="{{icon}}"></i><span><strong>{{title}}</strong><small>{{text}}</small></span></div>{{/each}}
            </div>
          {{else}}
            <p class="fbls-tenday-ready-message"><i class="fa-solid fa-circle-check"></i> Критических препятствий перед следующим десятником не найдено.</p>
          {{/if}}
        </article>
        <article class="fbls-card">
          <h2>Описание</h2>
          {{#if canEditOverview}}
            <textarea data-field="holdings.{{holdingIndex}}.overview.description" rows="4">{{holding.overview.description}}</textarea>
          {{else}}
            <p class="fbls-preline">{{holding.overview.description}}</p>
          {{/if}}
        </article>

        <div class="fbls-grid two-even compact-grid">
          <article class="fbls-card">
            <h2>Навигация / состояние</h2>
            <div class="fbls-form-grid two-fields compact-fields">
              <label><span>Регион</span>{{#if canEdit}}<select data-field="holdings.{{holdingIndex}}.overview.region">{{#each regionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{currentRegionLabel}}</strong>{{/if}}</label>
              <label><span>Высота</span>{{#if canEdit}}<input type="text" data-field="holdings.{{holdingIndex}}.overview.altitude" value="{{holding.overview.altitude}}" />{{else}}<strong>{{holding.overview.altitude}}</strong>{{/if}}</label>
              <label><span>Дрейф / курс</span>{{#if canEdit}}<input type="text" data-field="holdings.{{holdingIndex}}.overview.drift" value="{{holding.overview.drift}}" />{{else}}<strong>{{holding.overview.drift}}</strong>{{/if}}</label>
              <label><span>Механизмы</span>{{#if canEdit}}<input type="text" data-field="holdings.{{holdingIndex}}.overview.mechanisms" value="{{holding.overview.mechanisms}}" />{{else}}<strong>{{holding.overview.mechanisms}}</strong>{{/if}}</label>
              <label><span>Погода / маршрут</span>{{#if canEdit}}<input type="text" data-field="holdings.{{holdingIndex}}.overview.weather" value="{{holding.overview.weather}}" />{{else}}<strong>{{holding.overview.weather}}</strong>{{/if}}</label>
            </div>
          </article>

          <article class="fbls-card">
            <h2>Публичные заметки</h2>
            {{#if canEditOverview}}
              <textarea data-field="holdings.{{holdingIndex}}.overview.publicNotes" rows="5">{{holding.overview.publicNotes}}</textarea>
            {{else}}
              <p class="fbls-preline">{{holding.overview.publicNotes}}</p>
            {{/if}}
          </article>
        </div>

        {{#if canEdit}}
          <article class="fbls-card slim-card">
            <h2>Связь со сценой</h2>
            <input type="text" data-field="holdings.{{holdingIndex}}.linkedSceneId" value="{{holding.linkedSceneId}}" placeholder="Scene ID" />
          </article>
        {{/if}}
      </section>
    {{/if}}
