      {{#if building.showEditorIncome}}
        <fieldset class="fbls-building-editor-card wide-card income-card fbls-editor-tab-workspace tab-income">
          <legend class="fbls-editor-tab-legend">Доходность</legend>
          <header class="fbls-editor-tab-head"><i class="fa-solid fa-coins"></i><div><span>Экономика здания</span><h2>Доходность</h2><p>Фиксированный доход, платные услуги и торговая пропускная способность.</p></div><strong class="fbls-editor-head-metric"><small>За десятник</small>{{building.incomeSummary.total}}</strong></header>
          <section class="fbls-editor-tab-panel"><div class="fbls-editor-panel-head"><span><i class="fa-solid fa-sack-dollar"></i> Фиксированный доход</span><small>База, работники, формула и риск</small></div><div class="fbls-income-grid">
            <label><span>База</span>{{#if canEdit}}<input type="number" data-type="number" data-field="{{building.basePath}}.income.base" value="{{building.income.base}}" />{{else}}<strong>{{building.income.base}}</strong>{{/if}}</label>
            <label><span>За эф. работника</span>{{#if canEdit}}<input type="number" data-type="number" data-field="{{building.basePath}}.income.perWorker" value="{{building.income.perWorker}}" />{{else}}<strong>{{building.income.perWorker}}</strong>{{/if}}</label>
            <label><span>Формула</span>{{#if canEdit}}<input type="text" data-field="{{building.basePath}}.income.formula" value="{{building.income.formula}}" placeholder="1d6+@eff" />{{else}}<strong>{{building.income.formula}}</strong>{{/if}}</label>
            <label><span>Риск</span>{{#if canEdit}}<input type="number" data-type="number" data-field="{{building.basePath}}.income.risk" value="{{building.income.risk}}" />{{else}}<strong>{{building.income.risk}}</strong>{{/if}}</label>
            <label class="fbls-checkbox-label fbls-icon-check fbls-income-illegal-toggle" data-fbls-tooltip="Незаконный доход. Используется как пометка для ГМа и будущих происшествий."><span><i class="fa-solid fa-mask"></i></span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.illegal" {{#if building.income.illegal}}checked{{/if}} />{{else}}<strong>{{#if building.income.illegal}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
            <div class="fbls-result-box fbls-income-total-box" data-fbls-tooltip="Фиксированный доход = база + (за эффективного работника × итоговая эффективность здания). Формула применяется вместо фиксированной суммы."><span>Фикс. доход / десятник</span><strong>{{building.incomeSummary.total}}</strong><em>денег · {{building.workerEfficiency.total}} эф.</em></div>
          </div></section>

          <section class="fbls-trade-editor-block fbls-editor-tab-panel"><div class="fbls-editor-panel-head"><span><i class="fa-solid fa-bell-concierge"></i> Платные услуги</span><small>Спрос, мощность, расход и цена обслуживания</small></div>
            <div class="fbls-trade-grid">
              <label class="fbls-checkbox-label fbls-icon-check" data-fbls-tooltip="Включает платные услуги с явным спросом, рабочей мощностью и расходами."><span><i class="fa-solid fa-bell-concierge"></i></span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.service.enabled" {{#if building.income.service.enabled}}checked{{/if}} />{{else}}<strong>{{#if building.income.service.enabled}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Здания с одинаковым ключом делят один и тот же спрос, но разные виды услуг не конкурируют между собой.">Пул спроса</span>{{#if canEdit}}<input type="text" data-field="{{building.basePath}}.income.service.demandPool" value="{{building.income.service.demandPool}}" />{{else}}<strong>{{building.income.service.demandPool}}</strong>{{/if}}</label>
              <label><span>Название услуги</span>{{#if canEdit}}<input type="text" data-field="{{building.basePath}}.income.service.label" value="{{building.income.service.label}}" />{{else}}<strong>{{building.income.service.label}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Число платных посещений на одного жителя за десятник.">На жителя</span>{{#if canEdit}}<input type="number" min="0" step="0.05" data-type="number" data-field="{{building.basePath}}.income.service.localDemandPerResident" value="{{building.income.service.localDemandPerResident}}" />{{else}}<strong>{{building.income.service.localDemandPerResident}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Дополнительные посещения приезжих за единицу Репутации.">За Репутацию</span>{{#if canEdit}}<input type="number" min="0" step="0.1" data-type="number" data-field="{{building.basePath}}.income.service.visitorDemandPerReputation" value="{{building.income.service.visitorDemandPerReputation}}" />{{else}}<strong>{{building.income.service.visitorDemandPerReputation}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Дополнительные посещения приезжих за уровень рыночных связей (УРС).">За УРС</span>{{#if canEdit}}<input type="number" min="0" step="0.1" data-type="number" data-field="{{building.basePath}}.income.service.visitorDemandPerConnection" value="{{building.income.service.visitorDemandPerConnection}}" />{{else}}<strong>{{building.income.service.visitorDemandPerConnection}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Сколько услуг способен оказать один эффективный работник за десятник.">Мощность работника</span>{{#if canEdit}}<input type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.service.servicesPerWorker" value="{{building.income.service.servicesPerWorker}}" />{{else}}<strong>{{building.income.service.servicesPerWorker}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Сколько человеко-дней пищи расходуется на одно обслуживание.">Пища / услугу</span>{{#if canEdit}}<input type="number" min="0" step="0.1" data-type="number" data-field="{{building.basePath}}.income.service.foodPersonDaysPerService" value="{{building.income.service.foodPersonDaysPerService}}" />{{else}}<strong>{{building.income.service.foodPersonDaysPerService}}</strong>{{/if}}</label>
              <label class="fbls-checkbox-label fbls-icon-check" data-fbls-tooltip="Если включено, приезжих можно обслужить только в пределах гостевых мест здания."><span>Нужны гостевые места</span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.service.visitorRequiresHousing" {{#if building.income.service.visitorRequiresHousing}}checked{{/if}} />{{else}}<strong>{{#if building.income.service.visitorRequiresHousing}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="ID складского ресурса, который расходуется на каждую услугу; оставьте пустым, если отдельного расхода нет.">Ресурс</span>{{#if canEdit}}<input type="text" data-field="{{building.basePath}}.income.service.inputResourceId" value="{{building.income.service.inputResourceId}}" placeholder="wood" />{{else}}<strong>{{building.income.service.inputResourceLabel}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Количество указанного складского ресурса на одну оказанную услугу.">Ресурс / услугу</span>{{#if canEdit}}<input type="number" min="0" step="0.05" data-type="number" data-field="{{building.basePath}}.income.service.inputQtyPerService" value="{{building.income.service.inputQtyPerService}}" />{{else}}<strong>{{building.income.service.inputQtyPerService}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Цена питания и/или ночлега в медных монетах.">Цена, ММ</span>{{#if canEdit}}<input type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.service.priceCopper" value="{{building.income.service.priceCopper}}" />{{else}}<strong>{{building.income.service.priceCopper}}</strong>{{/if}}</label>
              <div class="fbls-result-box" data-fbls-tooltip="Прогноз без учёта доступного остатка пищи: фактическое обслуживание не превысит ни спрос, ни рабочую мощность."><span>Спрос / мощность</span><strong>{{building.income.service.demandText}} / {{building.income.service.capacityText}}</strong><em>до {{building.income.service.expectedRevenue}} ММ</em></div>
            </div>
            <p class="fbls-muted-line">Услуги разных пулов имеют независимый спрос. Пища берётся только после общего стола: стандартная партия вскрывается целиком, а неиспользованные рационы остаются в буфере. Дополнительный стандартный ресурс тоже списывается целыми партиями. Гостевые места ограничивают приезжих только при включённом флажке.</p>
            <label class="fbls-wide-label"><span>Заметки по услугам</span>{{#if canEdit}}<textarea data-field="{{building.basePath}}.income.service.notes" rows="2">{{building.income.service.notes}}</textarea>{{else}}<p class="fbls-preline">{{building.income.service.notes}}</p>{{/if}}</label>
          </section>

          <section class="fbls-trade-editor-block fbls-editor-tab-panel"><div class="fbls-editor-panel-head"><span><i class="fa-solid fa-scale-balanced"></i> Торговля</span><small>Источник товара, покупатели и бюджет сделки</small></div>
            <div class="fbls-trade-grid">
              <label class="fbls-checkbox-label fbls-icon-check fbls-trade-enabled-toggle" data-fbls-tooltip="Продажа отмеченных складских строк через это здание."><span><i class="fa-solid fa-scale-balanced"></i></span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.trade.enabled" {{#if building.income.trade.enabled}}checked{{/if}} />{{else}}<strong>{{#if building.income.trade.enabled}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
              <label class="fbls-trade-eff-field"><span data-fbls-tooltip="{{building.income.trade.priceEfficiencyTitle}}">Эфф.</span><input type="text" value="{{building.income.trade.priceEfficiencyText}}" readonly /></label>
              <label><span data-fbls-tooltip="Из какого склада этот магазин может продавать отмеченные товары.">Склад</span>{{#if canEdit}}<select data-field="{{building.basePath}}.income.trade.roomId">{{#each building.income.trade.roomOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.income.trade.roomId}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Какие складские строки магазин может продавать: ресурсы, предметы или всё сразу.">Тип</span>{{#if canEdit}}<select data-field="{{building.basePath}}.income.trade.kind">{{#each building.income.trade.kindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.income.trade.kind}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Формула бюджета одного покупателя в медных монетах. 2d6*10 = 2d6 серебряных.">Бюджет</span>{{#if canEdit}}<input type="text" data-field="{{building.basePath}}.income.trade.budgetFormula" value="{{building.income.trade.budgetFormula}}" placeholder="2d6*10" />{{else}}<strong>{{building.income.trade.budgetFormula}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Сколько разных лотов может купить один покупатель за визит. Число торговцев ускоряет продажу через число обработанных лотов, но цену не повышает.">Лоты</span>{{#if canEdit}}<input type="number" data-type="number" data-field="{{building.basePath}}.income.trade.maxLotsPerBuyer" value="{{building.income.trade.maxLotsPerBuyer}}" />{{else}}<strong>{{building.income.trade.maxLotsPerBuyer}}</strong>{{/if}}</label>
            </div>
            <div class="fbls-trade-demand-grid">
              <label><span>Модель покупателей</span>{{#if canEdit}}<select data-field="{{building.basePath}}.income.trade.demandModel">{{#each building.income.trade.demandModelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{#if building.income.trade.isSettlementDemand}}Спрос владения{{else}}Старые броски Репутации{{/if}}</strong>{{/if}}</label>
              {{#if building.income.trade.isSettlementDemand}}
                <label><span data-fbls-tooltip="Число потенциальных покупателей на одного живого жителя за десятник.">На жителя</span>{{#if canEdit}}<input type="number" min="0" step="0.01" data-type="number" data-field="{{building.basePath}}.income.trade.localDemandPerResident" value="{{building.income.trade.localDemandPerResident}}" />{{else}}<strong>{{building.income.trade.localDemandPerResident}}</strong>{{/if}}</label>
                <label><span data-fbls-tooltip="Число приезжих покупателей за единицу Репутации в десятник.">За Репутацию</span>{{#if canEdit}}<input type="number" min="0" step="0.1" data-type="number" data-field="{{building.basePath}}.income.trade.visitorDemandPerReputation" value="{{building.income.trade.visitorDemandPerReputation}}" />{{else}}<strong>{{building.income.trade.visitorDemandPerReputation}}</strong>{{/if}}</label>
                <label><span data-fbls-tooltip="Число приезжих покупателей за уровень рыночных связей в десятник.">За УРС</span>{{#if canEdit}}<input type="number" min="0" step="0.1" data-type="number" data-field="{{building.basePath}}.income.trade.visitorDemandPerConnection" value="{{building.income.trade.visitorDemandPerConnection}}" />{{else}}<strong>{{building.income.trade.visitorDemandPerConnection}}</strong>{{/if}}</label>
                <label><span data-fbls-tooltip="Сколько покупателей за десятник способен провести один эффективный торговец.">Мощность работника</span>{{#if canEdit}}<input type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.buyersPerWorker" value="{{building.income.trade.buyersPerWorker}}" />{{else}}<strong>{{building.income.trade.buyersPerWorker}}</strong>{{/if}}</label>
                <div class="fbls-result-box"><span>Спрос / мощность</span><strong>{{building.income.trade.demand}} / {{building.income.trade.capacity}}</strong><em>до {{building.income.trade.expectedBuyers}} покупателей</em></div>
              {{/if}}
            </div>
              {{#if building.income.trade.isSettlementDemand}}<p class="fbls-muted-line">Спрос складывается из жителей, Репутации и УРС. Продажа состоится только при наличии подходящего товара, бюджета покупателя, обеспеченного капитала и рабочей мощности. Цена начинается с 50% справочной цены каталога и меняется эффективностью торговца; конечные покупатели не бесконечны.</p>{{else}}<p class="fbls-muted-line">Совместимый старый режим: каждый день владение бросает Репутацию, а каждая 6 создаёт покупателя. Используйте его только для пользовательских зданий, которым нужна прежняя случайная механика.</p>{{/if}}
            <label class="fbls-wide-label"><span>Заметки по торговле</span>{{#if canEdit}}<textarea data-field="{{building.basePath}}.income.trade.notes" rows="2">{{building.income.trade.notes}}</textarea>{{else}}<p class="fbls-preline">{{building.income.trade.notes}}</p>{{/if}}</label>
          </section>
        </fieldset>
      {{/if}}
