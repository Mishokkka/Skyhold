      {{#if building.showEditorIncome}}
        <fieldset class="fbls-building-editor-card wide-card income-card">
          <legend>Денежные функции <i class="fa-regular fa-circle-question fbls-help" data-fbls-tooltip="Прямой доход предназначен для неторговых оплачиваемых функций. Если включена торговая точка, деньги появляются только из конечного внутреннего спроса на фактические товары и услуги."></i></legend>
          <div class="fbls-income-grid">
            <label><span>Прямая база</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.income.base" value="{{building.income.base}}" />{{else}}<strong>{{building.income.base}}</strong>{{/if}}</label>
            <label title="Прямо за эф. работника"><span>За эф. работн.</span>{{#if canEdit}}<input aria-label="Прямо за эф. работника" class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.income.perWorker" value="{{building.income.perWorker}}" />{{else}}<strong>{{building.income.perWorker}}</strong>{{/if}}</label>
            <label><span>Формула</span>{{#if canEdit}}<input class="fbls-control" type="text" data-field="{{building.basePath}}.income.formula" value="{{building.income.formula}}" placeholder="1d6+@eff" />{{else}}<strong>{{building.income.formula}}</strong>{{/if}}</label>
            <label><span>Риск</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.income.risk" value="{{building.income.risk}}" />{{else}}<strong>{{building.income.risk}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Дневная ставка работника денежной функции. Ноль использует ставку здания.">Ставка / день</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.wageDailyCopper" value="{{building.income.wageDailyCopper}}" />{{else}}<strong>{{building.income.wageDailyCopper}}</strong>{{/if}}</label>
            <label title="Эксплуатация / мес."><span data-fbls-tooltip="Эксплуатация / мес.. Operating cost денежной или торговой функции за 30 дней.">Экспл. / мес.</span>{{#if canEdit}}<input aria-label="Эксплуатация / мес." class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.operatingUpkeepMonthlyCopper" value="{{building.income.operatingUpkeepMonthlyCopper}}" />{{else}}<strong>{{building.income.operatingUpkeepMonthlyCopper}}</strong>{{/if}}</label>
            <label class="fbls-income-illegal-toggle fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Незаконный доход. Используется как пометка для ГМа и будущих происшествий."><span>Незаконный</span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.illegal" {{#if building.income.illegal}}checked{{/if}} />{{else}}<strong>{{#if building.income.illegal}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
            <div class="fbls-result-box fbls-income-total-box" data-fbls-tooltip="Этот прямой результат применяется только к неторговой денежной функции. Торговая выручка рассчитывается отдельно из спроса, товара и продавца."><span>Прямой доход</span><strong>{{building.incomeSummary.total}}</strong><em>ММ / десятник · {{building.workerEfficiency.total}} эф.</em></div>
          </div>

          <div class="fbls-trade-editor-block">
            <div class="fbls-trade-grid">
              <label class="fbls-trade-enabled-toggle fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Продажа отмеченных складских строк через это здание."><span>Торговля</span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.trade.enabled" {{#if building.income.trade.enabled}}checked{{/if}} />{{else}}<strong>{{#if building.income.trade.enabled}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
              <label class="fbls-trade-eff-field"><span data-fbls-tooltip="{{building.income.trade.priceEfficiencyTitle}}">Эфф.</span><input class="fbls-control" type="text" value="{{building.income.trade.priceEfficiencyText}}" readonly /></label>
              <label><span data-fbls-tooltip="Из какого склада этот магазин может продавать отмеченные товары.">Склад</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.income.trade.roomId">{{#each building.income.trade.roomOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.income.trade.roomId}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Какие складские строки магазин может продавать: ресурсы, предметы или всё сразу.">Тип</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.income.trade.kind">{{#each building.income.trade.kindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.income.trade.kind}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Сколько единиц товара один эффективный продавец может обработать за десятник.">Пропуск / раб.</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.throughputUnitsPerWorker" value="{{building.income.trade.throughputUnitsPerWorker}}" />{{else}}<strong>{{building.income.trade.throughputUnitsPerWorker}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Более высокий приоритет получает спрос и товар раньше других каналов.">Приоритет GM</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.gmPriority" value="{{building.income.trade.gmPriority}}" />{{else}}<strong>{{building.income.trade.gmPriority}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Базовый гостевой или внешний спрос, создаваемый этой точкой. Повторные одинаковые здания дают убывающую отдачу.">Спрос: база</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.demandBudgetBaseCopper" value="{{building.income.trade.demandBudgetBaseCopper}}" />{{else}}<strong>{{building.income.trade.demandBudgetBaseCopper}}</strong>{{/if}}</label>
              <label><span data-fbls-tooltip="Дополнительный спрос на каждого эффективного работника.">Спрос / раб.</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.demandBudgetPerWorkerCopper" value="{{building.income.trade.demandBudgetPerWorkerCopper}}" />{{else}}<strong>{{building.income.trade.demandBudgetPerWorkerCopper}}</strong>{{/if}}</label>
              <div class="fbls-field"><span data-fbls-tooltip="Конечные источники спроса, разрешённые этому торговому каналу.">Источники</span>{{#if canEdit}}{{> "modules/fbl-skyhold/templates/parts/building-editor/list-picker.hbs" building.income.trade.sourceIdsPicker}}{{else}}<strong>{{building.income.trade.sourceIdsPicker.tooltip}}</strong>{{/if}}</div>
              <div class="fbls-field"><span data-fbls-tooltip="Категории и рыночные теги из каталога. «Все категории» снимает ограничение.">Категории</span>{{#if canEdit}}{{> "modules/fbl-skyhold/templates/parts/building-editor/list-picker.hbs" building.income.trade.allowedTagsPicker}}{{else}}<strong>{{building.income.trade.allowedTagsPicker.tooltip}}</strong>{{/if}}</div>
              <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Создаёт непереносимую услугу ночлега/развлечений. Неиспользованная вместимость сгорает."><span>Услуги</span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.income.trade.service.enabled" {{#if building.income.trade.service.enabled}}checked{{/if}} />{{else}}<strong>{{#if building.income.trade.service.enabled}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
              <label><span>Цена услуги</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.service.basePriceCopper" value="{{building.income.trade.service.basePriceCopper}}" />{{else}}<strong>{{building.income.trade.service.basePriceCopper}}</strong>{{/if}}</label>
              <label><span>Услуг / раб.</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.income.trade.service.unitsPerWorker" value="{{building.income.trade.service.unitsPerWorker}}" />{{else}}<strong>{{building.income.trade.service.unitsPerWorker}}</strong>{{/if}}</label>
              <label><span>Категория услуги</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.income.trade.service.categoryTag">{{#each building.income.trade.serviceCategoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.income.trade.service.categoryTag}}</strong>{{/if}}</label>
            </div>
            <p class="fbls-muted-line">В начале расчёта создаются три конечных бюджета: население, гости трактиров и внешний поток рынка. Все торговые точки делят эти бюджеты; неиспользованный спрос не переносится. Продавец меняет цену в пределах ×0,5–×1,5, но не создаёт покупателя или товар.</p>
            <label class="fbls-wide-label"><span>Заметки по торговле</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.basePath}}.income.trade.notes" rows="2">{{building.income.trade.notes}}</textarea>{{else}}<p class="fbls-preline">{{building.income.trade.notes}}</p>{{/if}}</label>
          </div>
        </fieldset>
      {{/if}}
