      {{#if building.showEditorConstruction}}
        <fieldset class="fbls-building-editor-card build-card wide-card compact-build-card">
          <legend>Строительство <i class="fa-regular fa-circle-question fbls-help" tabindex="0" role="img" aria-label="Стройбригада делает один бросок за десятник. Каждый принятый успех завершает одну стадию; её целая доля материалов списывается только тогда. Ноль успехов ничего не расходует, а нехватка материалов ограничивает фактический прогресс." data-fbls-tooltip="Стройбригада делает один бросок за десятник. Каждый принятый успех завершает одну стадию; её целая доля материалов списывается только тогда. Ноль успехов ничего не расходует, а нехватка материалов ограничивает фактический прогресс."></i></legend>
          <div class="fbls-build-main-row with-dev-requirements">
            <label><span>Цель</span>{{#if canEdit}}<input class="fbls-control" type="number" min="1" step="1" data-type="number" data-field="{{building.basePath}}.buildTarget" value="{{building.buildTarget}}" />{{else}}<strong>{{building.buildTarget}}</strong>{{/if}}</label>
            <label><span>Прогресс</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.buildProgress" value="{{building.buildProgress}}" />{{else}}<strong>{{building.buildProgress}}</strong>{{/if}}</label>
            <label><span>Сложн.</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.buildDifficulty" value="{{building.buildDifficulty}}" />{{else}}<strong>{{building.buildDifficulty}}</strong>{{/if}}</label>
            <div class="fbls-construction-dev-inline">
              <span>Требования развития</span>
              <div class="fbls-dev-line-fields compact-inline-dev">
                {{#each building.developmentParts}}
                  <label class="{{css}}" data-fbls-tooltip="{{label}}: требуемый уровень развития отрасли для открытия постройки."><i class="{{icon}}" aria-hidden="true"></i>{{#if ../canEdit}}<input aria-label="{{label}}: требуемый уровень развития" class="fbls-control" type="number" data-type="number" data-field="{{path}}" value="{{value}}" />{{else}}<strong>{{value}}</strong>{{/if}}</label>
                {{/each}}
              </div>
            </div>
            {{#if canEdit}}{{#unless building.isTemplate}}<button type="button" class="fbls-button compact fbls-button-role" data-action="roll-construction-crew"><i class="fa-solid fa-dice-six"></i> Бригада</button>{{/unless}}{{/if}}
            {{#if building.canRollConstruction}}<button type="button" class="fbls-button compact fbls-button-role" data-action="roll-construction" data-id="{{building.id}}"><i class="fa-solid fa-hammer"></i> Строить</button>{{/if}}
          </div>
          {{#if building.capitalLines}}<div class="fbls-callout" role="note">{{#each building.capitalLines}}<p>{{this}}</p>{{/each}}</div>{{/if}}
          <div class="fbls-build-subgrid tighter">
            <div class="fbls-cost-list">
              <div class="fbls-subhead"><span>Материалы</span>{{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="add-building-material" title="Добавить материал" aria-label="Добавить материал"><i class="fa-solid fa-plus"></i></button>{{/if}}</div>
              {{#each building.materialCosts}}
                <div class="fbls-cost-row">{{#if ../canEdit}}<button type="button" class="fbls-resource-picker-button fbls-control" data-action="pick-building-material" data-index="{{_index}}"><i class="fa-solid fa-cubes"></i><span>{{name}}</span><i class="fa-solid fa-chevron-right"></i></button><input class="fbls-control" type="number" data-type="number" data-field="{{qtyPath}}" value="{{qty}}" /><button type="button" class="fbls-icon-button danger" data-action="delete-building-material" data-index="{{_index}}" aria-label="Удалить материал {{name}}"><i class="fa-solid fa-trash"></i></button>{{else}}<strong>{{qty}} {{name}}</strong>{{/if}}</div>
              {{else}}<p class="fbls-muted-line">Материалы не заданы.</p>{{/each}}
            </div>
            <div class="fbls-prereq-list">
              <div class="fbls-subhead"><span>Нужны все здания</span>{{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="add-building-prerequisite" data-prerequisite-mode="all" title="Добавить обязательное здание" aria-label="Добавить обязательное здание"><i class="fa-solid fa-plus"></i></button>{{/if}}</div>
              {{#each building.requiredBuildings}}
                <div class="fbls-prereq-row {{#if met}}met{{else}}missing{{/if}}">{{#if ../canEdit}}{{#if editable}}<select class="fbls-control" data-field="{{path}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button type="button" class="fbls-icon-button danger" data-action="delete-building-prerequisite" data-prerequisite-mode="all" data-index="{{_index}}" aria-label="Удалить требование {{label}}"><i class="fa-solid fa-trash"></i></button>{{else}}<strong>{{label}} (системное)</strong>{{/if}}{{else}}<strong>{{label}}</strong>{{/if}}</div>
              {{else}}<p class="fbls-muted-line">Здания-требования не заданы.</p>{{/each}}
            </div>
            <div class="fbls-prereq-list">
              <div class="fbls-subhead"><span>Нужно хотя бы одно</span>{{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="add-building-prerequisite" data-prerequisite-mode="any" title="Добавить альтернативное здание" aria-label="Добавить альтернативное здание"><i class="fa-solid fa-plus"></i></button>{{/if}}</div>
              {{#each building.requiredAnyBuildings}}
                <div class="fbls-prereq-row {{#if met}}met{{else}}missing{{/if}}">{{#if ../canEdit}}<select class="fbls-control" data-field="{{path}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button type="button" class="fbls-icon-button danger" data-action="delete-building-prerequisite" data-prerequisite-mode="any" data-index="{{_index}}" aria-label="Удалить альтернативу {{label}}"><i class="fa-solid fa-trash"></i></button>{{else}}<strong>{{label}}</strong>{{/if}}</div>
              {{else}}<p class="fbls-muted-line">Альтернативы не заданы.</p>{{/each}}
            </div>
          {{#if building.isTemplate}}
            <div class="fbls-template-source-grid">
              <label title="Оригинальные материалы"><span>Материалы источника</span>{{#if canEdit}}<input aria-label="Оригинальные материалы" class="fbls-control" type="text" data-field="{{building.basePath}}.sourceRawMaterials" value="{{building.sourceRawMaterials}}" />{{else}}<strong>{{building.sourceRawMaterials}}</strong>{{/if}}</label>
              <label title="Оригинальные требования"><span>Требования источника</span>{{#if canEdit}}<input aria-label="Оригинальные требования" class="fbls-control" type="text" data-field="{{building.basePath}}.sourceRequirement" value="{{building.sourceRequirement}}" />{{else}}<strong>{{building.sourceRequirement}}</strong>{{/if}}</label>
              <label class="fbls-wide-label"><span>Особые требования</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.basePath}}.specialRequirements" rows="2">{{building.specialRequirements}}</textarea>{{else}}<p class="fbls-preline">{{building.specialRequirements}}</p>{{/if}}</label>
            </div>
          {{/if}}
          </div>
        </fieldset>
      {{/if}}
