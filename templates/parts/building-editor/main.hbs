      {{#if building.showEditorMain}}
        <fieldset class="fbls-building-editor-card main-card wide-card main-tab-card">
          <legend>Основное</legend>
          <div class="fbls-building-main-line fbls-building-main-identity">
            <label><span>Название</span>{{#if canEdit}}<input class="fbls-control" type="text" data-field="{{building.basePath}}.name" value="{{building.name}}" />{{else}}<strong>{{building.name}}</strong>{{/if}}</label>
            <label><span>Тип</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.type">{{#each building.categoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.categoryLabel}}</strong>{{/if}}</label>
            <label><span>Жизненный цикл</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.lifecycle">{{#each building.lifecycleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.lifecycleLabel}}</strong>{{/if}}</label>
            <label><span>Состояние</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.condition">{{#each building.conditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.conditionLabel}}{{#if building.repairActive}} · ремонт{{/if}}</strong>{{/if}}</label>
          </div>
          {{#if building.isTemplate}}
          <div class="fbls-building-main-line fbls-building-main-template fbls-building-option-row">
            {{#if building.isTemplate}}<label><span data-fbls-tooltip="Основная категория развития: food, technology, culture или war.">Категория Ark</span>{{#if canEdit}}<input class="fbls-control" type="text" data-field="{{building.basePath}}.primaryDev" value="{{building.primaryDev}}" placeholder="food / technology / culture / war" />{{else}}<strong>{{building.primaryDevLabel}}</strong>{{/if}}</label>{{/if}}
            {{#if building.isTemplate}}<label class="fbls-template-visibility-toggle fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Если выключено, игроки не увидят этот шаблон в каталоге. Для ГМа он уйдет во вкладку Скрытые."><span>Видно игрокам</span>{{#if canEdit}}<input type="checkbox" data-type="visibility" data-field="{{building.basePath}}.visibility" {{#if building.playerVisible}}checked{{/if}} />{{else}}<strong>{{building.visibilityText}}</strong>{{/if}}</label>{{/if}}
          </div>
          {{/if}}
          <div class="fbls-building-main-line fbls-building-main-economy">
            <label><span data-fbls-tooltip="Дневная ставка рабочего места по умолчанию. Личная ставка жителя может её заменить.">Ставка / день</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.wageDailyCopper" value="{{building.wageDailyCopper}}" />{{else}}<strong>{{building.wageDailyCopper}}</strong>{{/if}}</label>
            <label title="Баз. содержание / мес."><span data-fbls-tooltip="Баз. содержание / мес.. Денежное содержание физического здания за 30 дней. Начисляется по третям каждый десятник.">Содерж. / мес.</span>{{#if canEdit}}<input aria-label="Баз. содержание / мес." class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.baseUpkeepMonthlyCopper" value="{{building.baseUpkeepMonthlyCopper}}" />{{else}}<strong>{{building.baseUpkeepMonthlyCopper}}</strong>{{/if}}</label>
            <label title="Эксплуатация / мес."><span data-fbls-tooltip="Эксплуатация / мес.. Запасной operating cost для функции, если у её линии не задано отдельное значение.">Экспл. / мес.</span>{{#if canEdit}}<input aria-label="Эксплуатация / мес." class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.operatingUpkeepMonthlyCopper" value="{{building.operatingUpkeepMonthlyCopper}}" />{{else}}<strong>{{building.operatingUpkeepMonthlyCopper}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="{{#if building.maintenance.technical}}Целые QD техобслуживания на экземпляр за десятник. 0 — только денежное содержание. Назначение задаётся в плане работ жителя.{{else}}Целое требование трудового обслуживания за десятник: от 0 до 3 очков.{{/if}}">{{#if building.maintenance.technical}}Техобслуживание, QD{{else}}Обслуживание{{/if}}</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" max="3" step="1" data-type="number" data-field="{{building.maintenance.requiredPointsPath}}" value="{{building.maintenance.requiredPoints}}" />{{else}}<strong>{{building.maintenance.requiredPoints}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Приоритет обслуживания. Здания с большим приоритетом получают ограниченные очки обслуживания раньше; равенство разрешается стабильным id.">Пр. об.</span>{{#if canEdit}}<input class="fbls-control" type="number" step="1" data-type="number" data-field="{{building.maintenance.priorityPath}}" value="{{building.maintenance.priority}}" />{{else}}<strong>{{building.maintenance.priority}}</strong>{{/if}}</label>
          </div>
          <div class="fbls-building-main-line fbls-building-main-status fbls-building-option-row">
            <label><span data-fbls-tooltip="Число последовательных десятников без полного обслуживания. Первый пропуск не штрафует, второй и далее дают -50% эффективности.">Backlog</span><strong>{{building.maintenance.backlogTendays}}</strong></label>
            <label><span data-fbls-tooltip="Текущий множитель производительности от трудового обслуживания.">Эффективность</span><strong>{{building.maintenance.efficiencyPercent}}%</strong></label>
            <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Третий последовательный пропуск создаёт флаг для решения GM, но никогда не разрушает здание автоматически."><span>Решение GM</span>{{#if isGM}}{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.maintenance.needsResolutionPath}}" {{#if building.maintenance.needsResolution}}checked{{/if}} />{{else}}<strong>{{#if building.maintenance.needsResolution}}Требуется{{else}}Нет{{/if}}</strong>{{/if}}{{else}}<strong>{{#if building.maintenance.needsResolution}}Требуется{{else}}Нет{{/if}}</strong>{{/if}}</label>
          </div>
          {{#if building.showFunctionToggles}}
            <div class="fbls-function-strip no-title">
              {{#each building.functionOptions}}
                <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="{{tooltip}}"><i class="{{icon}}"></i><span>{{label}}</span>{{#if ../canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{path}}" {{#if checked}}checked{{/if}} />{{else}}{{#if checked}}<strong>✓</strong>{{else}}<strong>—</strong>{{/if}}{{/if}}</label>
              {{/each}}
            </div>
          {{/if}}
          <div class="fbls-main-effects-grid">
            <label><span>Эффект</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.basePath}}.effect" rows="2">{{building.effect}}</textarea>{{else}}<p class="fbls-preline">{{building.effect}}</p>{{/if}}</label>
            <label><span>Заметки</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.basePath}}.notes" rows="2">{{building.notes}}</textarea>{{else}}<p class="fbls-preline">{{building.notes}}</p>{{/if}}</label>
          </div>
          {{#if building.hasPendingProduction}}
            <div class="fbls-pending-production main-pending-production">
              <div class="fbls-subhead"><span>Готово к сбору</span></div>
              {{#each building.pendingProductionRows}}
                <div class="fbls-pending-production-row"><span>{{resource}}: <strong>{{qty}}</strong></span>{{#if ../canEdit}}<button type="button" class="fbls-button compact fbls-button-role" data-action="collect-production-line" data-index="{{lineIndex}}"><i class="fa-solid fa-hand-holding"></i> Собрать</button>{{/if}}</div>
              {{/each}}
            </div>
          {{/if}}
        </fieldset>
      {{/if}}
