      {{#if building.showEditorStorage}}
        <fieldset class="fbls-building-editor-card wide-card fbls-storage-building-card">
          <legend>Складское</legend>
          <div class="fbls-storage-building-grid">
            <label class="fbls-checkbox-label"><span>Предпочитать при автоприёмке</span>{{#if canEdit}}<input type="checkbox" aria-label="Предпочитать склад при автоматической приёмке" data-type="checkbox" data-field="{{building.storage.autoReceivePath}}" {{#if building.storage.autoReceive}}checked{{/if}} />{{else}}<strong>{{#if building.storage.autoReceive}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Сколько веса предметов и ресурсов можно хранить в этом складском помещении. 0 означает без жесткого лимита.">Вместимость</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.storage.capacityPath}}" value="{{building.storage.capacity}}" />{{else}}<strong>{{building.storage.capacity}}</strong>{{/if}}</label>
            <label title="Защищенность"><span data-fbls-tooltip="Защищенность. Насколько трудно этот склад ограбить или вскрыть. Значение используется как справочный рейтинг для ГМа.">Защита</span>{{#if canEdit}}<input aria-label="Защищенность" class="fbls-control" type="number" data-type="number" data-field="{{building.storage.securityPath}}" value="{{building.storage.security}}" />{{else}}<strong>{{building.storage.security}}</strong>{{/if}}</label>
            <label title="Качество хранения"><span data-fbls-tooltip="Качество хранения. Насколько хорошо склад сохраняет предметы: сухость, порядок, защита от порчи, вредителей и случайной потери.">Качество</span>{{#if canEdit}}<input aria-label="Качество хранения" class="fbls-control" type="number" data-type="number" data-field="{{building.storage.qualityPath}}" value="{{building.storage.quality}}" />{{else}}<strong>{{building.storage.quality}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Во сколько раз дольше хранятся скоропортящиеся сырые продукты и готовая еда. Для остальных товаров бонус не действует.">Срок еды ×</span>{{#if canEdit}}<input class="fbls-control" type="number" min="1" step="0.1" data-type="number" data-field="{{building.storage.shelfLifeMultiplierPath}}" value="{{building.storage.shelfLifeMultiplier}}" />{{else}}<strong>{{building.storage.shelfLifeMultiplier}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Короткое название специализации, которое видно в описании складского помещения.">Профиль</span>{{#if canEdit}}<input class="fbls-control" type="text" data-field="{{building.storage.profileLabelPath}}" value="{{building.storage.profileLabel}}" placeholder="Например: оружие" />{{else}}<strong>{{building.storage.profileLabel}}</strong>{{/if}}</label>
            <label title="Место профиля ×"><span data-fbls-tooltip="Место профиля ×. Доля обычного места, которую занимает подходящий товар. 0,5 означает удвоенную вместимость профиля.">Место ×</span>{{#if canEdit}}<input aria-label="Место профиля ×" class="fbls-control" type="number" min="0.01" max="1" step="0.05" data-type="number" data-field="{{building.storage.profileCapacityMultiplierPath}}" value="{{building.storage.profileCapacityMultiplier}}" />{{else}}<strong>{{building.storage.profileCapacityMultiplier}}</strong>{{/if}}</label>
            <label class="wide" title="ID ресурсов профиля"><span data-fbls-tooltip="ID ресурсов профиля. Точные id ресурсов через запятую. Подходящие товары получают бонус профиля.">Ресурсы профиля</span>{{#if canEdit}}<input aria-label="ID ресурсов профиля" class="fbls-control" type="text" data-field="{{building.storage.profileResourceIdsPath}}" value="{{building.storage.profileResourceIdsText}}" placeholder="grain, simple-armament" />{{else}}<strong>{{building.storage.profileResourceIdsText}}</strong>{{/if}}</label>
            <label class="wide"><span data-fbls-tooltip="Категории каталога через запятую, например food.raw или armament.">Категории профиля</span>{{#if canEdit}}<input class="fbls-control" type="text" data-field="{{building.storage.profileCategoryTagsPath}}" value="{{building.storage.profileCategoryTagsText}}" />{{else}}<strong>{{building.storage.profileCategoryTagsText}}</strong>{{/if}}</label>
            <label class="wide"><span data-fbls-tooltip="Рыночные теги через запятую. Это позволяет охватить группу ресурсов без перечисления каждого id.">Рыночные теги</span>{{#if canEdit}}<input class="fbls-control" type="text" data-field="{{building.storage.profileMarketTagsPath}}" value="{{building.storage.profileMarketTagsText}}" />{{else}}<strong>{{building.storage.profileMarketTagsText}}</strong>{{/if}}</label>
            
            
          </div>
          <div class="fbls-cluster"><label class="fbls-checkbox-label fbls-choice-toggle" title="Скоропортящаяся еда" data-fbls-tooltip="Скоропортящаяся еда. Применять профиль ко всей скоропортящейся сырой и готовой пище."><span>Скоропорт.</span>{{#if canEdit}}<input aria-label="Скоропортящаяся еда" type="checkbox" data-type="checkbox" data-field="{{building.storage.profilePerishableFoodPath}}" {{#if building.storage.profilePerishableFood}}checked{{/if}} />{{else}}<strong>{{#if building.storage.profilePerishableFood}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label><label class="fbls-checkbox-label fbls-choice-toggle" title="Профиль требует штат" data-fbls-tooltip="Профиль требует штат. Без минимального оплаченного штата помещение остается обычным складом, но теряет бонус специализации."><span>Нужен штат</span>{{#if canEdit}}<input aria-label="Профиль требует штат" type="checkbox" data-type="checkbox" data-field="{{building.storage.profileRequiresStaffPath}}" {{#if building.storage.profileRequiresStaff}}checked{{/if}} />{{else}}<strong>{{#if building.storage.profileRequiresStaff}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label></div>
          <div class="fbls-storage-building-current {{building.storage.fillClass}}" data-fbls-tooltip="Заполнение считается по весу. Для старых строк ресурсов без веса используется 1 единица заполнения за 1 ресурс.">
            <span><i class="fa-solid fa-boxes-stacked"></i> Сейчас занято</span>
            <strong>{{building.storage.usedText}} / {{building.storage.capacityText}}</strong>
            <em>свободно: {{building.storage.freeText}}</em>
          </div>
          <p class="fbls-muted-line">Автоприёмка сначала заполняет доступные предпочтительные склады подходящего профиля, затем остальные предпочтительные склады; остаток остаётся снаружи. Явный выбор склада у линии имеет приоритет. Неподходящие товары хранить можно: они занимают обычное место. Долг, нехватка требуемого штата или запущенное обслуживание ослабляют только профиль, а не физический склад.</p>
        </fieldset>
      {{/if}}
