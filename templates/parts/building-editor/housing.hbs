      {{#if building.showEditorHousing}}
        <fieldset class="fbls-building-editor-card wide-card fbls-housing-building-card">
          <legend>Жилье</legend>
          <div class="fbls-housing-building-grid">
            <label><span data-fbls-tooltip="Сколько живых жителей может нормально жить в этом здании. 0 означает без жесткого лимита.">Вместимость</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.housing.capacityPath}}" value="{{building.housing.capacity}}" />{{else}}<strong>{{building.housing.capacity}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Влияние жилья на довольство жителей, которые здесь живут. Может быть отрицательным.">Комфорт</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.housing.comfortPath}}" value="{{building.housing.comfort}}" />{{else}}<strong>{{building.housing.comfort}}</strong>{{/if}}</label>
            <label><span data-fbls-tooltip="Общее качество жилья: сухость, тепло, безопасность, порядок. Пока используется как справочный рейтинг для ГМа.">Качество</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.housing.qualityPath}}" value="{{building.housing.quality}}" />{{else}}<strong>{{building.housing.quality}}</strong>{{/if}}</label>
          </div>
          <div class="fbls-housing-building-current {{building.housing.fillClass}}" data-fbls-tooltip="Занятость считается по живым жителям, у которых это здание выбрано как дом.">
            <span><i class="fa-solid fa-bed"></i> Сейчас живут</span>
            <strong>{{building.housing.usedText}} / {{building.housing.capacityText}}</strong>
            <em>свободно: {{building.housing.freeText}}</em>
          </div>
          {{#if canEdit}}
            <div class="fbls-housing-slot-grid">
              {{#each building.housing.slotRows}}
                <label>
                  <span>Место {{slotNo}}</span>
                  <select class="fbls-control" data-building-housing-field data-housing-slot="{{slot}}">
                    {{#each options}}
                      <option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if hint}} · {{hint}}{{/if}}</option>
                    {{/each}}
                  </select>
                </label>
              {{/each}}
            </div>
          {{/if}}
          {{#if building.housing.occupants}}
            <p class="fbls-muted-line"><strong>Жители:</strong> {{building.housing.occupants}}</p>
          {{else}}
            <p class="fbls-muted-line">В этом здании пока никто не живет.</p>
          {{/if}}
          <label class="fbls-wide-label"><span>Заметки по жилью</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.housing.notesPath}}" rows="2">{{building.housing.notes}}</textarea>{{else}}<p class="fbls-preline">{{building.housing.notes}}</p>{{/if}}</label>
        </fieldset>
      {{/if}}
