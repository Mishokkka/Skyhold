      {{#if building.showEditorProduction}}
        <fieldset class="fbls-building-editor-card wide-card production-lines-card fbls-production-workspace">
          <legend>Производство <i class="fa-regular fa-circle-question fbls-help" data-fbls-tooltip="Производство состоит из содержимого здания и производственных линий. Рабочие линии тратят рабочие QD. Временные линии срабатывают сами за период. Линии от содержимого умножают выход на число коров, ульев, деревьев или других единиц внутри здания. Если включен сбор, результат сначала копится в строке 'Готово'."></i></legend>

          <section class="fbls-production-panel fbls-building-contents-panel top-contents-panel" data-fbls-tooltip="Содержимое здания: животные, ульи, деревья, грядки, станки или другие единицы, от которых может зависеть производство с источником 'Содержимое'. Для рабочих линий этот блок не используется.">
            <div class="fbls-panel-header slim">
              <div><h3>Содержимое здания</h3></div>
              {{#if canEdit}}<button type="button" class="fbls-icon-button" data-action="add-building-content" title="Добавить содержимое" aria-label="Добавить содержимое здания"><i class="fa-solid fa-plus"></i></button>{{/if}}
            </div>
            <div class="fbls-content-list compact-contents">
              {{#each building.contents}}
                <div class="fbls-content-row-card">
                  {{#if ../canEdit}}
                    <label class="name"><span>Название</span><input class="fbls-control" type="text" data-field="{{namePath}}" value="{{name}}" placeholder="Коровы, ульи, деревья..." /></label>
                    <label><span>Кол-во</span><input class="fbls-control" type="number" data-type="number" data-field="{{qtyPath}}" value="{{qty}}" data-fbls-tooltip="Сколько таких единиц сейчас находится в здании." /></label>
                    <label><span>Макс.</span><input class="fbls-control" type="number" data-type="number" data-field="{{capacityPath}}" value="{{capacity}}" data-fbls-tooltip="Вместимость. Ноль означает, что предел не задан." /></label>
                    <button type="button" class="fbls-icon-button danger" data-action="delete-building-content" data-index="{{_index}}" aria-label="Удалить содержимое {{name}}"><i class="fa-solid fa-trash"></i></button>
                  {{else}}
                    <strong>{{name}}</strong><span>{{line}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="fbls-muted-line">Содержимое не задано.</p>
              {{/each}}
            </div>
          </section>

          <section class="fbls-production-panel fbls-production-lines-panel full-width-lines">
            <div class="fbls-panel-header slim">
              <div><h3>Линии производства</h3></div>
              {{#if canEdit}}<button type="button" class="fbls-button compact fbls-button-role" data-action="add-production-line"><i class="fa-solid fa-plus"></i> Линия</button>{{/if}}
            </div>
            <div class="fbls-function-strip no-title">
              <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Если включено, у здания может работать только одна производственная линия. Включение варианта автоматически выключает остальные." title="Один выбранный вариант"><span>Один вариант</span>{{#if canEdit}}<input aria-label="Один выбранный вариант" type="checkbox" data-type="checkbox" data-field="{{building.productionSelection.exclusivePath}}" {{#if building.productionSelection.exclusive}}checked{{/if}} />{{else}}<strong>{{#if building.productionSelection.exclusive}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
              <label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Отметка о том, что редкий или особый вариант производства разрешен решением ГМа."><span>Подтверждение ГМа</span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.productionSelection.gmConfirmedPath}}" {{#if building.productionSelection.gmConfirmed}}checked{{/if}} />{{else}}<strong>{{#if building.productionSelection.gmConfirmed}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
            </div>

              <div class="fbls-production-card-list">
                {{#each building.productionLines}}
                  <article class="fbls-production-card {{#if active}}active{{else}}inactive{{/if}}">
                    <header class="fbls-production-card-header fbls-card-header">
                      <div class="fbls-production-title">
                        {{#if ../canEdit}}<label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Включенная линия участвует в экономическом ходе. Если варианты взаимоисключающие, эта отметка выключит остальные линии."><input type="checkbox" data-type="checkbox" data-field="{{activePath}}" {{#if active}}checked{{/if}} aria-label="Включить линию {{mode}}" /><span>Вкл.</span></label>{{/if}}
                        {{#if ../canEdit}}<input class="fbls-control" type="text" data-field="{{modePath}}" value="{{mode}}" placeholder="Название линии" />{{else}}<h4>{{mode}}</h4>{{/if}}
                      </div>
                      <div class="fbls-production-badges">
                        <span data-fbls-tooltip="Источник производства: кто или что создает ресурс.">{{sourceLabel}}</span>
                        <span data-fbls-tooltip="Период, за который линия срабатывает для источников Время и Содержимое.">{{periodLabel}}</span>
                        {{#if requiresGmConfirmation}}<span class="warn" data-fbls-tooltip="Эту линию можно включить только после отметки «Подтверждение ГМа» над списком.">Сюжетный источник</span>{{/if}}
                        {{#if requiresCollection}}<span class="warn" data-fbls-tooltip="Ресурс сначала копится в строке Готово и требует ручного сбора.">Сбор</span>{{/if}}
                      </div>
                    </header>

                    <div class="fbls-production-card-grid source-{{source}}">
                      <label><span data-fbls-tooltip="Рабочие тратят труд и могут затем ждать выдержку. Время ведёт оплаченные партии без труда до истечения срока. Содержимое умножает периодический выход на число выбранных единиц здания.">Источник</span>{{#if ../canEdit}}<select class="fbls-control" data-field="{{sourcePath}}" {{#if identityLocked}}disabled title="Завершите или отмените партию и соберите готовый выпуск"{{/if}}>{{#each sourceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{sourceLabel}}</strong>{{/if}}</label>
                      {{#unless isWorkers}}
                        <label><span data-fbls-tooltip="Период нужен только для источников Время и Содержимое. Рабочие линии считают циклы через рабочие QD.">Период</span>{{#if ../canEdit}}<select class="fbls-control" data-field="{{periodPath}}">{{#each periodOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{periodLabel}}</strong>{{/if}}</label>
                      {{/unless}}
                      {{#if isContent}}
                        <label><span data-fbls-tooltip="Какая единица из блока 'Содержимое здания' умножает выход линии. Например: Коровы, Ульи, Деревья.">Содержимое</span>{{#if ../canEdit}}<select class="fbls-control" data-field="{{contentIdPath}}">{{#each contentOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{contentName}}</strong>{{/if}}</label>
                      {{/if}}
                      <label><span data-fbls-tooltip="Ресурс, который производит линия. Список берется из каталога ресурсов.">Ресурс</span>
                        {{#if ../canEdit}}
                          <button type="button" class="fbls-resource-picker-button fbls-control" data-action="pick-production-resource" data-index="{{_index}}" {{#if identityLocked}}disabled title="Завершите или отмените партию и соберите готовый выпуск"{{/if}}><i class="{{resourceIcon}}"></i><span>{{resource}}</span><i class="fa-solid fa-chevron-right"></i></button>
                        {{else}}
                          <strong><i class="{{resourceIcon}}"></i> {{resource}}</strong>
                        {{/if}}
                      </label>
                      {{#if isCustomResource}}
                        <label class="span-2"><span>Свой ресурс</span>{{#if ../canEdit}}<input class="fbls-control" type="text" data-field="{{resourcePath}}" {{#if identityLocked}}disabled{{/if}} value="{{resource}}" placeholder="свой ресурс" />{{else}}<strong>{{resource}}</strong>{{/if}}</label>
                      {{/if}}
                      <label><span data-fbls-tooltip="Сколько ресурса дает один цикл линии. При заданной вместимости это максимум одной партии; возможен меньший выпуск по наличию сырья и свободных мест. При нулевой вместимости требуется полная партия. Для источника Содержимое это количество за одну единицу содержимого.">Выход</span>{{#if ../canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{outputQtyPath}}" value="{{outputQty}}" />{{else}}<strong>{{outputQty}}</strong>{{/if}}</label>
                      <label><span data-fbls-tooltip="{{periodCycleTooltip}}">{{periodCycleLabel}}</span>{{#if ../canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{workQdPath}}" value="{{workQd}}" />{{else}}<strong>{{workQd}}</strong>{{/if}}</label>
                      {{#unless isWorkers}}
                        <label><span data-fbls-tooltip="Сколько ресурса уже накоплено и ждет сбора. Если сбор выключен, ресурс сразу попадает в хранилище.">Готово</span><strong class="fbls-prod-result">{{pendingQty}}</strong></label>
                      {{/unless}}
                    </div>

                    <div class="fbls-cluster">
                      {{#if isWorkers}}<label class="fbls-field"><span title="Выдержка после завершения труда. 0 — сразу готово; 0,25 дня = 1 QD. Ожидание не тратит труд. Если задана вместимость, можно готовить следующие партии на свободных местах.">Ожидание, дней</span>{{#if ../canEdit}}<input class="fbls-control" type="number" min="0" step="0.25" data-type="number" data-field="{{waitDaysPath}}" value="{{waitDays}}" aria-label="Ожидание после работы для линии {{mode}}" />{{else}}<strong>{{waitDays}}</strong>{{/if}}</label>{{/if}}
                      <label class="fbls-checkbox-label fbls-choice-toggle" title="Выключите, чтобы закончить уже начатые партии без новых запусков. Пустая линия выполнит одну партию и остановится.">{{#if ../canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{repeatPath}}" {{#if repeat}}checked{{/if}} aria-label="Повторять партии линии {{mode}}" />{{else}}<strong>{{#if repeat}}Да{{else}}Нет{{/if}}</strong>{{/if}}<span>Повторять партии</span></label>
                    </div>
                    {{#unless isContent}}
                      <div class="fbls-cluster">
                        <label class="fbls-field"><span title="Общий предел занятых ЕД.: подготовка, выдержка и несобранный выпуск. 0 — прежняя одна полная партия; больше 0 — частичные и параллельные партии.">Вместимость линии, ЕД.</span>{{#if ../canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{batchCapacityPath}}" value="{{batchCapacity}}" aria-label="Общая вместимость линии {{mode}}" />{{else}}<strong>{{batchCapacity}}</strong>{{/if}}</label>
                        {{#if batchCapacity}}<label class="fbls-field"><span title="Линия ждёт сырьё и свободные места минимум на X ЕД., затем запускает доступный объём до максимального выхода одной партии. Уже начатые партии не догружаются.">Запускать от, ЕД.</span>{{#if ../canEdit}}<input class="fbls-control" type="number" min="1" step="1" data-type="number" data-field="{{batchStartQtyPath}}" value="{{batchStartQty}}" aria-label="Минимальный объём запуска линии {{mode}}" />{{else}}<strong>{{batchStartQty}}</strong>{{/if}}</label>{{/if}}
                        <label class="fbls-field"><span title="Отдельный расход на каждый запуск независимо от размера партии. Основные расходы масштабируются по объёму и округляются вверх до целых ЕД.">На запуск партии</span>{{#if ../canEdit}}<input class="fbls-control" type="text" data-field="{{fixedExpensesPath}}" value="{{fixedExpenses}}" placeholder="Например: fuel-solid 1" aria-label="Постоянные расходы запуска линии {{mode}}" />{{else}}<strong>{{#if fixedExpenses}}{{fixedExpenses}}{{else}}—{{/if}}</strong>{{/if}}</label>
                      </div>
                      {{#if batchCapacity}}<p>Занято {{occupiedQty}} / {{batchCapacity}} ЕД.; свободно {{freeCapacity}}. «Выход» — максимум одной партии; труд и основные расходы указаны для этого объёма. Меньшая загрузка требует пропорционально меньше труда и сырья, но того же срока ожидания.</p>{{else}}<p class="fbls-muted-line">Одна полная партия на линии. Для частичной загрузки и нескольких партий задайте вместимость выше нуля.</p>{{/if}}
                      <p class="fbls-muted-line">Выключение линии, неподходящий сезон или недоступное обслуживание приостанавливают все её партии, но не порчу. Назначенные зарплаты сохраняются и во время ожидания. Изменения рецепта действуют на новые партии.</p>
                    {{/unless}}
                    {{#if productionBatches}}<div class="fbls-stack" aria-label="Партии производственной линии">
                      {{#each productionBatches}}<div class="fbls-cluster"><span>{{qty}} ЕД. · {{progressText}}</span>{{#if ../../canEdit}}{{#if id}}<button type="button" class="fbls-icon-button" data-action="cancel-production-batch" data-index="{{../_index}}" data-batch-id="{{id}}" title="Отменить только эту партию" aria-label="Отменить партию {{qty}} ЕД. {{progressText}}"><i class="fa-solid fa-ban" aria-hidden="true"></i></button>{{/if}}{{/if}}</div>{{/each}}
                    </div>{{/if}}

                    <div class="fbls-production-utility-row {{#if isWorkers}}workers{{else}}nonworkers{{/if}}">
                      <label><span data-fbls-tooltip="Куда попадет произведенный или собранный ресурс. По умолчанию: Под открытым небом. Построенные здания со свойством Склад появляются в этом списке.">Отгружать в</span>{{#if ../canEdit}}<select class="fbls-control" data-field="{{storageRoomIdPath}}">{{#each storageRoomOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{storageRoomLabel}}</strong>{{/if}}</label>
                      <label><span data-fbls-tooltip="Формула выхода за цикл. Поддерживает @eff, @workers, @cycles, @qd, @workqd.">Формула</span>{{#if ../canEdit}}<input class="fbls-control" type="text" data-field="{{formulaPath}}" value="{{formula}}" placeholder="1d6 + @eff" />{{else}}{{#if formula}}<strong>{{formula}}</strong>{{else}}<strong>—</strong>{{/if}}{{/if}}</label>
                      <div class="fbls-production-season-box">
                        <span data-fbls-tooltip="В какие сезоны линия вообще может производить ресурс.">Сезоны</span>
                        <div class="fbls-production-season-pills">
                          {{#each seasonOptions}}
                            <label class="fbls-season-pill fbls-choice-toggle {{#if selected}}active{{/if}}" title="{{label}}">{{#if ../../canEdit}}<input aria-label="{{label}}" type="checkbox" data-type="checkbox" data-field="{{path}}" {{#if selected}}checked{{/if}} />{{/if}}<em>{{short}}</em></label>
                          {{/each}}
                        </div>
                      </div>
                      {{#if isWorkers}}
                        <label class="fbls-overtime-toggle fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Переработка увеличивает дневной лимит работников этого здания с 2 QD до 3 QD. Если у здания отрицательный Мод. ДОВ для работников, он удваивается."><span>Перераб.</span>{{#if ../canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{overtimePath}}" {{#if overtime}}checked{{/if}} />{{else}}<strong>{{#if overtime}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label>
                        <label><span data-fbls-tooltip="Дневная ставка именно этой производственной линии. Ноль использует ставку здания.">Ставка / день</span>{{#if ../canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{wageDailyCopperPath}}" value="{{wageDailyCopper}}" />{{else}}<strong>{{wageDailyCopper}}</strong>{{/if}}</label>
                      {{/if}}
                    </div>

                    <div class="fbls-production-advanced {{#if isWorkers}}workers-only{{/if}}">
                      {{#unless isWorkers}}
                        <div class="fbls-production-collect-toggle"><label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Сбор нужен для молока, урожая, меда и похожих ресурсов: сначала они копятся, потом работник тратит QD, чтобы перенести их в хранилище.">{{#if ../canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{requiresCollectionPath}}" {{#if requiresCollection}}checked{{/if}} />{{else}}<strong>{{#if requiresCollection}}Да{{else}}Нет{{/if}}</strong>{{/if}}<span>Сбор</span></label>{{#if ../canEdit}}<input aria-label="QD на сбор" class="fbls-control" type="number" data-type="number" data-field="{{collectQdPath}}" value="{{collectQd}}" data-fbls-tooltip="Сколько рабочих QD нужно, чтобы собрать накопленное." />{{else}}{{#if requiresCollection}}<strong>{{collectQd}} QD</strong>{{/if}}{{/if}}</div>
                        {{#if requiresCollection}}<label><span data-fbls-tooltip="Автосбор: работник этого здания собирает ресурс сразу после появления. Работник потребителя может забрать готовый ресурс, если другому зданию он нужен как расход.">Автосбор</span>{{#if ../canEdit}}<select class="fbls-control" data-field="{{autoCollectPath}}">{{#each autoCollectOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{autoCollectLabel}}</strong>{{/if}}</label>{{/if}}
                      {{/unless}}
                      <label title="Расходы считаются"><span data-fbls-tooltip="Сырьё списывается при запуске. «За цикл» — рецепт максимальной партии, «за единицу» — на одну ЕД. При заданной вместимости возможна частичная загрузка: расход уменьшается пропорционально с округлением вверх до целых ЕД. Без вместимости нужен полный рецепт.">Расходы</span>{{#if ../canEdit}}<input aria-label="Расходы считаются" class="fbls-control" type="text" data-field="{{expensesPath}}" value="{{expenses}}" placeholder="Уголь 1, Руда 2" />{{else}}{{#if expenses}}<strong>{{expenses}}</strong>{{else}}<strong>—</strong>{{/if}}{{/if}}</label>
                      {{#if ../canEdit}}<div class="fbls-expense-picker fbls-action-group">
                        <select class="fbls-control" data-expense-operator aria-label="Связка нового материала"><option value="and">И</option><option value="or">ИЛИ</option></select>
                        <input class="fbls-control" type="number" data-expense-qty min="1" step="1" value="1" aria-label="Количество расходуемого материала" />
                        <button type="button" class="fbls-button compact fbls-button-role" data-action="pick-production-expense" data-index="{{_index}}" title="Добавить расход из каталога материалов"><i class="fa-solid fa-boxes-stacked"></i> Материал</button>
                        <small>И — нужны все группы; ИЛИ — один вариант. Например: Древесина 2 ИЛИ Уголь 1; Руда 2. Примечание — после #.</small>
                      </div>{{/if}}
                      <label title="Расходы считаются"><span data-fbls-tooltip="«За цикл» — на максимальный выход партии; «за единицу» — на одну ЕД. выпуска. Фиксированные расходы запуска указываются отдельно.">Расходы</span>{{#if ../canEdit}}<select aria-label="Расходы считаются" class="fbls-control" data-field="{{expenseModePath}}">{{#each expenseModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{expenseModeLabel}}</strong>{{/if}}</label>
                      <label title="Эксплуатация / мес."><span data-fbls-tooltip="Эксплуатация / мес.. Денежный operating cost этой функции за 30 дней. Он начисляется только когда функция запланирована и не заблокирована.">Экспл. / мес.</span>{{#if ../canEdit}}<input aria-label="Эксплуатация / мес." class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{operatingUpkeepMonthlyCopperPath}}" value="{{operatingUpkeepMonthlyCopper}}" />{{else}}<strong>{{operatingUpkeepMonthlyCopper}}</strong>{{/if}}</label>
                    </div>

                    {{#if economics}}<details class="fbls-stack" data-fbls-disclosure="production-economics-{{id}}" data-production-economics="{{id}}">
                      <summary>Расчёт доходности</summary>
                      <div class="fbls-cluster">
                        {{#if batchCapacity}}<label class="fbls-field"><span>Партия для расчёта, ЕД.</span><input class="fbls-control" type="number" min="1" max="{{outputQty}}" step="1" data-economics-input="batchQty" value="{{economics.batchQty}}" aria-label="Размер партии для расчёта доходности {{mode}}" /></label>{{/if}}
                        <label class="fbls-field"><span>Канал сбыта</span><select class="fbls-control" data-economics-input="channel" aria-label="Канал сбыта линии {{mode}}">{{#each economics.channels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                        <label class="fbls-field"><span>Цена за ЕД., ММ</span><input class="fbls-control" type="number" min="0" step="1" data-economics-input="unitPrice" value="{{economics.unitPrice}}" aria-label="Цена договора для линии {{mode}}" /></label>
                        <label class="fbls-field"><span>Эффективность продавца</span><input class="fbls-control" type="number" min="1" max="3" step="0.05" data-economics-input="sellerEfficiency" value="{{economics.sellerEfficiency}}" aria-label="Эффективность продавца для линии {{mode}}" /></label>
                        <label class="fbls-field"><span>Эффективность производства</span><input class="fbls-control" type="number" min="0.01" step="0.05" data-economics-input="productionEfficiency" value="{{economics.productionEfficiency}}" title="1 = 100%; влияет на труд на партию" aria-label="Эффективность производства линии {{mode}}" /></label>
                      </div>
                      <p data-economics-result aria-live="polite">{{economics.summary}}</p>
                      {{#if economics.waitDays}}<small>Ожидание одной партии: {{economics.waitDays}} дн. Остаток показан за партию; выпуск за месяц зависит от труда и доступных мест для выдержки. Назначенные зарплаты и содержание продолжают начисляться.</small>{{/if}}
                      <small>Оценка по каталожной стоимости сырья и стандартной ставке труда. Отдельно учитываются содержание, технические работы, пайки, доставка и расходы продажи. Сбыт не гарантирован. Для рынка или договора введите его фактическую цену; квалификация продавца: 1 = 50%, 2 = 100%, 3 = 150% базовой цены.</small>
                      {{#if economics.batchDays}}<small>Срок обработки новой пищевой партии: {{economics.batchDays}} дн., включая запланированное ожидание. После просрочки её сырьё и труд утрачиваются. Для уже начатой партии сохраняется срок на момент запуска.</small>{{/if}}
                    </details>{{/if}}
                    <footer class="fbls-production-card-footer">
                      <span>{{cycleText}}</span>
                      {{#if ../canEdit}}<div class="fbls-line-actions fbls-action-group">{{#if canCancelBatch}}<button type="button" class="fbls-icon-button" data-action="cancel-production-batch" data-index="{{_index}}" title="Отменить все партии и вернуть только пригодное сырьё" aria-label="Отменить все партии линии {{mode}}"><i class="fa-solid fa-ban" aria-hidden="true"></i></button>{{/if}}<button type="button" class="fbls-icon-button danger" data-action="delete-production-line" data-index="{{_index}}" title="Удалить линию с возвратом пригодного сырья" aria-label="Удалить производственную линию {{mode}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div>{{/if}}
                    </footer>
                  </article>
                {{else}}
                  <p class="fbls-muted-line">Производственные линии не заданы.</p>
                {{/each}}
              </div>
          </section>
        </fieldset>
      {{/if}}
