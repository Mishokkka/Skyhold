      {{#if building.showEditorDefense}}
        <fieldset class="fbls-building-editor-card wide-card defense-card">
          <legend>Оборона <i class="fa-regular fa-circle-question fbls-help" tabindex="0" role="img" aria-label="Оборона дает реальную Защищенность поселения. Это не развитие Войны. Война открывает здания, а Защищенность бросается кубами против угроз и может зависеть от людей в башнях, стенах и гарнизонах." data-fbls-tooltip="Оборона дает реальную Защищенность поселения. Это не развитие Войны. Война открывает здания, а Защищенность бросается кубами против угроз и может зависеть от людей в башнях, стенах и гарнизонах."></i></legend>
          <div class="fbls-defense-grid">
            <label><span>База защиты</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.defense.base" value="{{building.defense.base}}" />{{else}}<strong>{{building.defense.base}}</strong>{{/if}}</label>
            <label><span>+ защиты</span>{{#if canEdit}}<input class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.defense.perStep" value="{{building.defense.perStep}}" />{{else}}<strong>{{building.defense.perStep}}</strong>{{/if}}</label>
            <label title="За каждые N работников"><span>Шаг работн.</span>{{#if canEdit}}<input aria-label="За каждые N работников" class="fbls-control" type="number" data-type="number" data-field="{{building.basePath}}.defense.workerStep" value="{{building.defense.workerStep}}" />{{else}}<strong>{{building.defense.workerStep}}</strong>{{/if}}</label>
            <label title="Тег отряда здания"><span>Тег отряда</span>{{#if canEdit}}<select aria-label="Тег отряда здания" class="fbls-control" data-field="{{building.basePath}}.defense.combatTag">{{#each combatTagOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.defenseCombatTagLabel}}</strong>{{/if}}</label>
            <div class="fbls-result-box" data-fbls-tooltip="{{building.defenseSummary.detail}}"><span>Итого защиты</span><strong>{{building.defenseSummary.total}}</strong><em>кубов защиты</em></div>
          </div>
        </fieldset>
      {{/if}}
