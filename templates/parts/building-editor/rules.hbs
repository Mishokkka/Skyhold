      {{#if building.showEditorMain}}
        <fieldset class="fbls-building-editor-card wide-card fbls-stack">
          <legend>Правила действия</legend>

          <div class="fbls-main-effects-grid">
            <label><span>Требования участка</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.basePath}}.siteRequirementsText" rows="2">{{building.rulesView.siteRequirementsText}}</textarea>{{else}}<p class="fbls-preline">{{building.rulesView.siteRequirementsText}}</p>{{/if}}</label>
            <label><span>Условие активации</span>{{#if canEdit}}<textarea class="fbls-control" data-field="{{building.basePath}}.activationConditionText" rows="2">{{building.rulesView.activationConditionText}}</textarea>{{else}}<p class="fbls-preline">{{building.rulesView.activationConditionText}}</p>{{/if}}</label>
          </div>

          <div class="fbls-building-main-line fbls-building-option-row">
            <label title="Мин. работников для функции"><span data-fbls-tooltip="Мин. работников для функции. Жёсткое условие только для неделимых бригад и служб. Обычный workersMin остаётся справочным минимумом.">Мин. работн.</span>{{#if canEdit}}<input aria-label="Мин. работников для функции" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.activation.minWorkers" value="{{building.rulesView.activation.minWorkers}}" />{{else}}<strong>{{building.rulesView.activation.minWorkers}}</strong>{{/if}}</label>
            <label title="Мин. QD за десятник"><span data-fbls-tooltip="Мин. QD за десятник. Порог фактических QD учитываемой функции за последний завершённый десятник. До его достижения услуга и досуг дают 0; этот порог проверяется отдельно от минимального числа работников.">Мин. QD / 10 дн.</span>{{#if canEdit}}<input aria-label="Мин. QD за десятник" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.activation.minOperationalQd" value="{{building.rulesView.activation.minOperationalQd}}" />{{else}}<strong>{{building.rulesView.activation.minOperationalQd}}</strong>{{/if}}</label>
            
            
          <div class="fbls-cluster"><label class="fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Эффект включается только после фактического выпуска, оказанной услуги или другого значимого результата."><span>Нужен результат</span>{{#if canEdit}}<input type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.activation.requiresMeaningfulResult" {{#if building.rulesView.activation.requiresMeaningfulResult}}checked{{/if}} />{{else}}<strong>{{#if building.rulesView.activation.requiresMeaningfulResult}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label><label class="fbls-checkbox-label fbls-choice-toggle" title="Повторяет поселковые эффекты" data-fbls-tooltip="Повторяет поселковые эффекты. Разрешает повторять развитие, Репутацию и обычное глобальное Довольство. Досуг повторяется независимо от этого флага, с убывающей отдачей."><span>Повтор эффектов</span>{{#if canEdit}}<input aria-label="Повторяет поселковые эффекты" type="checkbox" data-type="checkbox" data-field="{{building.basePath}}.repeatSettlementEffects" {{#if building.rulesView.repeatSettlementEffects}}checked{{/if}} />{{else}}<strong>{{#if building.rulesView.repeatSettlementEffects}}Да{{else}}Нет{{/if}}</strong>{{/if}}</label></div></div>

          {{#if building.rulesView.service}}
            <div class="fbls-subhead"><span>Общественная услуга</span></div>
            <div class="fbls-building-main-line">
              <label title="Базовая вместимость"><span>Баз. вмест.</span>{{#if canEdit}}<input aria-label="Базовая вместимость" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.service.capacityBase" value="{{building.rulesView.service.capacityBase}}" />{{else}}<strong>{{building.rulesView.service.capacityBase}}</strong>{{/if}}</label>
              <label title="Фикс. вместимость"><span>Фикс. вмест.</span>{{#if canEdit}}<input aria-label="Фикс. вместимость" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.service.capacity" value="{{building.rulesView.service.capacity}}" />{{else}}<strong>{{building.rulesView.service.capacity}}</strong>{{/if}}</label>
              <label><span>За работника</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.service.capacityPerWorker" value="{{building.rulesView.service.capacityPerWorker}}" />{{else}}<strong>{{building.rulesView.service.capacityPerWorker}}</strong>{{/if}}</label>
              <label title="За шаг работников"><span>За шаг работн.</span>{{#if canEdit}}<input aria-label="За шаг работников" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.service.capacityPerWorkerStep" value="{{building.rulesView.service.capacityPerWorkerStep}}" />{{else}}<strong>{{building.rulesView.service.capacityPerWorkerStep}}</strong>{{/if}}</label>
              <label><span>Размер шага</span>{{#if canEdit}}<input class="fbls-control" type="number" min="1" step="1" data-type="number" data-field="{{building.basePath}}.service.workerStep" value="{{building.rulesView.service.workerStep}}" />{{else}}<strong>{{building.rulesView.service.workerStep}}</strong>{{/if}}</label>
              <label><span>Максимум</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.service.maximumCapacity" value="{{building.rulesView.service.maximumCapacity}}" />{{else}}<strong>{{building.rulesView.service.maximumCapacity}}</strong>{{/if}}</label>
              <label><span>Тип охвата</span>{{#if canEdit}}<select class="fbls-control" data-field="{{building.basePath}}.service.coverageKind">{{#each building.rulesView.service.coverageKindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<strong>{{building.rulesView.service.coverageKind}}</strong>{{/if}}</label>
            </div>
            <label class="fbls-wide-label"><span>Охваченные ID зданий</span>{{#if canEdit}}<textarea class="fbls-control" data-building-string-list-field="{{building.basePath}}.service.coveredBuildingIds" rows="2" placeholder="building-id-1, building-id-2">{{building.rulesView.service.coveredBuildingIdsText}}</textarea>{{else}}<p class="fbls-preline">{{building.rulesView.service.coveredBuildingIdsText}}</p>{{/if}}</label>
          {{/if}}

          {{#if building.rulesView.control}}
            <div class="fbls-subhead"><span>Контроль</span></div>
            <div class="fbls-building-main-line">
              <label><span>Общий / работник</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.control.generalPerWorker" value="{{building.rulesView.control.generalPerWorker}}" />{{else}}<strong>{{building.rulesView.control.generalPerWorker}}</strong>{{/if}}</label>
              <label><span>Общий фикс.</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.control.generalFlat" value="{{building.rulesView.control.generalFlat}}" />{{else}}<strong>{{building.rulesView.control.generalFlat}}</strong>{{/if}}</label>
              <label title="Беспорядки / работник"><span>Беспор. / раб.</span>{{#if canEdit}}<input aria-label="Беспорядки / работник" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.control.unrestOnlyPerWorker" value="{{building.rulesView.control.unrestOnlyPerWorker}}" />{{else}}<strong>{{building.rulesView.control.unrestOnlyPerWorker}}</strong>{{/if}}</label>
              <label title="Беспорядки фикс."><span>Беспор. фикс.</span>{{#if canEdit}}<input aria-label="Беспорядки фикс." class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.control.unrestOnlyFlat" value="{{building.rulesView.control.unrestOnlyFlat}}" />{{else}}<strong>{{building.rulesView.control.unrestOnlyFlat}}</strong>{{/if}}</label>
              <label title="Максимум Контроля"><span>Макс. Контр.</span>{{#if canEdit}}<input aria-label="Максимум Контроля" class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.control.maximum" value="{{building.rulesView.control.maximum}}" />{{else}}<strong>{{building.rulesView.control.maximum}}</strong>{{/if}}</label>
              <label><span>Охват жителей</span>{{#if canEdit}}<input class="fbls-control" type="number" min="0" step="1" data-type="number" data-field="{{building.basePath}}.control.capacity" value="{{building.rulesView.control.capacity}}" />{{else}}<strong>{{building.rulesView.control.capacity}}</strong>{{/if}}</label>
              <label title="Потолок беспорядков"><span data-fbls-tooltip="Потолок беспорядков. Потолок Довольства только для проверок беспорядков; сырое Довольство не меняется.">Макс. беспор.</span>{{#if canEdit}}<input aria-label="Потолок беспорядков" class="fbls-control" type="number" max="0" step="1" data-type="nullable-number" data-field="{{building.basePath}}.control.ceiling" value="{{building.rulesView.control.ceilingValue}}" />{{else}}<strong>{{building.rulesView.control.ceilingValue}}</strong>{{/if}}</label>
            </div>
          {{/if}}

          {{#if building.isTemplate}}
            <label class="fbls-wide-label"><span data-fbls-tooltip="Связи будущего платного улучшения. Миграция каталога это поле не использует.">Улучшает шаблоны с ID</span>{{#if canEdit}}<textarea class="fbls-control" data-building-string-list-field="{{building.basePath}}.upgradesFromTemplateIds" rows="2">{{building.rulesView.upgradesFromTemplateIdsText}}</textarea>{{else}}<p class="fbls-preline">{{building.rulesView.upgradesFromTemplateIdsText}}</p>{{/if}}</label>
          {{/if}}
        </fieldset>
      {{/if}}
