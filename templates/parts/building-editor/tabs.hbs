      <div role="group" class="fbls-building-editor-tabs" aria-label="Разделы постройки">
        {{#each building.editorTabs}}
          <button type="button" aria-label="{{label}}" data-fbls-tooltip="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" class="fbls-building-editor-tab fbls-subnav-tab {{#if active}}active{{/if}}" data-action="building-editor-tab" data-editor-tab="{{id}}">
            <i class="{{icon}}" aria-hidden="true"></i><span>{{shortLabel}}</span>
          </button>
        {{/each}}
      </div>
