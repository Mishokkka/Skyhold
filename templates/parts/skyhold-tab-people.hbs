    {{#if active.people}}
      <section class="fbls-panel fbls-people-panel" {{#if canEdit}}data-resident-drop-zone{{/if}}>
        <div class="fbls-people-table-wrap">
          <div class="fbls-table-toolbar fbls-resident-toolbar stacked-toolbar fbls-toolbar">
            <div class="fbls-resident-filters fbls-toolbar-group fbls-toolbar-fields">
              <input type="search" data-resident-filter="search" value="{{residentFilters.search}}" placeholder="Поиск" />
              <select data-resident-filter="type">
                {{#each residentFilterOptions.types}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <select data-resident-filter="work">
                {{#each residentFilterOptions.work}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <select data-resident-filter="home">
                {{#each residentFilterOptions.home}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <select data-resident-filter="morale">
                {{#each residentFilterOptions.morale}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
            {{#if canEdit}}
              <button type="button" class="fbls-button compact" data-action="add-row" data-collection="holdings.{{holdingIndex}}.people.list">
                <i class="fa-solid fa-plus"></i> Добавить
              </button>
            {{/if}}
          </div>
          <table class="fbls-table fbls-resident-list">
            <thead>
              <tr>
                <th>Имя</th>
                <th>Лет</th>
                <th>Раса</th>
                <th>Тип</th>
                <th>Работа</th>
                <th>Жилье</th>
                <th>Дов.</th>
                <th>Черты</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each rows.people}}
                <tr class="fbls-person-row {{deadClass}}" data-id="{{id}}" data-resident-search="{{searchText}}">
                  <td class="fbls-person-name">{{#if injured}}<span class="fbls-injury-mark {{injuredBadgeClass}}" title="{{injuredTitle}}"><b>{{injuredText}}</b><i class="fa-solid fa-plus"></i></span>{{/if}}<span class="fbls-person-name-text">{{name}}</span>{{#if laborProjectionAttention}}<span class="fbls-chip {{laborProjectionBadgeClass}}" title="{{laborProjectionDescription}}" aria-label="Прогноз труда: {{laborProjectionDescription}}">{{laborProjectionBadgeText}}</span>{{/if}}{{#if dead}}<span class="fbls-status-pill fbls-chip dead">Погиб</span>{{/if}}</td>
                  <td>{{ageLine}}</td>
                  <td>{{raceLine}}</td>
                  <td><span class="fbls-worker-badge fbls-chip fbls-note-tip inline-tip" style="{{workerTypeStyle}}" data-fbls-tooltip="{{attributeSummary}}">{{workerTypeLabel}}</span></td>
                  <td class="fbls-resident-work-cell">
                    {{#if ../canManagePeople}}
                      <select class="fbls-resident-work-select" data-work-assignment-field="holdings.{{../holdingIndex}}.people.list.{{_index}}.workAssignment" title="{{workLabel}}">
                        {{#each workOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    {{else}}
                      {{workLabel}}
                    {{/if}}
                  </td>
                  <td>{{homeLabel}}</td>
                  <td class="fbls-morale-cell"><span class="fbls-note-tip inline-tip" data-fbls-tooltip="{{moraleTooltip}}"><strong>{{moraleValue}}</strong></span></td>
                  <td class="fbls-traits-cell">
                    {{#if hasTraitBadges}}
                      {{#each traitBadges}}
                        <span class="fbls-trait-badge fbls-chip fbls-note-tip" data-fbls-tooltip="{{description}}" data-full-label="{{name}}" data-short-label="{{shortLabel}}" title="{{name}}">{{name}}</span>
                      {{/each}}
                    {{else}}
                      <span class="fbls-muted-text">—</span>
                    {{/if}}
                  </td>
                  <td class="fbls-note-cell">
                    {{#if noteTooltip}}
                      <span class="fbls-note-tip" data-fbls-tooltip="{{noteTooltip}}"><i class="fa-solid fa-circle-info"></i></span>
                    {{else}}
                      <span class="fbls-muted-text">—</span>
                    {{/if}}
                  </td>
                </tr>
                {{#if editing}}
                  <tr class="fbls-person-edit-row">
                    <td colspan="{{../peopleColspan}}">
                      {{> "modules/fbl-skyhold/templates/parts/skyhold-resident-editor.hbs"}}
                    </td>
                  </tr>
                {{/if}}
              {{else}}
                <tr><td colspan="{{peopleColspan}}" class="fbls-empty">Записей пока нет.</td></tr>
              {{/each}}
              <tr data-resident-search-empty hidden><td colspan="{{peopleColspan}}" class="fbls-empty">Поиск не дал результатов.</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    {{/if}}
