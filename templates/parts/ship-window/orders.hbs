<div class="fbls-ship-section-head fbls-card-header">
  <div><h3 class="fbls-heading-section">{{#if hasBundle}}Составной рейс{{else if inTransit}}Текущий рейс{{else}}Заказы поселений{{/if}}</h3>{{#if inTransit}}<p>{{nextAction}}</p>{{/if}}</div>
  <div class="fbls-action-group">
    {{#if atHome}}{{#unless hasBundle}}{{#unless ownSale}}<button type="button" class="fbls-button compact" data-action="ship-open-market" data-id="{{id}}" aria-label="Подготовить продажу груза кораблём {{name}}" title="Открыть «Внешний рынок» с этим кораблём как перевозчиком; отправление выполняется после проверки сделки."><i class="fa-solid fa-box" aria-hidden="true"></i> Продать свой груз</button>{{/unless}}{{/unless}}{{/if}}
    {{#if canGenerateWorld}}<button type="button" class="fbls-button compact" data-action="ship-generate-world" data-fbls-tooltip="Получить предложения этого порта на текущую декаду. Получение предложений бесплатно и не отправляет корабль."><i class="fa-solid fa-scroll" aria-hidden="true"></i> Получить заказы</button>{{/if}}
    {{#if canRerollWorld}}<button type="button" class="fbls-button compact" data-action="ship-reroll-world" data-fbls-tooltip="ГМ: заменить только свободные предложения этого корабля в текущем порту. Принятые договоры и чужие заказы сохраняются."><i class="fa-solid fa-dice" aria-hidden="true"></i> Перебросить</button>{{/if}}
  </div>
</div>
{{#each @root.shipsContext.worldIssues}}<p class="fbls-ship-notice">{{this}}</p>{{/each}}
{{#unless voyagePresentation}}{{#if catchUpDays}}<p class="fbls-callout" data-fbls-tooltip="Следующий приказ может использовать эти дни; новый рейс остановится на следующем требующем решения прибытии."><i class="fa-solid fa-clock" aria-hidden="true"></i> До даты поселения: {{catchUpDays}} дн. корабельного времени.</p>{{/if}}{{/unless}}
{{#if ownSale}}<div class="fbls-ship-box" tabindex="0" data-fbls-tooltip="Складской товар снят при отправлении. Сделка и спрос учитываются во «Внешнем рынке». Выручка поступит в бортовой кошелёк после доставки и решения возможного происшествия."><div class="fbls-card-header"><div><strong>Товар поселения → {{ownSale.marketLabel}}</strong><p class="fbls-muted-text">{{ownSaleCargoText}}</p></div><button type="button" class="fbls-button compact" data-action="ship-open-sale" data-id="{{id}}" aria-label="Открыть продажу груза корабля {{name}}"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Открыть продажу</button></div>{{#if ownSale.delayRemainingQd}}<p class="fbls-ship-notice">Продажа задержана; до расчёта с учётом задержки {{ownSaleRemainingDays}} дн.</p>{{/if}}<p>Ожидаемая выручка на борт: {{{fblsShipMoneyHtml ownSale.revenueCopper}}}.{{#if ownSaleNeedsResolution}} Требуется решение ГМа во «Внешнем рынке».{{/if}}</p></div>{{/if}}
{{#if departureIssues.length}}<details class="fbls-ship-box" data-ship-disclosure="departure-issues:{{id}}"><summary>Мешает новому отправлению · {{departureIssues.length}}</summary><ul>{{#each departureIssues}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
{{#if moneySummary.shortageCopper}}<p class="fbls-ship-notice">До покрытия счетов и рекомендуемого запаса не хватает {{{fblsShipMoneyHtml moneySummary.shortageCopper}}}.</p>{{/if}}
{{#if voyagePresentation}}{{> "modules/fbl-skyhold/templates/parts/ship-window/voyage-progress.hbs" voyagePresentation}}{{/if}}
{{#if hasBundle}}
  <div class="fbls-ship-box">
    <div class="fbls-card-header"><strong>Принятые грузы · {{orderBundle.orders.length}}</strong><span class="fbls-chip is-compact" tabindex="0" data-fbls-tooltip="Общая дорога и содержание оплачиваются по участкам. Плата и исход учитываются отдельно для каждого заказа.">Оплата по участкам ⓘ</span></div>
    <dl class="fbls-ship-facts">{{#each bundleOrders}}<div tabindex="0" data-fbls-tooltip="{{title}}. Груз: {{loadPoints}} ед. Плата заказчика: {{fblsShipMoney rewardCopper}}; фактическая выплата зависит от исхода и поступает только после доставки."><dt>{{cargoName}} · {{loadPoints}} ед.</dt><dd>{{stateLabel}}<br /><small>{{pickupLabel}} → {{destination}}</small></dd></div>{{/each}}</dl>
    {{#if commands.resolveBundle}}
      {{> "modules/fbl-skyhold/templates/parts/ship-window/command-readiness.hbs" commands.resolveBundle}}
      <div class="fbls-action-group">
        <button type="button" class="fbls-button compact" data-action="ship-resolve-bundle" title="{{commands.resolveBundle.reasonText}}" data-fbls-tooltip="Подвести итоги перелёта и доставленных в этом порту заказов перед новой погрузкой. Исход сохраняется до проверки денег; повтор не списывает расходы и не выдаёт плату дважды." {{#unless canResolveBundle}}disabled{{/unless}}><i class="fa-solid fa-dice" aria-hidden="true"></i> {{#if orderBundle.waitingFunds}}Продолжить сохранённые исходы{{else}}Подвести итоги участка{{/if}}</button>
        {{#if orderBundle.waitingFunds}}<button type="button" class="fbls-button compact" data-action="ship-window-tab" data-ship-panel-target="finance"><i class="fa-solid fa-coins" aria-hidden="true"></i> Проверить деньги</button>{{/if}}
      </div>
    {{/if}}
    {{#if commands.continueBundle}}
      <strong>Следующий участок → {{bundleNextStop.point.label}}</strong>
      {{> "modules/fbl-skyhold/templates/parts/ship-window/command-readiness.hbs" commands.continueBundle}}
      <button type="button" class="fbls-button compact" data-action="ship-continue-bundle" title="{{commands.continueBundle.reasonText}}" data-fbls-tooltip="Отправиться в следующий порт по принятому маршруту. Плановые расходы этого участка оплачиваются с борта один раз." {{#unless canContinueBundle}}disabled{{/unless}}><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Следующий порт</button>
    {{/if}}
  </div>
{{else if inTransit}}
  {{#if activeVoyage.quote.contract}}
  <div class="fbls-ship-box">
    <strong>Исход заказа · {{activeCargoTitle}}</strong>
    {{#if outcome}}
      <p>{{outcome.commercialLabel}} · {{outcome.eventLabel}}</p>
      <dl class="fbls-ship-facts"><div><dt>Плата</dt><dd>{{{fblsShipMoneyHtml outcome.rewardCopper}}}</dd></div><div><dt>Доп. расходы</dt><dd>{{{fblsShipMoneyHtml outcome.expenseCopper}}}</dd></div><div><dt>Задержка</dt><dd>{{outcome.delayDays}} дн.</dd></div><div><dt>Внимание</dt><dd>{{outcome.attentionDelta}}</dd></div></dl>
      {{#if shortageCopper}}<p class="fbls-ship-notice">Не хватает {{{fblsShipMoneyHtml shortageCopper}}}. Исход сохранён и повторно не бросается.</p>{{/if}}
    {{/if}}
    {{#if commands.resolveWorld}}
      {{> "modules/fbl-skyhold/templates/parts/ship-window/command-readiness.hbs" commands.resolveWorld}}
      <div class="fbls-action-group">
        <button type="button" class="fbls-button" data-action="ship-resolve-world" title="{{commands.resolveWorld.reasonText}}" data-fbls-tooltip="Подвести итог прибывшего заказа. Исход сохраняется до проверки денег; повтор не меняет результат и не выдаёт плату дважды." {{#unless canResolve}}disabled{{/unless}}><i class="fa-solid fa-dice" aria-hidden="true"></i> {{#if outcome}}Продолжить сохранённый исход{{else}}Подвести итог{{/if}}</button>
        {{#if activeVoyage.waitingFunds}}<button type="button" class="fbls-button compact" data-action="ship-window-tab" data-ship-panel-target="finance"><i class="fa-solid fa-coins" aria-hidden="true"></i> Проверить деньги</button>{{/if}}
      </div>
    {{else}}<p class="fbls-muted-text">Время рейса учитывается при расчёте поселения.</p>{{/if}}
  </div>
  {{/if}}
{{else}}
{{#unless ownSale}}
<div class="fbls-order-workspace">
{{#if offers.length}}<label class="fbls-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ship-order-search aria-label="Поиск заказов корабля" placeholder="Груз или порт…" autocomplete="off" /></label>{{/if}}
<div class="fbls-order-list" data-render-scroll-key="ship-order-list">
  {{#each offers}}
  <details class="fbls-ship-order {{#if isProfitable}}is-profitable{{else if isLoss}}is-loss{{/if}}" data-ship-order-choice data-ship-order-search-text="{{title}} {{cargoTitle}} {{contract.cargo.name}} {{pickupLabel}} {{destination}} {{kindLabel}}" data-ship-disclosure="order:{{id}}" data-ship-offer="{{id}}" data-ship-draft-scope="offer:{{id}}">
    <summary><label class="fbls-order-select"><input type="checkbox" value="{{id}}" data-ship-bundle-select aria-label="Добавить в план: {{title}}" /><span data-fbls-tooltip="{{#if isCompanion}}{{companionHint}}{{else}}{{title}} · {{kindLabel}}{{/if}}"><strong>{{cargoTitle}}</strong><small>{{kindLabel}} · {{contract.cargo.loadPoints}} ед.{{#if isCompanion}} · попутно{{/if}}</small></span></label><div class="fbls-order-destination" data-fbls-tooltip="{{pickupLabel}} → {{destination}} · {{durationDays}} дн. · {{difficultyLabel}}"><strong>{{pickupLabel}} → {{destination}}</strong><small>{{durationDays}} дн. · {{difficultyLabel}}</small></div><span class="fbls-order-prices {{#if isProfitable}}is-profitable{{else if isLoss}}is-loss{{/if}}" data-fbls-tooltip="{{#if isCompanion}}{{companionHint}} Отдельно: {{else}}До возврата и случайных исходов: {{/if}}плата {{fblsShipMoney rewardCopper}} − расходы {{fblsShipMoney costs.totalCopper}}"><small class="fbls-order-profit-label">{{profitLabel}}</small><strong>{{{fblsShipMoneyHtml profitCopper signed=true}}}</strong></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
    <div class="fbls-ship-order-body">
      <div class="fbls-ship-route" tabindex="0" data-fbls-tooltip="{{departureLabel}} — текущее место корабля. При удалённой погрузке корабль сначала летит туда порожним ({{approachKm}} км), затем с грузом ({{deliveryKm}} км)."><span>Корабль: {{departureLabel}}</span><strong>Погрузка: {{pickupLabel}}</strong><strong>Выгрузка: {{destination}}</strong><span>{{quote.distanceKm}} км</span></div>
      <div class="fbls-cluster">
        <span class="fbls-chip is-compact" tabindex="0" data-fbls-tooltip="Порожний подход {{approachKm}} км · путь с грузом {{deliveryKm}} км.">{{cargoTitle}} · {{contract.cargo.quantity}} шт.</span>
        <span class="fbls-chip is-compact" tabindex="0" data-fbls-tooltip="Перелёт {{timing.flightDays}} дн. (с ночёвками) · погрузка {{timing.loadingDays}} дн. · разгрузка {{timing.unloadingDays}} дн.">Полёт {{timing.flightDays}} дн. · порт {{timing.portDays}} дн.</span>
        <span class="fbls-chip is-compact" tabindex="0" data-fbls-tooltip="Внимание властей и известность корабля на этом направлении. Влияет на риск и контрабандные предложения.">Внимание {{attention.level}}/10 · {{attention.label}}</span>
        {{#if cargoFreshnessHint}}<span class="fbls-chip is-compact is-warning" tabindex="0" data-fbls-tooltip="{{cargoFreshnessHint}}">Скоропортящийся ⓘ</span>{{/if}}
      </div>
      <dl class="fbls-ship-facts">
        <div tabindex="0" data-fbls-tooltip="{{feeHint}}"><dt>Плата заказчика ⓘ</dt><dd>{{{fblsShipMoneyHtml rewardCopper}}}</dd></div>
        <div tabindex="0" data-fbls-tooltip="Место, занятое грузом заказчика. Это оптовая партия заказчика, а не покупка для поселения. Контрабанда ограничена тайниками."><dt>Место в трюме</dt><dd>{{contract.cargo.loadPoints}} ед.</dd></div>
        <div tabindex="0" data-fbls-tooltip="Провизия: {{fblsShipMoney costs.foodCopper}}. Жалованье: {{fblsShipMoney costs.crewCopper}}. Содержание: {{fblsShipMoney costs.upkeepCopper}}. Порт: {{fblsShipMoney costs.handlingCopper}}. Пошлины: {{fblsShipMoney costs.taxCopper}}."><dt>Расходы рейса ⓘ</dt><dd>{{{fblsShipMoneyHtml costs.totalCopper}}}</dd></div>
        <div tabindex="0" data-fbls-tooltip="Рекомендуемый запас сверх расходов рейса: путь домой {{fblsShipMoney returnReserveCopper}}, стоянка {{fblsShipMoney idleReserveCopper}} (по {{fblsShipMoney idleUpkeepCopperPerDay}}/день), риск исходов {{fblsShipMoney outcomeReserveCopper}}. Итого с запасом: {{fblsShipMoney recommendedBudgetCopper}}. Запас остаётся на борту и не списывается заранее."><dt>Рекомендуемый запас ⓘ</dt><dd>{{{fblsShipMoneyHtml recommendedReserveCopper}}}</dd></div>
      </dl>
      <details class="fbls-ship-budget-detail"><summary>Состав расходов и запаса</summary><p class="fbls-muted-text">Расходы ({{{fblsShipMoneyHtml costs.totalCopper}}}): провизия {{{fblsShipMoneyHtml costs.foodCopper}}}, жалованье {{{fblsShipMoneyHtml costs.crewCopper}}}, содержание {{{fblsShipMoneyHtml costs.upkeepCopper}}}, порт {{{fblsShipMoneyHtml costs.handlingCopper}}}, пошлины {{{fblsShipMoneyHtml costs.taxCopper}}}.</p><p class="fbls-muted-text">Запас ({{{fblsShipMoneyHtml recommendedReserveCopper}}}): путь домой {{{fblsShipMoneyHtml returnReserveCopper}}}, стоянка {{{fblsShipMoneyHtml idleReserveCopper}}}, риск исходов {{{fblsShipMoneyHtml outcomeReserveCopper}}}. Итого с запасом: {{{fblsShipMoneyHtml recommendedBudgetCopper}}}.</p></details>
      <div class="fbls-ship-risk-grid">{{#each styles}}<div tabindex="0" data-fbls-tooltip="{{styleHint}} Риск: {{riskLabel}}. Возможная выплата {{fblsShipMoney rewardRangeCopper.min}}–{{fblsShipMoney rewardRangeCopper.max}}; это выручка, а не чистая прибыль."><strong>{{styleLabel}}</strong><span>Риск {{riskLabel}}</span><small>{{{fblsShipMoneyHtml rewardRangeCopper.min}}} – {{{fblsShipMoneyHtml rewardRangeCopper.max}}}</small></div>{{/each}}</div>
    </div>
  </details>
  {{else}}<div class="fbls-empty">{{#if ownSale}}После расчёта за доставку товара появятся новые приказы.{{else if worldOffersGenerated}}Сейчас свободных заказов в этом порту нет. Новые могут появиться в следующую декаду.{{else}}Получите предложения, чтобы выбрать следующий рейс.{{/if}}</div>{{/each}}
</div>
<p class="fbls-empty-state is-compact" data-ship-order-empty hidden>По этому запросу заказов нет. Выбранные заказы остаются в плане.</p>
<section class="fbls-order-plan" aria-label="План выбранных заказов" data-ship-draft-scope="bundle:{{id}}">
  <div data-ship-planner-preview aria-label="Предварительный расчёт рейса"></div>
  <footer class="fbls-order-command fbls-toolbar" aria-label="Отправление корабля">
    <label class="fbls-field"><span>Подход</span><select data-ship-bundle-style data-ship-draft="bundle-style" aria-label="Подход капитана"><option value="cautious">Осторожно</option><option value="normal" selected>Обычно</option><option value="bold">С риском</option></select></label>
    {{#if atHome}}<input type="hidden" value="recommended" data-ship-bundle-budget-mode data-ship-draft="bundle-budget-mode" /><label class="fbls-field"><span>Бюджет, З</span><input type="number" min="0" step="0.01" data-ship-bundle-budget data-ship-draft="bundle-budget" placeholder="С запасом" aria-label="Целевой бюджет корабля в золотых (1 З = 10 С = 100 М)" title="Пустое поле — расходы рейса плюс рекомендуемый запас. Шаг 0,01 = 1 М. Переводится только недостающее; остаток вернётся в казну дома." /></label>{{/if}}
    <span class="fbls-muted-text" data-ship-planner-status role="status" aria-live="polite">Выберите 1–3 заказа</span>
    <button type="button" class="fbls-button" data-action="ship-depart-world" data-ship-planned disabled><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Принять и отправить</button>
  </footer>
</section>
</div>
  {{#if worldOfferError}}<p class="fbls-ship-notice">{{worldOfferError}}</p>{{/if}}
  {{#if returnOffer}}<div class="fbls-ship-box">
    <div class="fbls-card-header"><strong>Возвращение домой</strong><span class="fbls-chip is-compact">{{returnOffer.durationDays}} дн.</span></div>
    {{> "modules/fbl-skyhold/templates/parts/ship-window/command-readiness.hbs" commands.returnHome}}
    {{#unless readiness.ready}}<p class="fbls-muted-text">Допускается неполная или неготовая команда; готовность проверяется перед новым заказом.</p>{{/unless}}
    <button type="button" class="fbls-button compact" data-action="ship-return-home" title="{{commands.returnHome.reasonText}}" data-fbls-tooltip="Отправиться домой без нового заказа. Оплачиваются счёт стоянки к выходу и расходы пути. Провизия {{fblsShipMoney returnOffer.costs.foodCopper}}, жалованье {{fblsShipMoney returnOffer.costs.crewCopper}}, содержание {{fblsShipMoney returnOffer.costs.upkeepCopper}}, порт {{fblsShipMoney returnOffer.costs.handlingCopper}}, пошлины {{fblsShipMoney returnOffer.costs.taxCopper}}. При возвращении бортовой остаток передаётся поселению." {{#unless canReturnHome}}disabled{{/unless}}><i class="fa-solid fa-house" aria-hidden="true"></i> Лететь домой</button>
  </div>{{else if returnError}}<p class="fbls-ship-notice">{{returnError}}</p>{{/if}}
  {{#if canRelocate}}<div class="fbls-ship-box fbls-card-header"><div><strong>Передислокация</strong><p class="fbls-muted-text">Порожний перелёт в другой порт без контракта.</p></div><div class="fbls-action-group"><label class="fbls-field"><span>Порт</span><select data-ship-relocation-port aria-label="Порт передислокации" data-fbls-tooltip="Открытые воздушные порты. Наличие маршрута, длительность и расходы будут проверены перед отправкой.">{{#each relocationPorts}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label><button type="button" class="fbls-button compact" data-action="ship-relocate-world" data-fbls-tooltip="Показать смету и отправить корабль без контракта. Передислокация оплачивается из корабельных денег; дома нужный бюджет передаётся из казны поселения."><i class="fa-solid fa-location-arrow" aria-hidden="true"></i> Лететь</button></div></div>{{/if}}
{{/unless}}
{{/if}}
