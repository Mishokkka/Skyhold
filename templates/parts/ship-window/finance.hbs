<div class="fbls-toolbar"><div><h3 class="fbls-heading-section">Бортовая бухгалтерия</h3><p class="fbls-muted-text">1 З = 10 С = 100 М · запас и переводы не считаются расходами</p></div><span class="fbls-chip is-compact">{{#if atHome}}Доступна казна{{else}}Автономный бюджет{{/if}}</span></div>
{{#unless moneySummary.calculationValid}}<p class="fbls-ship-notice">Финансовый снимок неполон или содержит некорректную сумму. ГМ должен проверить данные; свободные средства не рассчитаны.</p>{{/unless}}
<dl class="fbls-ship-facts fbls-ship-box" aria-label="Баланс и обязательства">
  <div><dt>На борту</dt><dd>{{#if moneySummary.calculationValid}}{{{fblsShipMoneyHtml moneySummary.walletCopper}}}{{else}}Не рассчитан{{/if}}</dd></div>
  <div><dt>Счета к оплате</dt><dd>{{#if moneySummary.calculationValid}}{{{fblsShipMoneyHtml moneySummary.obligationsCopper}}}{{else}}—{{/if}}</dd></div>
  <div><dt>{{#if moneySummary.remainingOperatingCopper}}Участки и запас{{else}}Запас на рейс{{/if}}</dt><dd>{{#if moneySummary.reserveKnown}}{{{fblsShipMoneyHtml moneySummary.reserveCopper}}}{{else}}Не рассчитан{{/if}}</dd></div>
  <div tabindex="0" data-fbls-tooltip="Свободно = {{#if atHome}}борт + казна{{else}}борт{{/if}} − счета − {{#if moneySummary.remainingOperatingCopper}}участки и запас{{else}}запас{{/if}}."><dt>{{#if atHome}}Свободно с казной ⓘ{{else}}Свободно на борту ⓘ{{/if}}</dt><dd>{{#if moneySummary.reserveKnown}}{{{fblsShipMoneyHtml moneySummary.freeCopper}}}{{else}}Не определено{{/if}}</dd></div>
</dl>
{{#if atHome}}<div class="fbls-ship-meta-strip"><span>Казна поселения: {{#if moneySummary.calculationValid}}{{{fblsShipMoneyHtml moneySummary.settlementCopper}}}{{else}}не рассчитана{{/if}}</span></div>{{/if}}
{{#if canAdjust}}
<details class="fbls-ship-box" data-ship-disclosure="funds:{{id}}" open><summary><strong>{{#if atHome}}Перевод между казной и кораблём{{else}}ГМ · бортовой расход или поступление{{/if}}</strong></summary>
  <div class="fbls-ship-form-grid fbls-ship-money-form" data-ship-draft-scope="funds:{{id}}">
    <label class="fbls-field"><span>Операция</span><select data-ship-kind data-ship-draft="kind">{{#if atHome}}<option value="deposit">Из казны на борт</option><option value="withdraw">С борта в казну</option>{{else}}<option value="expense">Расход</option><option value="income">Поступление</option>{{/if}}</select></label>
    <label class="fbls-field"><span>Сумма, З</span><input type="number" min="0.01" step="0.01" value="" placeholder="0.00" data-ship-amount data-ship-draft="amount" title="Сумма в золотых, шаг 0,01 = 1 М (1 З = 10 С = 100 М)" /></label>
    {{#unless atHome}}<label class="fbls-field"><span>Причина</span><input type="text" data-ship-reason data-ship-draft="reason" placeholder="Например, ремонт в порту" /></label>{{/unless}}
    <button type="button" class="fbls-button compact" data-action="ship-adjust" data-fbls-tooltip="{{#if atHome}}Перевод сохраняет общую сумму денег; внесённый запас доступен кораблю в первую очередь и учитывается при следующем отправлении.{{else}}Записать фактический расход или поступление в бортовой кошелёк и журнал.{{/if}}">Провести</button>
  </div>
</details>{{/if}}
{{#if financePresentation.mandatoryShortageCopper}}<p class="fbls-ship-notice">Для оплаты счетов не хватает {{{fblsShipMoneyHtml financePresentation.mandatoryShortageCopper}}}.</p>{{/if}}
{{#if financePresentation.futureLegsShortageCopper}}<p class="fbls-ship-notice">Для следующих принятых участков рейса на борту не хватает {{{fblsShipMoneyHtml financePresentation.futureLegsShortageCopper}}} (их может покрыть промежуточная плата).</p>{{/if}}
{{#if financePresentation.contingencyShortageCopper}}<p class="fbls-ship-notice">До рекомендуемого запаса на возврат, стоянку и исходы не хватает {{{fblsShipMoneyHtml financePresentation.contingencyShortageCopper}}} (резерв, не счёт).</p>{{/if}}
{{#if moneySummary.calculationValid}}
<details class="fbls-ship-box" data-ship-disclosure="bills:{{id}}" aria-label="Неоплаченные обязательства корабля">
  <summary><strong>Счета к оплате</strong> · {{{fblsShipMoneyHtml moneySummary.obligationsCopper}}}</summary>
  <dl class="fbls-ship-facts">
    <div tabindex="0" data-fbls-tooltip="Счёт стоянки погашается при следующей корабельной операции или расчёте."><dt>Начисленная стоянка ⓘ</dt><dd>{{{fblsShipMoneyHtml moneySummary.portDebtCopper}}}</dd></div>
    <div tabindex="0" data-fbls-tooltip="Сохранённый исход требует подтверждения и наличия средств на борту."><dt>Сохранённые исходы ⓘ</dt><dd>{{{fblsShipMoneyHtml moneySummary.outcomeDueCopper}}}</dd></div>
  </dl>
</details>
<details class="fbls-ship-box" data-ship-disclosure="reserve:{{id}}" aria-label="Рекомендуемый запас корабля">
  <summary><strong>{{#if moneySummary.remainingOperatingCopper}}Следующие участки и запас{{else}}Запас на путь и риски{{/if}}</strong> · {{#if moneySummary.reserveKnown}}{{{fblsShipMoneyHtml moneySummary.reserveCopper}}}{{else}}Не рассчитан{{/if}}</summary>
  {{#if atHome}}<p class="fbls-muted-text">Запас рассчитывается при выборе заказов в разделе «Рейсы».</p>{{else}}
  <dl class="fbls-ship-facts fbls-ship-reserve-summary">
    {{#if moneySummary.remainingOperatingCopper}}<div><dt>Оставшиеся участки рейса</dt><dd>{{{fblsShipMoneyHtml moneySummary.remainingOperatingCopper}}}</dd></div>{{/if}}
    <div><dt>Запас на возврат, стоянку и исходы</dt><dd>{{#if moneySummary.reserveKnown}}{{{fblsShipMoneyHtml moneySummary.contingencyReserveCopper}}}{{else}}Не рассчитан{{/if}}</dd></div>
  </dl>
  <div class="fbls-cluster">
    <span class="fbls-chip is-compact">Путь домой: {{#if moneySummary.reserveKnown}}{{{fblsShipMoneyHtml moneySummary.returnReserveCopper}}}{{else}}—{{/if}}</span>
    <span class="fbls-chip is-compact">Стоянка: {{{fblsShipMoneyHtml moneySummary.idleReserveCopper}}}</span>
    {{#if moneySummary.incidentReserveCopper}}<span class="fbls-chip is-compact">Риски: {{{fblsShipMoneyHtml moneySummary.incidentReserveCopper}}}</span>{{/if}}
  </div>{{/if}}
  <p><strong>{{#if atHome}}Свободно дома{{else}}Свободно на борту{{/if}}: {{#if moneySummary.reserveKnown}}{{{fblsShipMoneyHtml moneySummary.freeCopper}}}{{else}}не определено{{/if}}</strong> <span class="fbls-muted-text">после счетов и запаса</span></p>
</details>
{{/if}}
{{#if financePresentation.pendingPayments.length}}<section class="fbls-ship-box" aria-label="Ожидаемые поступления"><div class="fbls-card-header"><strong>Ожидаемые поступления</strong><span class="fbls-chip is-compact" tabindex="0" data-fbls-tooltip="Эти деньги пока недоступны для оплаты расходов и могут измениться после доставки и исходов.">После доставки ⓘ</span></div>
  {{#each financePresentation.pendingPayments}}<div class="fbls-ship-ledger-row"><span class="fbls-ship-ledger-description">{{label}}<br /><small>{{#if routeLabel}}{{routeLabel}} · {{/if}}{{basisLabel}}</small></span><strong>{{{fblsShipMoneyHtml amountCopper}}}</strong></div>{{/each}}
</section>{{/if}}
{{#with financePresentation.outing as |report|}}
<section class="fbls-ship-box" aria-label="Денежный результат выхода корабля">
  <div class="fbls-card-header"><h3 class="fbls-heading-section">{{#if report.ongoing}}Текущий выход{{else}}Последний выход{{/if}}</h3><div tabindex="0" data-fbls-tooltip="Результат = поступления − расходы{{#if report.marketExpenseKnown}} (с учётом связанных операций казны){{/if}}. Переводы между бортом и казной в результат не входят."><small>Денежный результат ⓘ</small><br /><strong>{{{fblsShipMoneyHtml report.netCopper signed=true}}}</strong></div></div>
  {{#if report.partial}}<p class="fbls-ship-notice">Учёт начат после отправления. Итог охватывает только известные операции.</p>{{/if}}
  <dl class="fbls-ship-facts">
    {{#unless report.partial}}<div><dt>Выделено дома</dt><dd>{{{fblsShipMoneyHtml report.fundingCopper}}}</dd></div>{{/unless}}
    <div><dt>Получено на борт</dt><dd>{{{fblsShipMoneyHtml report.incomeCopper}}}</dd></div>
    <div><dt>Оплачено кораблём</dt><dd>{{{fblsShipMoneyHtml report.shipExpenseCopper}}}</dd></div>
    {{#if report.hasMarketExpenses}}<div><dt>{{#if report.hasTransport}}Перевозки вне борта{{else}}Продажа из казны{{/if}}</dt><dd>{{#if report.marketExpenseKnown}}{{{fblsShipMoneyHtml report.marketExpenseCopper}}}{{else}}Не подтверждены{{/if}}</dd></div>{{/if}}
    {{#if report.treasuryIncomeCopper}}<div><dt>Выручка в казну</dt><dd>{{{fblsShipMoneyHtml report.treasuryIncomeCopper}}}</dd></div>{{/if}}
    <div><dt>{{#if report.ongoing}}На борту сейчас{{else}}Передано домой{{/if}}</dt><dd>{{{fblsShipMoneyHtml report.balanceCopper}}}</dd></div>
  </dl>
  <div class="fbls-cluster">
    <span class="fbls-chip is-compact">Участков {{report.completedLegs}} / {{report.startedLegs}}</span>
    <span class="fbls-chip is-compact">{{report.durationDays}} дн.</span>
    <span class="fbls-chip is-compact">Стоянки: {{{fblsShipMoneyHtml report.portExpenseCopper}}}</span>
    {{#if report.obligationsCopper}}<span class="fbls-chip is-compact is-warning" tabindex="0" data-fbls-tooltip="Ещё не оплаченные счета в проведённый результат пока не включены.">Счета: {{{fblsShipMoneyHtml report.obligationsCopper}}}</span>{{/if}}
  </div>
  <p class="fbls-muted-text">Себестоимость складского груза и внутренние переводы в этот результат не входят.{{#if report.hasTransport}} Связанные перевозки учтены.{{/if}}</p>
  {{#if report.saleCostsUnknown}}<p class="fbls-ship-notice">В записи продажи нет подтверждённой суммы оплаченных рыночных расходов; сравнение с планом недоступно.</p>{{/if}}
  <details data-ship-disclosure="outing:{{../id}}"><summary>Смета и журнал операций</summary>
    {{#unless report.partial}}
      <dl class="fbls-ship-facts"><div><dt>Плановая плата</dt><dd>{{{fblsShipMoneyHtml report.plannedIncomeCopper}}}</dd></div><div><dt>Смета участков</dt><dd>{{{fblsShipMoneyHtml report.plannedExpenseCopper}}}</dd></div><div><dt>Плановая разница</dt><dd>{{{fblsShipMoneyHtml report.plannedNetCopper signed=true}}}</dd></div><div><dt>План срока</dt><dd>{{report.plannedDays}} дн.</dd></div></dl>
      {{#if report.canComparePlan}}<p>Отклонение от сметы: <strong>{{{fblsShipMoneyHtml report.varianceCopper signed=true}}}</strong>.</p>{{else if report.ongoing}}<p class="fbls-muted-text">Сравнение с планом появится после возвращения домой.</p>{{else if report.transportPending}}<p class="fbls-muted-text">Связанные перевозки ещё не завершены.</p>{{else}}<p class="fbls-muted-text">Сравнение недоступно: оплаченные расходы продажи подтверждены не полностью.</p>{{/if}}
    {{/unless}}
    {{#each report.details}}<div class="fbls-ship-ledger-row"><span>{{#if timeLabel}}{{timeLabel}}{{else}}{{elapsedDays}} дн.{{/if}}</span><span class="fbls-ship-ledger-description"><strong>{{kindLabel}}</strong>{{#if isTransfer}} · перевод{{/if}}<br />{{reason}}</span><strong>{{#if hasAmount}}{{{fblsShipMoneyHtml displayAmountCopper signed=true}}}{{else}}—{{/if}}</strong></div>{{/each}}
    {{#if report.omittedDetails}}<p class="fbls-muted-text">Ранних пояснений скрыто: {{report.omittedDetails}}. Их суммы учтены.</p>{{/if}}
  </details>
</section>
{{else}}<p class="fbls-muted-text">Отчёт путешествия появится после первой проведённой операции рейса.</p>{{/with}}
{{#if attentionRecords.length}}<details class="fbls-ship-box" data-ship-disclosure="attention:{{id}}"><summary><strong>Известность по направлениям</strong></summary><div class="fbls-cluster">{{#each attentionRecords}}<span class="fbls-chip is-compact" tabindex="0" data-fbls-tooltip="Внимание ведётся отдельно по направлениям торговли. Уровень влияет на риск и набор предложений.">{{direction}} · {{level}}/10 · {{label}}</span>{{/each}}</div></details>{{/if}}
{{#if @root.shipsContext.history.length}}<details class="fbls-ship-box" data-ship-disclosure="history:{{id}}"><summary>История рейсов и заказов</summary>{{#each @root.shipsContext.history}}<details><summary tabindex="0" data-fbls-tooltip="Денежный итог этой записи. Общий результат путешествия показан в сводном отчёте.">{{historyTitle}} · {{{fblsShipMoneyHtml netCopper signed=true}}}</summary>{{#if returnedCopper}}<p>Передано домой: {{{fblsShipMoneyHtml returnedCopper}}}</p>{{/if}}{{#if outcome}}<p>{{outcome.commercialLabel}} · {{outcome.eventLabel}} · задержка {{outcome.delayDays}} дн.</p>{{/if}}{{#each ledger}}<div class="fbls-ship-ledger-row"><span class="fbls-ship-ledger-description">{{label}}</span><strong>{{{fblsShipMoneyHtml externalDeltaCopper signed=true}}}</strong></div>{{/each}}</details>{{/each}}</details>{{/if}}
