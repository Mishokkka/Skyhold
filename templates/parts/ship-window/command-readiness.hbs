{{#if hasCost}}
<dl class="fbls-ship-facts">
  <div tabindex="0" data-fbls-tooltip="Плановое время участка: {{durationDays}} дн."><dt>Расходы участка · {{durationDays}} дн.</dt><dd>{{{fblsShipMoneyHtml operatingCopper}}}</dd></div>
  <div tabindex="0" data-fbls-tooltip="Стоянка рассчитана до времени этого отправления."><dt>Счёт стоянки</dt><dd>{{{fblsShipMoneyHtml portBillCopper}}}</dd></div>
  <div tabindex="0" data-fbls-tooltip="{{#if atHome}}Учтены автоматический бюджет и подготовка.{{else}}Рекомендуемый запас на будущие расходы не ограничивает эту команду.{{/if}}"><dt>{{#if atHome}}Нужно дома{{else}}Нужно на борту{{/if}} ⓘ</dt><dd>{{{fblsShipMoneyHtml requiredCopper}}}</dd></div>
  <div><dt>{{#if atHome}}Доступно дома{{else}}На борту{{/if}}</dt><dd>{{{fblsShipMoneyHtml availableCopper}}}</dd></div>
</dl>
{{#if shortageCopper}}<p class="fbls-ship-notice">Для этого шага не хватает {{{fblsShipMoneyHtml shortageCopper}}}. {{fundsHint}}</p>{{/if}}
{{/if}}
{{#if blockers.length}}<ul class="fbls-ship-notice" aria-label="Причины недоступности команды">{{#each blockers}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
{{#if needsFunds}}<button type="button" class="fbls-button compact" data-action="ship-window-tab" data-ship-panel-target="finance"><i class="fa-solid fa-coins" aria-hidden="true"></i> Проверить деньги</button>{{/if}}
