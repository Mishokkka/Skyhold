<div class="fbls-ship-section-head fbls-card-header"><div><h3 class="fbls-heading-section">Постоянная команда</h3><p>{{linkedCrewCount}} жителей{{#if abstractCrewCount}} · {{abstractCrewCount}} безымянных моряков{{/if}}</p></div><span class="fbls-chip" tabindex="0" data-fbls-tooltip="Приписка сохраняется, пока моряк работает в поселении. При отправке его работа и жильё освобождаются; после возвращения он отдыхает на борту.">Живут на корабле ⓘ</span></div>
{{#each readiness.warnings}}<p class="fbls-muted-text">{{message}}</p>{{/each}}
{{#if readiness.issues.length}}<div class="fbls-ship-notice"><strong>Мешает отправлению</strong><ul>{{#each readiness.issues}}<li>{{message}}</li>{{/each}}</ul></div>{{/if}}

{{#if crewRoster.length}}<label class="fbls-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ship-roster-search aria-label="Поиск моряков корабля" placeholder="Имя, обязанность или состояние…" autocomplete="off" /></label><table class="fbls-ship-roster"><caption>Приписанные моряки · {{crewRoster.length}}</caption><thead><tr><th scope="col">Имя и звание</th><th scope="col">Обязанности</th><th scope="col">Состояние</th><th scope="col">Житель</th></tr></thead><tbody>{{#each crewRoster}}<tr data-ship-roster-row data-ship-roster-search-text="{{name}} {{duty}} {{status}}"><td>{{name}}</td><td>{{duty}}</td><td><span class="fbls-chip is-compact">{{status}}</span></td><td>{{#if canOpenResident}}<button type="button" class="fbls-button compact" data-action="ship-open-resident" data-resident-id="{{id}}" aria-label="Открыть жителя {{name}}"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>{{/if}}</td></tr>{{/each}}</tbody></table><p class="fbls-empty-state is-compact" data-ship-roster-empty hidden>Моряки по этому запросу не найдены.</p>{{else}}<div class="fbls-empty-state is-compact">Именной состав пока не назначен. ГМ может назначить жителей в команду, когда корабль дома.</div>{{/if}}
<details class="fbls-ship-box" data-ship-disclosure="crew-rules:{{id}}"><summary>Приписка и береговая работа</summary><p class="fbls-muted-text">Состав назначает ГМ дома между рейсами. {{#if canManageResidents}}Береговая работа и возвращение на борт доступны в списке жителей.{{else}}Список жителей доступен для просмотра. {{residentPermissionReason}}{{/if}}</p></details>
{{#if canInstallMagnifiqueCrew}}<button type="button" class="fbls-button compact" data-action="ship-install-magnifique-crew" data-fbls-tooltip="Явно добавить недостающих жителей из готового состава: 36 именных персонажей: 27 исходных и 9 согласованных дополнений. Связать их с этим кораблём без дублирования уже добавленных."><i class="fa-solid fa-people-group" aria-hidden="true"></i> Добавить экипаж «Магнифика» · 27+9</button>{{/if}}
{{#if canConfigureCrew}}
<details class="fbls-ship-box" data-ship-disclosure="crew:{{id}}"><summary><strong>Назначить моряков</strong> · {{linkedCrewCount}} приписано</summary>
  {{#if hasCrewOptions}}
  <div class="fbls-stack" data-ship-draft-scope="crew:{{id}}">
    <div class="fbls-toolbar"><label class="fbls-field"><span>Найти жителя</span><span class="fbls-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" aria-label="Найти жителя" data-ship-crew-search placeholder="Имя, роль или звание" autocomplete="off" /></span></label><span data-ship-crew-count>Выбрано: {{linkedCrewCount}}</span></div>
    <div class="fbls-ship-crew-picker" data-render-scroll-key="ship-crew-picker">
      {{#each crewOptions}}<label class="fbls-ship-crew-option" data-ship-crew-option data-ship-crew-search-text="{{searchText}}">
        <input type="checkbox" value="{{id}}" data-ship-crew data-ship-draft="resident:{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} aria-label="{{selectedLabel}}: {{label}}" />
        <span><strong data-fbls-tooltip="{{label}} · {{statusLabel}}">{{label}}</strong><small>{{statusLabel}}</small></span><span class="fbls-ship-crew-choice" data-ship-crew-choice data-add-label="Добавить" data-remove-label="Убрать">{{#if selected}}Убрать{{else}}Добавить{{/if}}</span>
      </label>{{/each}}
    </div>
    <p class="fbls-empty-state is-compact" data-ship-crew-empty hidden>Жители по этому запросу не найдены.</p>
    <div class="fbls-action-group"><button type="button" class="fbls-button compact" data-action="ship-save-crew" data-fbls-tooltip="Сохранить весь отмеченный состав. Один житель может быть приписан только к одному кораблю. Уже назначенная работа в поселении сохраняется до отлёта или явного возвращения на борт."><i class="fa-solid fa-check" aria-hidden="true"></i> Сохранить состав</button></div>
  </div>{{else}}<p class="fbls-muted-text">Нет жителей для назначения в команду.</p>{{/if}}
</details>{{/if}}
{{#if atHome}}{{#if readiness.departingAssignments.length}}<details class="fbls-ship-box" data-ship-disclosure="vacancies:{{id}}"><summary>Освободятся при отправлении · {{readiness.departingAssignments.length}}</summary>{{#each readiness.departingAssignments}}<div class="fbls-toolbar"><p>{{name}}: {{label}}</p><button type="button" class="fbls-button compact" data-action="ship-open-resident" data-resident-id="{{residentId}}" aria-label="Открыть назначения жителя {{name}}"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Житель</button></div>{{/each}}</details>{{/if}}{{/if}}
