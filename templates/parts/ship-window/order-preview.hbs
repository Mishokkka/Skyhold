<div class="fbls-card-header fbls-order-map-heading"><strong>{{#if selectedCount}}План рейса · {{selectedCount}} / 3{{else}}Маршруты · {{locationLabel}}{{/if}}</strong><div class="fbls-action-group">{{#if map}}<button type="button" class="fbls-button compact" data-ship-planner-map-toggle aria-expanded="{{mapOpen}}" aria-controls="{{mapPanelId}}"><i class="fa-solid fa-map" aria-hidden="true"></i> Карта маршрутов</button>{{/if}}{{#if selectedCount}}<button type="button" class="fbls-button compact" data-ship-planner-clear><i class="fa-solid fa-xmark" aria-hidden="true"></i> Снять выбор</button>{{/if}}</div></div>
{{#if map}}<section class="fbls-ship-map-panel" id="{{mapPanelId}}" data-ship-planner-map aria-label="Карта маршрутов корабля" {{#unless mapOpen}}hidden{{/unless}}>{{> "modules/fbl-skyhold/templates/parts/ship-window/route-map-view.hbs" map}}</section>{{/if}}
{{#if error}}<p class="fbls-ship-notice" role="alert">{{error}}</p>{{/if}}
{{#if hasPlan}}
  <dl class="fbls-ship-facts fbls-order-totals">
    <div tabindex="0" data-fbls-tooltip="Полёт {{flightDays}} дн. · погрузка и разгрузка {{portDays}} дн."><dt>Срок и путь</dt><dd>{{durationDays}} дн. · {{distanceKm}} км</dd></div>
    <div><dt>Конечный порт</dt><dd>{{finalPoint.label}}</dd></div>
    <div tabindex="0" data-fbls-tooltip="Сумма плат заказчиков после доставки; случайные исходы могут изменить выплату."><dt>Плата по договорам</dt><dd>{{{fblsShipMoneyHtml rewardCopper}}}</dd></div>
    <div tabindex="0" data-fbls-tooltip="Плата по договорам ({{fblsShipMoney rewardCopper}}) минус расходы рейса ({{fblsShipMoney totalOperatingCopper}}){{#if guaranteedStyleCostCopper}}, обязательная плата за осторожный подход ({{fblsShipMoney guaranteedStyleCostCopper}}){{/if}} и путь домой ({{fblsShipMoney returnReserveCopper}}). Без случайных исходов и дополнительной стоянки; не гарантированная прибыль."><dt>Итог по смете с возвратом ⓘ</dt><dd>{{{fblsShipMoneyHtml nominalExitCopper signed=true}}}</dd></div>
  </dl>
  <dl class="fbls-ship-facts fbls-order-totals" aria-label="Бюджет и запас на выход">
    <div tabindex="0" data-fbls-tooltip="Обязательные расходы выбранного рейса: провизия, жалованье, содержание, портовые работы и пошлины ({{fblsShipMoney totalOperatingCopper}}){{#if guaranteedStyleCostCopper}}, плюс обязательная плата за осторожный подход ({{fblsShipMoney guaranteedStyleCostCopper}}){{/if}}."><dt>Обязательно на рейс{{#if guaranteedStyleCostCopper}} ⓘ{{/if}}</dt><dd>{{{fblsShipMoneyHtml mandatoryTripCopper}}}</dd></div>
    <div tabindex="0" data-fbls-tooltip="Запас на борту сверх обязательных расходов рейса не списывается заранее и возвращается в казну после возвращения домой. Рекомендуемый запас ({{fblsShipMoney recommendedReserveCopper}}) покрывает путь домой, стоянку и риск происшествий."><dt>Запас на борту ⓘ</dt><dd>{{{fblsShipMoneyHtml plannedReserveCopper}}}</dd></div>
    <div tabindex="0" data-fbls-tooltip="Сумма на борту к моменту выхода после оплаты стоянки: обязательные расходы рейса плюс запас."><dt>Всего на борту</dt><dd>{{{fblsShipMoneyHtml effectiveBudgetCopper}}}</dd></div>
    {{#if atHome}}<div tabindex="0" data-fbls-tooltip="Перевод на борт ({{fblsShipMoney transferCopper}}){{#if homeDebtCopper}} + оплата стоянки из казны ({{fblsShipMoney homeDebtCopper}}){{/if}}. Перевод на борт не является расходом."><dt>Из казны сейчас ⓘ</dt><dd>{{{fblsShipMoneyHtml settlementWithdrawalCopper}}}</dd></div>{{else}}<div><dt>На борту сейчас</dt><dd>{{{fblsShipMoneyHtml onboardCopper}}}</dd></div>{{/if}}
  </dl>
  {{#if atHome}}{{#if recommendedReserveCopper}}<div class="fbls-toolbar fbls-order-budget-presets"><span class="fbls-muted-text" tabindex="0" data-fbls-tooltip="Запас остаётся на борту до фактической траты и вернётся в казну дома. Возвращение оформляется отдельным приказом.">{{#if walletCoversTarget}}На борту уже достаточно средств — перевод не нужен.{{else}}Запас вернётся в казну дома ⓘ{{/if}}</span><div class="fbls-action-group" role="group" aria-label="Выбор запаса на рейс"><button type="button" class="fbls-button compact" data-ship-planner-budget-preset="recommended" aria-pressed="{{isAutoBudget}}" data-fbls-tooltip="Пополняет борт до обязательных расходов рейса плюс рекомендуемый запас; пересчитывается при смене заказов или подхода.">С запасом ({{{fblsShipMoneyHtml recommendedBudgetCopper}}})</button><button type="button" class="fbls-button compact" data-ship-planner-budget-preset="minimum" aria-pressed="{{isTripOnlyBudget}}" data-fbls-tooltip="Пополняет борт только до обязательных расходов рейса{{#if guaranteedStyleCostCopper}} и осторожного подхода{{/if}}; уже имеющийся остаток на борту сохраняется и режим пересчитывается при смене плана.">Только рейс ({{{fblsShipMoneyHtml mandatoryTripCopper}}})</button></div></div>{{else}}<p class="fbls-order-explanation">Возвращение домой оформляется отдельным приказом.</p>{{/if}}{{else}}<p class="fbls-order-explanation">Оплата с бортового кошелька; возвращение домой — отдельным приказом.</p>{{/if}}
  {{#if debtCopper}}<p class="fbls-ship-notice">Счёт стоянки перед отправлением: {{{fblsShipMoneyHtml debtCopper}}}.</p>{{/if}}
<details class="fbls-order-explanation" data-ship-plan-details="explanation"><summary>Подробности маршрута и запаса · {{#if isBundle}}без повторных заходов{{else}}с подходом к погрузке{{/if}}</summary>
  <div class="fbls-cluster"><span class="fbls-chip is-compact">Трюм до {{maxLoadPoints}} / {{capacityLoadPoints}}</span><span class="fbls-chip is-compact">Без учёта возврата: {{{fblsShipMoneyHtml plannedMarginCopper signed=true}}}</span></div>
  <div class="fbls-action-group" aria-label="Подсветка грузов">{{#each orders}}<button type="button" class="fbls-button compact" data-ship-planner-focus="{{focusIds}}" aria-pressed="false" title="{{title}} · {{route}}">Заказ №{{number}}</button>{{/each}}<button type="button" class="fbls-button compact" data-ship-planner-focus="" aria-label="Снять подсветку груза">Весь рейс</button></div>
  <details data-ship-plan-details="stops"><summary><strong>Остановки и загрузка по участкам</strong> · {{stops.length}} точки</summary>
  <p class="fbls-muted-text">Полёт {{flightDays}} дн. · портовые работы{{#if isBundle}} и передышки{{/if}} {{portDays}} дн. {{#if isBundle}}Без повторных заходов. {{/if}}Случайные исходы могут изменить срок и выплату.</p>
  <ol class="fbls-order-stops" start="0" aria-label="Остановки рейса">
    {{#each stops}}<li><button type="button" class="fbls-button compact" data-ship-planner-focus="{{offerIds}}" aria-pressed="false" title="Подсветить грузы остановки {{point.label}}">{{point.label}}</button><span>{{#if pickupText}}Погрузка {{pickupText}}. {{/if}}{{#if deliveryText}}Доставка {{deliveryText}}. {{/if}}После остановки: {{loadAfterPoints}} ед.</span></li>{{/each}}
  </ol>
  <div class="fbls-order-legs" aria-label="Загрузка по участкам">{{#each legs}}<p><strong>{{number}}. {{from.label}} → {{to.label}}</strong><span>{{cargoText}} · трюм {{loadOnLegPoints}} / {{../capacityLoadPoints}}{{#if hiddenOnLegPoints}} · тайники {{hiddenOnLegPoints}} / {{../hiddenCapacityLoadPoints}}{{/if}} · полёт {{flightDays}} дн.{{#if hasCosts}} · с портом {{durationDays}} дн. · {{{fblsShipMoneyHtml operatingCopper}}}{{/if}}</span></p>{{/each}}</div>
  </details>
  <details class="fbls-ship-budget-detail" data-ship-plan-details="budget"><summary>Состав рекомендуемого запаса: {{{fblsShipMoneyHtml recommendedReserveCopper}}}</summary><dl class="fbls-ship-facts fbls-ship-reserve-parts"><div><dt>Путь домой</dt><dd>{{{fblsShipMoneyHtml returnReserveCopper}}}</dd></div><div><dt>Стоянка до решения</dt><dd>{{{fblsShipMoneyHtml idleReserveCopper}}}</dd></div><div><dt>Риск случайных исходов</dt><dd>{{{fblsShipMoneyHtml probabilisticOutcomeReserveCopper}}}</dd></div></dl><p class="fbls-muted-text">Обязательно на рейс: {{{fblsShipMoneyHtml mandatoryTripCopper}}} (путь {{{fblsShipMoneyHtml totalOperatingCopper}}}{{#if guaranteedStyleCostCopper}} + осторожный подход {{{fblsShipMoneyHtml guaranteedStyleCostCopper}}}{{/if}}). Итого с запасом: {{{fblsShipMoneyHtml recommendedBudgetCopper}}}.</p></details>
  <p>На борту сейчас: {{{fblsShipMoneyHtml onboardCopper}}}. {{#if debtCopper}}Стоянка: {{{fblsShipMoneyHtml debtCopper}}}. {{/if}}{{#if atHome}}Перевод на борт: <strong>{{{fblsShipMoneyHtml transferCopper}}}</strong>.{{#if homeDebtCopper}} На стоянку из казны: {{{fblsShipMoneyHtml homeDebtCopper}}}.{{/if}}{{/if}}</p>
</details>
  {{#if shortageCopper}}<p class="fbls-ship-notice">Для отправления не хватает {{{fblsShipMoneyHtml shortageCopper}}}.</p>{{else if firstLegShortageCopper}}<p class="fbls-ship-notice">Для первого участка не хватает {{{fblsShipMoneyHtml firstLegShortageCopper}}}.</p>{{/if}}
  {{#if remainingTripShortageCopper}}<p class="fbls-ship-notice">Не покрыты обязательные расходы {{#if guaranteedStyleCostCopper}}подхода и {{/if}}дальнейших участков: {{{fblsShipMoneyHtml remainingTripShortageCopper}}}.{{#if canDepart}} Первый участок доступен, но для следующих шагов понадобятся поступления или пополнение.{{/if}}</p>{{/if}}
  {{#if extraReserveShortageCopper}}<p class="fbls-ship-notice">До рекомендуемого запаса не хватает {{{fblsShipMoneyHtml extraReserveShortageCopper}}}.{{#unless firstLegShortageCopper}}{{#unless remainingTripShortageCopper}}{{#if canDepart}} Обязательные расходы рейса покрыты; при происшествии или возвращении может не хватить средств.{{/if}}{{/unless}}{{/unless}}</p>{{/if}}
  <div aria-live="polite">{{#each blockers}}<p class="fbls-ship-notice">{{this}}</p>{{/each}}{{#if permissionReason}}<p class="fbls-ship-notice">{{permissionReason}}</p>{{/if}}</div>
  {{#if atHome}}<p class="fbls-muted-text" tabindex="0" data-fbls-tooltip="При отправке из дома моряки освобождают рабочие места и жильё в поселении. После возвращения их нужно назначить вручную.">Экипаж уйдёт с работ поселения; после возвращения назначения не восстанавливаются автоматически ⓘ</p>
  {{#if departingAssignments.length}}<details data-ship-plan-details="assignments"><summary>Освобождаемые назначения · {{departingAssignments.length}} жителей</summary>{{#each departingAssignments}}<div class="fbls-toolbar"><p>{{name}}: {{label}}</p><button type="button" class="fbls-button compact" data-action="ship-open-resident" data-resident-id="{{residentId}}" aria-label="Открыть жителя {{name}}"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Житель</button></div>{{/each}}</details>{{/if}}{{/if}}
{{else}}
  {{#unless error}}<p class="fbls-order-empty">Выберите 1–3 заказа — здесь появятся срок, расходы, плата и конечный порт.</p>{{/unless}}
{{/if}}
