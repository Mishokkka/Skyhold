<div class="fbls-toolbar"><div><h3 class="fbls-heading-section">Паспорт и навигация</h3><p class="fbls-muted-text">Настройки ГМа · поля паспорта сохраняются автоматически</p></div><span class="fbls-chip is-compact">{{profileLabel}}</span></div>
{{#if gmControl}}
<section class="fbls-ship-box fbls-ship-gm-box" aria-label="Ручное управление кораблём ГМа">
  <div class="fbls-card-header">
    <div><h3 class="fbls-heading-section">Ручное управление ГМа</h3><p class="fbls-muted-text">Прямые действия в обход ограничений рейсов, стоянок и календаря</p></div>
    <span class="fbls-chip is-compact is-accent">Только ГМ</span>
  </div>
  {{#if gmControl.moveBlockedReason}}<p class="fbls-ship-notice">{{gmControl.moveBlockedReason}}</p>{{/if}}
  <div class="fbls-ship-gm-row">
    <label class="fbls-field"><span>Мгновенно переместить корабль</span><select data-ship-gm-destination aria-label="Точка ручного перемещения корабля">{{#each gmControl.destinations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <button type="button" class="fbls-button compact" data-action="ship-gm-move" data-fbls-tooltip="Переместить корабль в выбранную точку сразу. Если идёт рейс или составной заказ, он будет отменён без броска исходов; экипаж и стоянка синхронизируются." {{#unless gmControl.canMove}}disabled{{/unless}}><i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i> Переместить</button>
  </div>
  <div class="fbls-ship-gm-row">
    <label class="fbls-field"><span>Состояние судна</span><select data-ship-gm-condition aria-label="Состояние судна">{{#each gmControl.conditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <button type="button" class="fbls-button compact" data-action="ship-gm-condition" data-fbls-tooltip="Сразу изменить техническое состояние корабля независимо от текущего рейса или местоположения."><i class="fa-solid fa-wrench" aria-hidden="true"></i> Применить</button>
  </div>
  <div class="fbls-ship-gm-funds-form" data-ship-draft-scope="gm-funds:{{id}}">
    <label class="fbls-field"><span>Бортовой кошелёк</span><select data-ship-gm-funds-mode data-ship-draft="gm-funds-mode" aria-label="Режим изменения бортового кошелька"><option value="set">Задать сумму</option><option value="income">Добавить на борт</option><option value="expense">Списать с борта</option></select></label>
    <label class="fbls-field"><span>Сумма, З</span><input type="number" min="0" step="0.01" value="{{gmControl.walletGoldInput}}" data-ship-gm-funds-amount data-ship-draft="gm-funds-amount" aria-label="Сумма бортового кошелька в золотых" title="Сумма в золотых (1 З = 10 С = 100 М). Казна поселения не затрагивается." /></label>
    <label class="fbls-field"><span>Причина</span><input type="text" value="" placeholder="Корректировка ГМа" data-ship-gm-funds-reason data-ship-draft="gm-funds-reason" aria-label="Причина корректировки кошелька" /></label>
    <button type="button" class="fbls-button compact" data-action="ship-gm-funds" data-fbls-tooltip="Изменить бортовой кошелёк напрямую в любом статусе корабля. Казна поселения не изменяется."><i class="fa-solid fa-coins" aria-hidden="true"></i> Записать</button>
  </div>
  <div class="fbls-action-group" role="group" aria-label="Прямые действия с рейсом, счетами и временем">
    <button type="button" class="fbls-button compact" data-action="ship-gm-arrive" data-fbls-tooltip="Мгновенно завершить текущий перелёт или задержку в порту." {{#unless gmControl.canArrive}}disabled{{/unless}}><i class="fa-solid fa-forward-fast" aria-hidden="true"></i> Прибыть сейчас</button>
    <button type="button" class="fbls-button compact danger" data-action="ship-gm-cancel-voyage" data-fbls-tooltip="Отменить активный рейс или составной заказ без броска исходов и вернуть корабль в порт." {{#unless gmControl.canCancelVoyage}}disabled{{/unless}}><i class="fa-solid fa-ban" aria-hidden="true"></i> Отменить рейс</button>
    <button type="button" class="fbls-button compact" data-action="ship-gm-clear-bills" data-fbls-tooltip="Списать накопленный долг стоянки и начать отсчёт заново." {{#unless gmControl.canClearBills}}disabled{{/unless}}><i class="fa-solid fa-file-circle-xmark" aria-hidden="true"></i> Списать долг стоянки</button>
    <button type="button" class="fbls-button compact" data-action="ship-gm-sync-clock" data-fbls-tooltip="Выровнять время корабля ({{gmControl.timelineDays}} дн.) с текущей датой поселения ({{gmControl.settlementDays}} дн.)." {{#unless gmControl.canSyncClock}}disabled{{/unless}}><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Синхронизировать время</button>
  </div>
</section>
{{/if}}
<div class="fbls-ship-box">
  {{#if canConfigureCrew}}<div class="fbls-ship-form-grid">
    <label class="fbls-field"><span>Название</span><input type="text" data-field="holdings.{{@root.holdingIndex}}.special.ships.list.{{index}}.name" value="{{name}}" data-fbls-tooltip="Название в списке кораблей, отчётах и жилье экипажа." /></label>
    <label class="fbls-field"><span>Командующий</span><input type="text" data-field="holdings.{{@root.holdingIndex}}.special.ships.list.{{index}}.commanderName" value="{{commanderName}}" data-fbls-tooltip="Имя командира для паспорта судна. Не меняет приписку жителей к команде." /></label>
  </div>
  <div class="fbls-ship-form-grid fbls-ship-parameters">
    <label class="fbls-field"><span>Скорость, км/день</span><input type="number" min="1" max="10000" step="1" data-field="holdings.{{@root.holdingIndex}}.special.ships.list.{{index}}.speedKmPerDay" value="{{speedKmPerDay}}" data-fbls-tooltip="Средняя скорость с учётом ночных остановок. Погрузка и разгрузка добавляются отдельно." /></label>
    <label class="fbls-field"><span>Трюм, ед.</span><input type="number" min="1" max="1000000" step="1" data-field="holdings.{{@root.holdingIndex}}.special.ships.list.{{index}}.capacityLoadPoints" value="{{capacityLoadPoints}}" data-fbls-tooltip="Общая вместимость в игровых единицах груза (включая тайники)." /></label>
    <label class="fbls-field"><span>Тайники, ед.</span><input type="number" min="0" max="1000000" step="1" data-field="holdings.{{@root.holdingIndex}}.special.ships.list.{{index}}.hiddenCapacityLoadPoints" value="{{hiddenCapacityLoadPoints}}" data-fbls-tooltip="Часть общего трюма, пригодная для контрабанды. Не может превышать трюм." /></label>
  </div>{{else}}<dl class="fbls-ship-facts"><div><dt>Скорость</dt><dd>{{speedKmPerDay}} км/день</dd></div><div><dt>Трюм</dt><dd>{{capacityLoadPoints}} ед.</dd></div><div><dt>Тайники</dt><dd>{{hiddenCapacityLoadPoints}} ед.</dd></div></dl><p class="fbls-muted-text">Паспорт и характеристики редактируются дома между рейсами.</p>{{/if}}
  <label class="fbls-cluster fbls-checkbox-label fbls-choice-toggle" data-fbls-tooltip="Содержание корабля в поселении: корпус, питание и жалованье отдыхающего на борту экипажа. Отключение прекращает новые начисления с текущего момента; прежние долги сохраняются."><input type="checkbox" data-field="holdings.{{@root.holdingIndex}}.special.ships.list.{{index}}.homeUpkeepEnabled" {{#if homeUpkeepEnabled}}checked{{/if}} /> <span>Содержание дома · {{{fblsShipMoneyHtml homeUpkeepCopperPerDay}}} / день</span></label>
</div>
<details class="fbls-ship-box" data-ship-disclosure="home:{{@root.holding.id}}" data-ship-draft-scope="home:{{@root.holding.id}}">
  <summary><strong>Домашняя точка · {{@root.holding.name}}</strong> · {{@root.shipHome.locationLabel}}</summary>
  <div class="fbls-ship-form-grid">
    <label class="fbls-field"><span>Воздушная связь на карте</span><select data-ship-home-route data-ship-draft="home-route" aria-label="Связь для домашней точки"><option value="">Выберите маршрут</option>{{#each @root.shipHome.routes}}<option value="{{key}}">{{label}}</option>{{/each}}</select></label>
    <label class="fbls-field"><span>Положение от первого порта, %</span><input type="number" min="1" max="99" step="1" value="50" data-ship-home-percent data-ship-draft="home-percent" aria-label="Положение домашней точки вдоль связи" /></label>
  </div>
  <p class="fbls-muted-text">50% — середина пути. Изменится регион поселения, свободные предложения сбросятся; перед сохранением будет показано подтверждение.</p>
  {{#if @root.shipHome.blocker}}<p class="fbls-ship-notice">{{@root.shipHome.blocker}}</p>{{/if}}
  {{#unless @root.shipHome.routes.length}}<p class="fbls-muted-text">Сначала разместите два открытых воздушных порта и соедините их на карте маршрутов рынка.</p>{{/unless}}
  <div class="fbls-action-group"><button type="button" class="fbls-button compact" data-action="ship-place-home" {{#unless @root.shipHome.canPlace}}disabled{{/unless}}><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Проверить и разместить</button></div>
</details>
<details class="fbls-ship-box" data-ship-disclosure="delete:{{id}}"><summary><strong>Удаление корабля</strong></summary><p class="fbls-muted-text">{{deleteReason}}</p><button type="button" class="fbls-button compact danger" data-action="ship-delete" data-fbls-tooltip="{{deleteReason}}" {{#unless canDelete}}disabled{{/unless}}><i class="fa-solid fa-trash" aria-hidden="true"></i> Удалить</button></details>
