        {{#if activeStorage.resources}}
          <div class="fbls-storage-resources-layout">
            <div class="fbls-storage-workspace {{#if storageRoomRailCollapsed}}room-rail-collapsed{{/if}}">
              {{> "modules/fbl-skyhold/templates/parts/storage/room-rail.hbs"}}

              <section class="fbls-storage-inventory">
                {{#if storageContext.activeRoom}}
                  <header class="fbls-storage-room-strip {{storageContext.activeRoom.fillClass}}" data-fbls-tooltip="{{storageContext.activeRoom.fillTitle}}" data-storage-active-room="{{storageContext.activeRoomId}}">
                    <div class="strip-main"><i class="fa-solid fa-warehouse"></i><span><strong>{{storageContext.activeRoom.label}}</strong><small>{{storageContext.activeRoomCount}} позиций</small></span></div>
                    {{#unless storageContext.activeRoom.unlimited}}<div class="strip-bar"><span style="width: {{storageContext.activeRoom.fillPercent}}%;"></span></div>{{/unless}}
                    <div class="strip-extra">{{#unless storageContext.activeRoom.unlimited}}<span><small>Занято, cargo points</small><b>{{storageContext.activeRoom.usedText}} / {{storageContext.activeRoom.capacityText}}</b></span><span><small>Свободно, cargo points</small><b>{{storageContext.activeRoom.freeText}}</b></span>{{/unless}}<span><small>Защита</small><b>{{storageContext.activeRoom.securityText}}</b></span><span><small>Хранение</small><b>{{storageContext.activeRoom.qualityText}}</b></span></div>
                    {{#if storageContext.activeRoom.hasOverflow}}<p class="fbls-storage-overflow-alert"><i class="fa-solid fa-triangle-exclamation"></i><span>{{storageContext.activeRoom.overflowStatusText}}</span></p>{{/if}}
                  </header>
                  {{> "modules/fbl-skyhold/templates/parts/storage/batch-controls.hbs"}}
                {{/if}}

                <div class="fbls-storage-inventory-table resources" data-render-scroll-key="storage-resources-table">
                  <div class="fbls-storage-resource-grid">
                    {{#each storageContext.activeRoomRows}}
                      <article class="fbls-storage-resource-card {{qtyClass}} {{#if batchSelected}}batch-selected{{/if}}" data-storage-row-type="resources" data-storage-row-id="{{id}}" data-storage-row-room-id="{{roomId}}" {{#if notes}}data-fbls-tooltip="{{notes}}" data-fbls-tooltip-delay="1000"{{/if}}>
                        <div class="fbls-storage-resource-main">
                          {{#if ../canUseStorage}}<label class="fbls-storage-batch-pick"><input type="checkbox" data-type="checkbox" data-storage-batch-select="{{id}}" data-storage-batch-kind="resources" aria-label="Выбрать ресурс {{label}}" {{#if batchSelected}}checked{{/if}} /></label>{{/if}}
                          {{#if img}}<img class="fbls-storage-resource-img" src="{{img}}" alt="" data-fbls-image-fallback /><i class="{{icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{icon}}"></i>{{/if}}
                          <div class="fbls-storage-resource-name" title="1 {{unitFull}} = {{unitCargoPointsText}} грузовых очков (cargo points)">
                            {{#if ../canEdit}}
                              <button type="button" class="fbls-storage-resource-picker" data-action="pick-storage-resource" data-storage-picker-scope="row" data-storage-resource-index="{{_index}}" data-resource-id="{{resourceId}}"><strong>{{label}}</strong><i class="fa-solid fa-chevron-right"></i></button>
                              {{#if isCustomResource}}<input type="text" data-field="holdings.{{../holdingIndex}}.storage.resources.{{_index}}.name" value="{{name}}" placeholder="Свой ресурс" />{{/if}}
                            {{else}}
                              <strong>{{label}}</strong>
                            {{/if}}
                            {{#if foodValue}}<small>{{foodValueText}} чел.-дн.</small>{{/if}}
                          </div>
                        </div>

                        <div class="fbls-storage-resource-qty">
                          {{#if ../canEdit}}<input type="number" min="0" step="{{quantityStep}}" data-type="number" data-field="holdings.{{../holdingIndex}}.storage.resources.{{_index}}.qty" value="{{qty}}" aria-label="Количество {{label}}" />{{else}}<strong>{{qtyText}}</strong>{{/if}}<span title="{{unitFull}}">{{unit}}</span>
                          <small>Всего {{qtyText}} · резерв {{reservedQtyText}} · доступно {{availableQtyText}}</small>
                          {{#if hasLegacyRemainder}}<small title="Старая дробная часть сохранена и будет объединена при следующем изменении количества.">Открытая legacy-партия: {{legacyRemainderText}}</small>{{/if}}
                          {{#if foodValue}}<small>{{foodDaysText}} чел.-дн.</small>{{/if}}
                        </div>

                        {{#if ../canUseStorage}}
                          <label class="fbls-sale-flag icon-only {{#unless canMarkForSale}}disabled{{/unless}}" data-fbls-tooltip="{{saleTooltip}}"><input type="checkbox" data-type="checkbox" data-field="holdings.{{../holdingIndex}}.storage.resources.{{_index}}.forSale" aria-label="Разрешить продажу {{label}}" {{#if forSale}}checked{{/if}} {{#unless canMarkForSale}}disabled{{/unless}} /><i class="fa-solid fa-coins"></i></label>
                        {{else}}
                          {{#if forSale}}<div class="fbls-sale-flag icon-only readonly" data-fbls-tooltip="Помечено к продаже"><i class="fa-solid fa-coins"></i></div>{{/if}}
                        {{/if}}

                      </article>
                    {{else}}
                      <article class="fbls-card fbls-empty">В этом помещении нет ненулевых ресурсов.</article>
                    {{/each}}
                  </div>
                </div>
              </section>
            </div>
          </div>
        {{/if}}
