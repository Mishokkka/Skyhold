<div class="fbls-market-export">
  <div class="fbls-market-toolbar fbls-toolbar fbls-market-export-toolbar">
    <label>Рынок-локация
      <select data-market-provider>
        {{#each marketOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label class="fbls-market-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-market-search value="{{search}}" placeholder="Найти товар для продажи" autocomplete="off" /></label>
    <label>Раздел
      <select data-market-kind>
        <option value="all" {{#if kindAll}}selected{{/if}}>Все</option>
        <option value="material" {{#if kindMaterial}}selected{{/if}}>Материалы</option>
        <option value="resource" {{#if kindResource}}selected{{/if}}>Ресурсы</option>
        <option value="consumable" {{#if kindConsumable}}selected{{/if}}>Расходники</option>
      </select>
    </label>
    <span>Показано: <strong data-market-visible-count>{{sellOffers.length}}</strong></span>
  </div>

  <div class="fbls-market-layout fbls-market-export-layout">
    <main class="fbls-market-offers fbls-market-export-offers" data-render-scroll-key="market-offers">
      <div class="fbls-market-offer-columns fbls-market-export-columns" aria-hidden="true">
        <span></span>
        <span>Товар</span>
        <span>Контракт</span>
        <span>Запас / спрос</span>
        <span>Цена покупки</span>
        <span>Кол-во</span>
        <span>Выручка</span>
      </div>
      {{#each sellOffers}}
        <article class="fbls-market-offer fbls-market-export-offer {{#if selected}}is-selected{{/if}}" data-market-offer data-market-kind="{{kind}}" data-market-search-text="{{searchText}}">
          <div class="fbls-market-offer-image">
            {{#if img}}<img src="{{img}}" alt="" data-market-offer-image="export:{{id}}" data-fbls-persistent-image="market-export-offer:{{id}}" data-fbls-image-fallback /><i class="{{icon}}" data-fbls-image-fallback-icon hidden></i>{{else}}<i class="{{icon}}"></i>{{/if}}
          </div>
          <div class="fbls-market-offer-main">
            <strong>{{name}}</strong>
            <small><span class="fbls-market-kind">{{kindLabel}}</span> · УРС {{requiredUrs}}</small>
          </div>
          <div class="fbls-market-export-contract">
            <button type="button" class="fbls-button compact {{#if selected}}is-active{{/if}}" data-action="market-export-select" data-offer-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" aria-label="Выбрать контракт на продажу {{name}}" {{#unless ../canPurchase}}disabled{{/unless}} {{#unless maxQty}}disabled{{/unless}}><i class="fa-solid fa-file-signature"></i> {{#if selected}}Выбран{{else}}Выбрать{{/if}}</button>
            {{#if roomsText}}<small title="Источники товара">{{roomsText}}</small>{{/if}}
          </div>
          <span class="fbls-market-export-availability" title="Доступно в поселении: {{availableQty}} {{unitFull}} · рынок готов купить: {{bidDemand}} {{unitFull}}"><b>{{availableQty}}</b><i>/</i><b>{{bidDemand}}</b><small>{{unit}}</small></span>
          <div class="fbls-market-price fbls-market-export-price">
            <span class="fbls-market-money" aria-label="{{priceText}}">{{#each priceParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
          </div>
          <div class="fbls-market-quantity">
            <button type="button" data-action="market-export-quantity-step" data-offer-id="{{id}}" data-step="-1" data-max="{{maxQty}}" title="ЛКМ: −1 · ПКМ: убрать всё" aria-label="Уменьшить количество {{name}} для продажи" {{#unless ../canPurchase}}disabled{{/unless}} {{#unless selected}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
            <input type="number" min="0" max="{{maxQty}}" step="1" value="{{qty}}" data-market-export-quantity data-offer-id="{{id}}" aria-label="Количество {{name}} для продажи" {{#unless ../canPurchase}}disabled{{/unless}} {{#unless selected}}disabled{{/unless}} />
            <button type="button" data-action="market-export-quantity-step" data-offer-id="{{id}}" data-step="1" data-max="{{maxQty}}" title="ЛКМ: +1 · ПКМ: добавить максимум" aria-label="Увеличить количество {{name}} для продажи" {{#unless ../canPurchase}}disabled{{/unless}} {{#unless selected}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
          </div>
          <span class="fbls-market-line-total fbls-market-money" aria-label="{{lineText}}">{{#each lineParts}}<span class="{{tone}}"><b>{{value}}</b><i>{{label}}</i></span>{{/each}}</span>
        </article>
      {{else}}
        <div class="fbls-empty">В хранилище нет товаров, на которые этот рынок выставил действующий спрос.</div>
      {{/each}}
    </main>

    <aside class="fbls-market-cart fbls-market-export-cart" data-render-scroll-key="market-cart">
      <header class="fbls-market-cart-head"><div><i class="fa-solid fa-arrow-up-from-bracket"></i><span><small>Оформление</small><h3>Продажа</h3></span></div><strong>{{exportSelectedCount}} ед.</strong></header>

      <section class="fbls-market-cart-section delivery">
        <header><i class="fa-solid fa-truck-fast"></i><div><strong>Отправка</strong><small>Один ресурс · один контракт</small></div></header>
        <div class="fbls-market-cart-controls">
          <label class="fbls-field"><span>Перевозчик</span>
            <select data-market-carrier {{#unless canPurchase}}disabled{{/unless}}>
              {{#each carrierOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label class="fbls-field"><span>Режим</span>
            <select data-market-service-level {{#unless canPurchase}}disabled{{/unless}}>
              <option value="standard" {{#if exportServiceStandard}}selected{{/if}}>Standard · доля одного плеча</option>
              <option value="express" {{#if exportServiceExpress}}selected{{/if}}>Express · ускоренная доля</option>
              <option value="charter" {{#if exportServiceCharter}}selected{{/if}}>Charter · вся машина, два плеча</option>
            </select>
          </label>
        </div>
        <div class="fbls-market-export-metrics">
          <span><small>Срок</small><strong>{{exportEtaText}}</strong></span>
          <span><small>Риск утраты</small><strong>{{exportLossChanceText}}</strong></span>
          <span><small>Груз</small><strong>{{exportCargoText}}</strong></span>
          <span><small>Вместимость</small><strong>{{exportCapacityText}}</strong></span>
        </div>
        <dl class="fbls-market-export-contract-facts">
          <div><dt>Остаток спроса</dt><dd>{{exportDemandText}}</dd></div>
          <div><dt>Страховая выплата</dt><dd>{{exportInsurancePayoutText}}</dd></div>
          <div><dt>Расходы при отправке</dt><dd>{{exportReserveText}}</dd></div>
        </dl>
        <p class="fbls-market-delivery-note">Standard оплачивает занятую долю одного плеча; Charter — всю машину и два плеча. Фрахт считается по грузовым очкам (cargo points) и маршруту. Стоимость товара влияет только на пошлину и выбранную страховку. Условия фиксируются при отправке, а выручка поступит после прибытия.</p>
      </section>

      <section class="fbls-market-cart-section costs">
        <header><i class="fa-solid fa-file-invoice-dollar"></i><div><strong>Расчёт сделки</strong><small>Зафиксированные условия рейса</small></div></header>
        <dl class="fbls-market-cost-list fbls-market-export-costs">
          <div><dt>Выручка</dt><dd>{{exportGrossText}}</dd></div>
          <div><dt>Фрахт</dt><dd>{{exportFreightText}}</dd></div>
          <div><dt>Погрузка</dt><dd>{{exportHandlingText}}</dd></div>
          <div><dt>Пошлина</dt><dd>{{exportTaxText}}</dd></div>
          <div><dt>Страхование</dt><dd>{{exportInsuranceText}}</dd></div>
          <div class="subtotal"><dt>Все расходы</dt><dd>{{exportTotalCostsText}}</dd></div>
          <div class="total {{#if exportNetPositive}}is-positive{{else}}is-negative{{/if}}"><dt>Чистый итог</dt><dd>{{exportNetText}}</dd></div>
        </dl>
      </section>

      {{#if exportIssues.length}}
        <div class="fbls-market-export-issues" role="status" aria-label="Причины, мешающие отправке">
          {{#each exportIssues}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{#if message}}{{message}}{{else}}{{this}}{{/if}}</p>{{/each}}
        </div>
      {{/if}}

      <section class="fbls-market-checkout fbls-market-export-checkout">
        <div><span><small>Выручка</small><b>{{exportGrossText}}</b></span><span><small>Чистый итог</small><b class="{{#if exportNetPositive}}is-positive{{else}}is-negative{{/if}}">{{exportNetText}}</b></span></div>
        <div class="fbls-action-group">
          <button type="button" class="fbls-button ghost" data-action="market-export-clear" {{#unless hasExportSelection}}disabled{{/unless}}>Очистить</button>
          <button type="button" class="fbls-button primary" data-action="market-export-dispatch" {{#unless canConfirmExport}}disabled{{/unless}}><i class="fa-solid fa-paper-plane"></i> Отправить на продажу</button>
        </div>
      </section>

      {{#if hasExports}}
        <section class="fbls-market-shipments fbls-market-exports">
          <h4><i class="fa-solid fa-route"></i> Экспорт в пути · {{exports.length}}</h4>
          {{#each exports}}
            <article class="fbls-market-shipment fbls-market-export-order {{status}}">
              <header><strong>{{marketLabel}}</strong><span>{{statusLabel}}</span></header>
              <p><b>{{offerName}}</b> ×{{qty}} {{unit}}</p>
              <div class="fbls-market-export-order-metrics">
                <span><small>Осталось</small><b>{{remainingText}}</b></span>
                <span><small>ETA контракта</small><b>{{etaText}}</b></span>
                <span><small>Выручка</small><b>{{grossText}}</b></span>
                <span><small>Чистый итог</small><b>{{netText}}</b></span>
              </div>
              <p class="fbls-market-shipment-risk">{{riskText}}</p>
              <footer><small>{{carrierText}} · расходы {{costsText}}</small></footer>
            </article>
          {{/each}}
        </section>
      {{/if}}

      {{#if hasExportArchive}}
        <details class="fbls-market-archive fbls-market-export-archive">
          <summary><span><i class="fa-solid fa-box-archive"></i> Архив экспорта</span><b>{{exportArchive.length}}</b></summary>
          <div class="fbls-market-archive-list">
            {{#each exportArchive}}
              <article class="fbls-market-archive-row fbls-market-export-archive-row {{status}}">
                <header><div><strong>{{marketLabel}}</strong><small>{{resolvedText}}</small></div><span>{{statusLabel}}</span></header>
                <p><b>{{offerName}}</b> ×{{qty}} {{unit}} · {{outcomeText}}</p>
                <dl>
                  <div><dt>Выручка</dt><dd>{{grossText}}</dd></div>
                  <div><dt>Расходы</dt><dd>{{costsText}}</dd></div>
                  <div><dt>Страховая выплата</dt><dd>{{insurancePayoutText}}</dd></div>
                  <div class="total"><dt>Итог</dt><dd>{{netText}}</dd></div>
                </dl>
              </article>
            {{/each}}
          </div>
        </details>
      {{/if}}
    </aside>
  </div>
</div>
